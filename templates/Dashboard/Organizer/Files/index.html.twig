{% extends "Global/layout.html.twig" %}

{% set pagetitle = 'Manage files' %}

{% block title %}{{ pagetitle }}{% endblock %}

{% block content %}

    <style>
        .custom-image {
            width: 35px; /* Set the width */
        }
    </style>

    {% set navigation = [{ "dashboard_index": ('Dashboard' ), "current":(pagetitle) }] %}
    {% include "Global/navigation.html.twig" with navigation %}

    <section class="section-content padding-y bg-white">
        <div class="{{ services.getSetting("app_layout") }}">
            <div class="row">
                <aside class="col-lg-3 pt-3 pt-lg-0">
                    {% include "Dashboard/sidebar.html.twig" %}
                </aside>
                <div class="col-lg-9 mt-4 mt-lg-0">
                    {#                    <div></div> #}
                    <div class="box shadow-none bg-gray mb-4">
                        <div class="row">
                            <div class="col-sm-12 col-lg-2  mb-3 mb-lg-0">
                                <span class="center-lg-y text-muted">{{ "%resultsCount% result(s) found" |trans ({'%resultsCount%': files.getTotalItemCount}) }}</span>
                            </div>
                            <div class="col-sm-12 col-lg-6 ">
                                <a href="{{ path('dashboard_organizer_management_files_add') }}"
                                   class="btn btn-primary ml-3" data-toggle="tooltip"
                                   title="{{ 'Add a file' }}"><i class="fas fa-plus"></i></a>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="mb-3">
                                <label for="filter">Filter by keword:</label>
                                <input type="text" id="filter" placeholder="Filter through the files by keyword"
                                       class="form-control bg-white"/>
                            </div>
                            <div class="card">
                                <div class="table-responsive">
                                    <table class="table table-vcenter">
                                        <thead>
                                            <tr>
                                                <th>{{ 'Name' }}</th>
                                                <th>{{ 'Type' }}</th>
                                                <th>{{ 'Date Created' }}</th>
                                                <th>{{ 'Date Updated' }}</th>
                                                <th class="text-center"><i class="fas fa-cog"></i></th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            {% for file in files %}
                                                <tr>
                                                    <td class="text-sm"
                                                        style="justify-content: start; display: flex; align-content: start; align-items: center">
                                                        <a
                                                                href="{{ path('dashboard_organizer_management_files_download_file', {'fileId': file.id}) }}"
                                                                style="float: left" class="mr-4">
                                                            <img src="{{ asset('assets/img/icons/file.png') }}"
                                                                 alt="File" class="custom-image">
                                                        </a> {{ file.title }}
                                                    </td>

                                                    <td class="text-sm">
                                                        {{ file.getFileMimeType }}
                                                    </td>

                                                    <td class="text-sm">
                                                        {{ file.createdAt|date('D j M Y, g:i A') }}
                                                    </td>

                                                    <td class="text-sm">
                                                        {{ file.updatedAt|date('D j M Y, g:i A') }}
                                                    </td>

                                                    </td>
                                                    <td class="text-center">
                                                        <div class="item-action dropdown">
                                                            <a href="javascript:void(0)" data-toggle="dropdown"
                                                               data-boundary="window" class="icon"><i
                                                                        class="fas fa-ellipsis-v"></i></a>
                                                            <div class="dropdown-menu dropdown-menu-right">
                                                                <a href="{{ path('dashboard_organizer_management_files_download_file', {'fileId': file.id}) }}"
                                                                   class="dropdown-item"><i
                                                                            class="fas fa-download fa-fw text-muted"></i> {{ 'Download' }}
                                                                </a>
                                                                <a href="{{ path('dashboard_organizer_management_files_edit', {'id': file.id}) }}"
                                                                   class="dropdown-item"><i
                                                                            class="fas fa-pencil-alt fa-fw text-muted"></i> {{ 'Edit' }}
                                                                </a>
                                                                <a href="{{ path('dashboard_organizer_management_files_delete', {'id': file.id}) }}"
                                                                   class="dropdown-item"><i
                                                                            class="fas fa-trash fa-fw text-muted"></i> {{ 'Delete' }}
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            {{ knp_pagination_render(files, null, {}, {'align': 'center'}) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script>
        $(document).ready(function () {
            $('#filter').on('keyup', function () {
                var selectedStatus = $(this).val().toLowerCase();
                if (selectedStatus !== '') {
                    $('tbody tr').hide(); // Hide all rows
                    $('tbody tr td:nth-child(2)').each(function () {
                        var cellText = $(this).text().toLowerCase(); // Convert cell text to lowercase
                        if (cellText.includes(selectedStatus)) {
                            $(this).parent().show(); // Show rows with selected status
                        }
                    });
                } else {
                    $('tbody tr').show(); // Show all rows when "All" is selected
                }
            });
        });
    </script>

{% endblock %}