{% extends "Global/layout.html.twig" %}

{% set pagetitle = venue.title %}

{% block title %}{{ pagetitle }}{% endblock %}

{% block meta_dynamic_seo %}
{% endblock %}

{% block content %}

    {% set navigation = [{"venues": "venues", "current" : (pagetitle)}] %}
    {% include "Global/navigation.html.twig" with navigation %}

    <div class="row no-gutters">
        <div class="col-12 p-0">
            <section class="section-main">
                <div class="owl-init slider-main owl-carousel" data-items="1" data-dots="false" data-nav="false"
                     data-autoplay="false">
                    <div class="item-slide d-flex">
                        <img class="slider-img justify-content-center align-self-center img-lazy-load"
                             src="{{ asset('assets/img/loader.gif') }}"
                             data-src="{{ venue.mainImage ? asset(venue.getMainImage) : venue.getImagePlaceholder }}"
                             alt="{{ venue.title }}"/>
                        <div class="slider-blured-background"
                             style="background-image: url('{{ venue.mainImage ? asset(venue.getMainImage) : venue.getImagePlaceholder }}');"></div>
                    </div>
                </div>
            </section>
        </div>
    </div>
    <section class="section-content padding-y bg-white">
        <div class="{{ services.getSetting("app_layout") }}">
            <div class="card">
                <div class="row">
                    <div class="col-12 col-lg-8 order-1 order-lg-0">
                        <div class="card-body">
                            <h1 class="card-title b d-none d-lg-block">{{ venue.title }}</h1>
                            {% if venue.description %}
                                <dl class="mt-5 venue-description">
                                    <dt class="text-muted">{{ "Description" }}</dt>
                                    <dd class="line-height-2 readmore" data-collapsed-height="500"
                                        data-height-margin="20">
                                        {{ venue.description|raw|nl2br }}
                                    </dd>
                                </dl>
                            {% endif %}
                            {% if venue.getSecondaryImages|length > 0 %}
                                <dl class="mt-5">
                                    <dt class="text-muted">{{ "Photos" }}</dt>
                                    <dd class="mr-0">
                                        <div class="gallery photos-gallery clearfix">
                                            {% for image in venue.getSecondaryImages %}
                                                <figure>
                                                    <a href="{{ asset(image.getImagePath) }}"
                                                       data-size="{{ image.imageDimensions is not empty ? image.imageDimensions[0] ~ 'x' ~ image.imageDimensions[1] : 'N/A' }}"
                                                    <img class="img-lazy-load img-thumbnail img-100-100"
                                                         src="{{ asset('assets/img/loader.gif') }}"
                                                         data-src="{{ asset(image.getImagePath) }}"
                                                         alt="{{ venue.title }}"/>
                                                    </a>
                                                </figure>
                                            {% endfor %}

                                        </div>
                                    </dd>
                                </dl>
                            {% endif %}
                        </div>
                    </div>
