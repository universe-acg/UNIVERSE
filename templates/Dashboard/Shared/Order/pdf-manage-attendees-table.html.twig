<style>
    /* Custom CSS for table */
    .custom-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px; /* Add some margin for spacing */
    }

    /* Style for table headers */
    .custom-table th {
        background-color: #f5f5f5; /* Header background color */
        text-align: left;
        padding: 10px;
    }

    /* Style for table cells */
    .custom-table td {
        padding: 10px;
        border: 1px solid #ddd; /* Add borders for cells */
    }

    /* Style for alternate rows (striped rows) */
    .custom-table tbody tr:nth-child(even) {
        background-color: #f2f2f2; /* Alternate row background color */
    }

    /* Additional custom style for td elements */
    .custom-td {
        width: 50%; /* Evenly space the td elements within each column */
    }

</style>

<table class="table table-hover table-vcenter custom-table">
    <thead>
        <tr>
            <th>Full name</th>
            <th>Date booked</th>
            <th>Status</th>
            <th>Overbook</th>
        </tr>
    </thead>
    <tbody>
        {% for order in orders if order.orderelements %}
            <tr>
                <td class="custom-td">{{ order.user.getCrossRoleName }}</td>
                <td class="custom-td">{{ order.createdAt|localizeddate('none', 'none', app.request.locale, date_timezone, date_format) }}</td>
                <td class="custom-td">
                    {% if order.status == 1 %}
                        Booked (Not Attended)
                    {% elseif order.status == 2 %}
                        Attended
                    {% endif %}
                </td>
                <td class="custom-td">
                    {% if order.overbook %}
                        True
                    {% else %}
                        False
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>
