{% set eventlink = "" %}
<div class="table-responsive">
    <table class="table table-hover table-vcenter">
        <thead>
            <tr>
                <th>{{ 'Event' }}</th>
                <th>{{ 'Date of event' }}</th>
                <th>{{ 'Date booked' }}</th>
                <th>{{ 'Status' }}</th>
                <th class="text-center"><i class="fas fa-cog"></i></th>
            </tr>
        </thead>
        <tbody>

            {% for order in orders if order.orderelements %}
                {% if true %}
                    <tr>
                    <td class="text-sm">
                        {% for orderelement in order.orderelements %}
                            {% if is_granted('ROLE_ATTENDEE') %}
                                {% if (not app.request.get('event') or app.request.get('event') == orderelement.eventticket.eventdate.event.slug) and (not app.request.get('eventdate') or app.request.get('eventdate') == orderelement.eventticket.eventdate.reference) and (not app.request.get('eventticket') or app.request.get('eventticket') == orderelement.eventticket.reference) and (not app.request.get('organizer') or app.request.get('organizer') == orderelement.eventticket.eventdate.event.organizer.slug) %}
                                    {% set eventlink  = "https://universeacg.xyz/event/" ~ orderelement.eventticket.eventdate.event.slug %}
                                    <a href="{{ path('event', { slug: orderelement.eventticket.eventdate.event.slug }) }}">{{ orderelement.eventticket.eventdate.event.name }}
                                        | {{ orderelement.eventticket.name }}</a>
                                {% endif %}
                            {% endif %}
                        {% endfor %}
                    </td>

                    {% if  not is_granted("ROLE_ATTENDEE") %}
                        <td class="text-sm">
                            {% if is_granted('ROLE_ADMINISTRATOR') %}
                                <span title="{{ "User information" }}" data-toggle="tooltip"
                                      data-title="{{ "User information" }}"
                                      data-url="{{ path('dashboard_administrator_user_information', { slug : order.user.slug }) }}"
                                      class="ajax-loading">{{ order.user.getCrossRoleName }}</span>
                            {% else %}
                                {{ order.user.getCrossRoleName }}
                            {% endif %}
                        </td>
                    {% endif %}
                    <td class="text-sm">
                        {% if order.orderelements | length > 0 %}
                            {{ order.orderelements[0].eventticket.eventdate.startdate|localizeddate('none', 'none', app.request.locale, date_timezone, date_format) }}
                        {% endif %}
                    </td>
                    <td class="text-sm">
                        {{ order.createdAt|localizeddate('none', 'none', app.request.locale, date_timezone, date_format) }}
                    </td>
                    <td class="text-sm">
                        {% if order.status == 2 %}
                            <span class="badge badge-success"><i
                                        class="fas fa-user-check fa-fw"></i> {{ order.stringifyStatus }}</span>
                        {% elseif order.status == 1 or order.status == 2 %}
                            <span class="badge badge-info"><i
                                        class="fas fa-user-check fa-fw"></i> {{ order.stringifyStatus }}</span>
                        {% else %}
                            <span class="badge badge-{{ order.getStatusClass }}"> {{ order.stringifyStatus }}</span>
                        {% endif %}
                        {% if not is_granted("ROLE_ATTENDEE") %}
                            {% if order.deletedAt %}
                                <br>
                                <br>
                                <span class="badge badge-success"><i
                                            class="fas fa-times fa-fw"></i> {{ "Deleted" }}</span>
                            {% endif %}
                        {% endif %}
                    </td>
                    <td class="text-center">
                    <div class="item-action dropdown">
                    <a href="javascript:void(0)" data-toggle="dropdown" data-boundary="window" class="icon"><i
                                class="fas fa-ellipsis-v"></i></a>
                    <div class="dropdown-menu dropdown-menu-right">
                    {% if order.status == 1 or order.status == 2 %}
                        <a href="{{ path('dashboard_tickets_print', { reference: order.reference, link: eventlink }) }}"
                           class="dropdown-item" target="_blank"><i
                                    class="dropdown-icon fas fa-ticket-alt fa-fw text-muted"></i> {{ "Print" }}
                        </a>
                    {% endif %}
                    {% if is_granted('ROLE_ATTENDEE') %}
                        {% if not order.deletedAt %}
                            {#                            {% if order.status == 1 or order.status == 2 %} #}
                            {#                                {% if order.status == 1 %} #}
                            {#                            <span data-target="{{ path('dashboard_attendee_order_cancel', { reference : order.reference, 'ticketid': order.orderelements[0].eventticket.id }) }}" #}
                            {#                                  class="dropdown-item cursor-pointer order-cancel-button" #}
                            {#                                  data-confirmation-text="{{ "You are about to cancel your ticket" }}"><i #}
                            {#                                        class="dropdown-icon fas fa-window-close fa-fw text-muted"></i> {{ "Cancel" }}</span> #}
                            {#                                {% endif %} #}
                            {#                            {% endif %} #}
                            {% if order.status == 1 %}
                                <a href="{{ path('dashboard_attendee_order_delete', { reference: order.reference}) }}"
                                   class="dropdown-item"><i
                                            class="dropdown-icon fas fa-window-close fa-fw text-muted"></i> {{ "Delete" }}
                                </a>
                                {#                                <span data-target="{{ path('dashboard_attendee_order_delete', { reference : order.reference, 'ticketid': order.orderelements[0].eventticket.id}) }}" #}
                                {#                                      class="dropdown-item cursor-pointer order-cancel-button" #}
                                {#                                      data-confirmation-text="{{ "You are about to cancel your ticket" }}"><i #}
                                {#                                            class="dropdown-icon fas fa-window-close fa-fw text-muted"></i> {{ "Delete" }}</span> #}
                            {% endif %}
                        {% endif %}
                    {% endif %}
                {% endif %}
                </div>
                </div>
                </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
