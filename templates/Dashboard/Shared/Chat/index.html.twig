{% extends "Global/layout.html.twig" %}

{% set pagetitle = 'Chat' %}

{% block title %}{{ pagetitle }}{% endblock %}

{% block content %}

    {% set navigation = [{"current":(pagetitle)}] %}
    {% include "Global/navigation.html.twig" with navigation %}

    <section class="section-content padding-y bg-white">
        <div class="{{ services.getSetting("app_layout") }}">
            <div class="row">
                <aside class="col-lg-3 pt-3 pt-lg-0" style="height: 100%; padding-bottom: 0">
                    {% include "Dashboard/chatsidebar.html.twig" with contacts %}
                </aside>
                <div class="col-lg-9" style="height:100%; padding: 0; margin: 0">
                    {#                    for each root #}
                    {% include "Dashboard/Shared/Chat/chatroominside.html.twig" with contacts %}
                    {#                    {% include "Dashboard/Shared/Chat/chatroominside.html.twig" with chatroom %} #}
                    {#                    but only show the one that is clicked... #}
                </div>
            </div>
        </div>
    </section>

{% endblock %}