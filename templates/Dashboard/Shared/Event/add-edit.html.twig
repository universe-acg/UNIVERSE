{% extends "Global/layout.html.twig" %}

{% form_theme form 'Global/jquery.collection.html.twig' %}
{% form_theme formsimple 'Global/jquery.collection.html.twig' %}

{% set pagetitle = 'Add a new event' %}

{% if event.id %}{% set pagetitle = 'Update the event' %}{% endif %}

{% block title %}{{ pagetitle }}{% endblock %}

{% block content %}

    <style>
        .select2-selection.select2-selection--multiple.select2-selection--clearable {
            height: 500px !important;
        }

        .select2-container {
            height: 500px !important;
        }

        select.form-control[multiple], select.form-control[size], textarea.form-control {
            height: 500px !important;
        }
    </style>

    {% set navigation = [{ "dashboard_index": ('Dashboard' ),  "dashboard_organizer_event": ('My events'), "current":(pagetitle) }] %}
    {% include "Global/navigation.html.twig" with navigation %}

    <section
            class="section-content padding-y bg-white {{ "event_add" in app.request.get("_route") ? "add-event" : "edit-event" }}">
        <div class="{{ services.getSetting("app_layout") }}">
            <div class="row">
                <aside class="col-lg-3 pt-3 pt-lg-0">
                    {% include "Dashboard/sidebar.html.twig" %}
                </aside>
                <div class="col-lg-9 mt-4 mt-lg-0">
                    <div class="card box">
                        <div class="card-body">
                            {% include "Global/message.html.twig" with { type: "info", icon: "fas fa-info-circle", message: ("The fields preceded with a red * are mandatory") } %}
                            <div class="form-tabs">
                                <ul class="nav nav-tabs" role="tablist">
                                    <li class="nav-item">
                                        <a class="nav-link active" id="basic-tab" data-toggle="tab" href="#basic"
                                           role="tab">Basic</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" id="advanced-tab" data-toggle="tab" href="#advanced"
                                           role="tab">Advanced</a>
                                    </li>
                                </ul>

                                <div class="tab-content">
                                    <div class="tab-pane fade show active" id="basic" role="tabpanel">
                                        <br>
                                        {{ form_start(formsimple, {'attr': {'novalidate': 'novalidate'}}) }}
                                        {{ form_widget(formsimple) }}
                                        {{ form_end(formsimple) }}
                                    </div>
                                    <div class="tab-pane fade" id="advanced" role="tabpanel">
                                        <br>
                                        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                                        {{ form_widget(form) }}
                                        {{ form_end(form) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>
{% endblock %}

{% block javascripts %}
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Summernote CSS -->
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-bs4.min.css" rel="stylesheet">

    <!-- Summernote JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-bs4.min.js"></script>

    <!-- Include the necessary libraries (e.g., jQuery and datepicker) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/css/bootstrap-datepicker.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-daterangepicker@3.0.3/daterangepicker.js"></script>

    <!-- Initialize the datepicker -->
    <script>
        $(document).ready(function () {
            $('#event_type_multi_userEvents').change(function () {
                var eventId = $(this).val();
                // Make an AJAX request to fetch event details based on the selected event ID
                $.ajax({
                    type: 'GET',
                    url: '/api/get-event-details/' + eventId,
                    dataType: 'json',
                    success: function (data) {
                        // Check if the 'slug' field exists in the data
                        if (data.slug) {
                            // Construct the URL for redirection
                            var redirectUrl = '/dashboard/organizer/my-events/' + data.slug + '/prefill';
                            // Redirect to the new URL
                            window.location.href = redirectUrl;
                        } else {
                            console.error('Slug not found in data');
                        }
                    }
                });
            });
            $('#event_type_multi_repeatsweekly').on('change', function () {
                const yes = $('#event_type_multi_repeatsweekly_0:checked').val();
                if (yes) {
                    $('.repetition-options').parent().show();
                } else {
                    $('.repetition-options').parent().hide();
                }
            });


            const yes = $('#event_type_multi_repeatsweekly_0:checked').val();
            if (yes) {
                $('.repetition-options').parent().show();
            } else {
                $('.repetition-options').parent().hide();
            }


            $('#event_type_userEvents').change(function () {
                var eventId = $(this).val();
                // Make an AJAX request to fetch event details based on the selected event ID
                $.ajax({
                    type: 'GET',
                    url: '/api/get-event-details/' + eventId,
                    dataType: 'json',
                    success: function (data) {
                        // Check if the 'slug' field exists in the data
                        if (data.slug) {
                            // Construct the URL for redirection
                            var redirectUrl = '/dashboard/organizer/my-events/' + data.slug + '/prefill';
                            // Redirect to the new URL
                            window.location.href = redirectUrl;
                        } else {
                            console.error('Slug not found in data');
                        }
                    }
                });
            });
            $('#event_repeatsweekly').on('change', function () {
                const yes = $('#event_repeatsweekly_0:checked').val();
                if (yes) {
                    $('.repetition-options').parent().show();
                } else {
                    $('.repetition-options').parent().hide();
                }
            });


            const yes1 = $('#event_repeatsweekly_0:checked').val();
            if (yes1) {
                $('.repetition-options').parent().show();
            } else {
                $('.repetition-options').parent().hide();
            }


            // Initialize DateRangePicker on the input field with the 'date-range-picker' class
            $('.date-range-picker').daterangepicker({
                opens: 'left'
            });

            const $editableDiv = $('.note-editable');

            {% if event.id %}
            {% for eventDate in event.eventdates %}
            {% for eventDateTicket in eventDate.tickets if eventDateTicket.isOnSale and eventDateTicket.getOrderElementsQuantitySum() > 0 %}
            $('.event-date-ticket-reference').each(function () {
                if ($(this).val() == "{{ eventDateTicket.reference }}") {
                    $(this).closest("fieldset").find('.event-date-ticket-quantity').trigger("touchspin.updatesettings", {min: {{ eventDateTicket.getOrderElementsQuantitySum() }}});
                    $(this).closest("fieldset").find('.event-date-ticket-quantity').attr("data-min", {{ eventDateTicket.getOrderElementsQuantitySum() }});
                }
            });
            {% endfor %}
            {% endfor %}
            {% endif %}

            $(document).on('submit', 'form[name="event"]', function () {
                $('form[name="event"]').find('fieldset').prop('disabled', false);
            });

            // $(document).on('submit', 'form_simple[name="event"]', function () {
            //     $('form[name="event"]').find('fieldset').prop('disabled', false);
            // });
        });
    </script>

    <script>
        $(document).ready(function () {
            // $('#event_type_multi_publishDate').parent().hide();
            console.dir($('#event_type_multi_publishDate'));

            // Initially, check the value of "Publish on Specific Date" when the page loads
            togglePublicationDateField();

            // Attach an event listener to the "Publish on Specific Date" radio buttons
            $('input[name="event_type_multi[publishOnSpecificDate]"]').change(function () {
                togglePublicationDateField();
            });

            function togglePublicationDateField() {
                // Check if "Yes" is selected for "Publish on Specific Date"
                var isPublishOnSpecificDate = $('input[name="event_type_multi[publishOnSpecificDate]"]:checked').val() === '1';
                console.dir(isPublishOnSpecificDate);
                // Show or hide the "Select the publication date and time" field based on the selection
                if (isPublishOnSpecificDate) {
                    $('#event_type_multi_publishDate').parent().show();
                    $('#event_type_multi_publishDate').show();
                } else {
                    $('#event_type_multi_publishDate').parent().hide();
                    $('#event_type_multi_publishDate').hide();
                }
            }

            toggleVenueFieldVisibility();

            // Listen for changes in the "outofcampus" field
            $('#event_type_multi_edit_outofcampus').on('change', function () {
                toggleVenueFieldVisibility();
            });

            function toggleVenueFieldVisibility() {
                $('#event_type_multi_edit_outofcampus').on('change', function () {
                    const isnotoutofcampus = $('#event_type_multi_edit_outofcampus_0:checked').val();
                    var venueField = $('#event_type_multi_edit_venue').parent();
                    if (isnotoutofcampus) {
                        venueField.show();
                    } else {
                        venueField.hide();
                    }
                });
            }

            // Initially, check the value of "viewablebyselect" when the page loads
            toggleFields();

            // Attach an event listener to the "viewablebyselect" radio buttons
            $('input[name="event_type_multi[viewablebyselect]"]').change(function () {
                toggleFields();
            });
            $('#event_type_multi_visibletoallmembers').parent().hide();
            $('#event_type_multi_selectattendees').parent().hide();

            function toggleFields() {
                // Check if "Yes" is selected for "viewablebyselect"
                var isViewableBySelect = $('input[name="event_type_multi[viewablebyselect]"]:checked').val() === '1';

                // Show or hide the "visibletoallmembers" and "selectattendees" fields based on the selection
                if (isViewableBySelect) {
                    $('#event_type_multi_visibletoallmembers').parent().show();
                    $('#event_type_multi_selectattendees').parent().show();
                } else {
                    $('#event_type_multi_visibletoallmembers').parent().hide();
                    $('#event_type_multi_selectattendees').parent().hide();
                }
            }

            // Attach an event listener to the "visibletoallmembers" radio buttons
            $('input[name="event_type_multi[visibletoallmembers]"]').change(function () {
                toggleSelectAttendees();
            });

            function toggleSelectAttendees() {
                // Check if "Yes" is selected for "visibletoallmembers"
                var isVisibleToAllMembers = $('input[name="event_type_multi[visibletoallmembers]"]:checked').val() === '1';
                console.dir(isVisibleToAllMembers);
                // Get the "selectattendees" field element
                var $selectAttendees = $('#event_type_multi_selectattendees');

                // If it's visible to all members, make an XHR request to retrieve member data
                if (isVisibleToAllMembers) {
                    $.get('https://universeacg.xyz/api/getmembers', function (data) {
                        $.each(data, function (userId, displayName) {
                            // Create a new option element
                            var option = new Option(displayName, userId, true, true);
                            $selectAttendees.append(option);
                        });

                        // Reinitialize the Select2 component after adding options
                        $selectAttendees.select2();
                    });
                }
            }
        });
    </script>
{% endblock %}