{% extends "Global/layout.html.twig" %}

{% set pagetitle = 'Notification Center' %}

{% block title %}{{ pagetitle }}{% endblock %}

{% block content %}

    {% set navigation = [{"current":(pagetitle)}] %}
    {% include "Global/navigation.html.twig" with navigation %}

    <section class="section-content padding-y bg-white">
        <div class="{{ services.getSetting("app_layout") }}">
            <div class="row">
                <aside class="col-lg-3 pt-3 pt-lg-0">
                    {% include "Dashboard/sidebar.html.twig" %}
                </aside>
                <div class="col-lg-9 mt-4 mt-lg-0">
                    <div class="card box">
                        <div class="card-body">

                            <div style="display: flex; justify-content: space-between; align-content: center; align-items: center">
                                <h4>Notification Center</h4>
                                <a href="{{ path('mark_all_notifications_as_read') }}"
                                   class="styled-button2 btn btn-primary d-inline-block">
                                    Mark All
                                    as Read
                                </a>
                            </div>
                            <br>
                            <div class="table-responsive">
                                <table class="table table-hover table-vcenter text-nowrap">
                                    <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Message</th>
                                        <th>Date</th>
                                        <th>Actions</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for notification in notifications %}
                                        <tr>

                                            <td class="text-sm">
                                              <span style="margin-right: 6px">  {% if notification.getread %}
                                                      <i class="fas fa-check-circle text-success"></i>
                                                {% else %}
                                                      <i class="fas fa-circle text-warning"></i>
                                                  {% endif %} </span> {{ notification.name }}
                                            </td>
                                            <td class="text-sm">
                                                {{ notification.description }}
                                            </td>
                                            <td class="text-sm">
                                                {{ notification.createdAt|localizeddate('none', 'none', app.request.locale, date_timezone, date_format) }}
                                            </td>
                                            <td class="text-center">
                                                <div class="item-action dropdown">
                                                    <a href="javascript:void(0)" data-toggle="dropdown"
                                                       data-boundary="window" class="icon">
                                                        <i class="fas fa-ellipsis-v"></i>
                                                    </a>
                                                    <div class="dropdown-menu dropdown-menu-right">
                                                        <a href="{{ path('notification_show', {'id': notification.id}) }}"
                                                           class="dropdown-item">
                                                            <i class="dropdown-icon far fa-eye fa-fw text-muted"></i>
                                                            View
                                                        </a>
                                                        <a href="{{ path('notification_mark_as_read', {'id': notification.id}) }}"
                                                           class="dropdown-item">
                                                            <i class="dropdown-icon far fa-check-circle fa-fw text-muted"></i>
                                                            Mark as Read
                                                        </a>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>

{% endblock %}