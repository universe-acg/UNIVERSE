{% extends "Global/layout.html.twig" %}

{% set pagetitle = 'Account settifdasafdafngs' %}

{% block title %}{{ pagetitle }}{% endblock %}

{% block content %}

    <style>
        .image-selector {
            width: 100%; /* Adjust the width as needed */
            margin: 0 auto;
        }

        .scrollbox {
            max-height: 100%; /* Adjust the height as needed */
            overflow-y: auto;
            border: 1px solid #ccc;
        }

        .image-item {
            display: flex;
            align-items: center;
            padding: 5px;
            cursor: pointer;
            float: left;
        }

        .image-item.selected {
            background-color: #314CA3; /* Highlight color */
        }

        .image-item img {
            max-height: 98px; /* Adjust the height as needed */
            margin-right: 10px;
        }

        .image-item {
            display: inline-block;
            cursor: pointer;
            margin: 5px;
            border: 2px solid transparent; /* Add a transparent border to all images */
        }

        .image-item.selected {
            border-color: #314CA3; /* Highlight color for selected image */
        }
    </style>

    {% set navigation = [{"current":(pagetitle)}] %}
    {% include "Global/navigation.html.twig" with navigation %}

    <section class="section-content padding-y bg-white">
        <div class="{{ services.getSetting("app_layout") }}">
            <div class="row">
                <aside class="col-lg-3 pt-3 pt-lg-0">
                    {% include "Dashboard/sidebar.html.twig" %}
                </aside>
                <div class="col-lg-9 mt-4 mt-lg-0">
                    <div class="card box">
                        <div class="card-body">

                            <div class="form-group bg-light p-3 d-none d-xl-block">
                                <span>{{ "Account status" }}</span> <span class="badge badge-info ml-2"><i
                                            class="fas fa-user-check fa-fw"></i> {{ "Enabled" }}</span>
                                <span class="ml-3">{{ "Last login" }}</span> <span
                                        class="badge badge-info ml-3"><i
                                            class="fas fa-sign-in-alt fa-fw"></i> {{ app.user.lastLogin|ago }}</span>
                                <span class="ml-3">{{ "Member since" }}</span> <span
                                        class="badge badge-info ml-3"><i
                                            class="fas fa-user-plus fa-fw"></i> {{ app.user.createdAt|localizeddate('none', 'none', app.request.locale, date_timezone, date_format) }}</span>
                            </div>

                            {{ form_start(form) }}
                            <div>
                                <div class="image-selector">
                                    {{ form_label(form.selectedImage) }}
                                    <div class="image-list">
                                        {% for choice in form.selectedImage.vars.choices %}
                                            <div class="image-item">
                                                <img src="{{ asset( 'https://universe.alexandroskourtis.me/uploads/imgs/' ~ choice.data) }}"
                                                     alt="{{ choice.label }}" class="selectable-image">
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                            <div class="clearfix"></div>
                            <br>
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {#    <img src="{{ asset( 'https://universe.alexandroskourtis.me/uploads/imgs/' ~ choice.data) }}" #}

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const images = document.querySelectorAll(".selectable-image");
            images.forEach((image) => {
                image.addEventListener("click", function () {
                    // Deselect all images
                    document.querySelectorAll(".image-item").forEach(item => item.classList.remove("selected"));
                    // Select the clicked image
                    this.parentElement.classList.add("selected");

                    const value = this.getAttribute("alt");
                    document.querySelector('input[name="{{ form.selectedImage.vars.full_name }}"][value="' + value + '"]').click();
                });
            });
        });
    </script>
{% endblock %}