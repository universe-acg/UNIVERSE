{% extends 'Global/layout.html.twig' %}
{% set pagetitle='Manage live sessions' %}{% block title %}{{ pagetitle }}{% endblock %}
{% block content %}
{% set navigation=[{'dashboard_index':'Dashboard','current':pagetitle}] %}{% include 'Global/navigation.html.twig' with navigation %}
<section class="section-content padding-y bg-white"><div class="{{ services.getSetting('app_layout') }}"><div class="row"><aside class="col-lg-3">{% include 'Dashboard/sidebar.html.twig' %}</aside><div class="col-lg-9">
<a class="btn btn-primary mb-3" href="{{ path('dashboard_organizer_live_add') }}">Add live session</a>
<div class="table-responsive"><table class="table table-hover"><thead><tr><th>Title</th><th>Status</th><th>Visibility</th><th>Actions</th></tr></thead><tbody>
{% for live in lives %}<tr><td>{{ live.title }}</td><td>{{ live.statusStringified }}</td><td>{{ live.deletedAt?'Deleted':(live.hidden?'Hidden':'Public') }}</td><td>
{% if live.deletedAt %}<form method="post" action="{{ path('dashboard_organizer_live_restore',{slug:live.slug}) }}"><input type="hidden" name="_action_token" value="{{ csrf_token('action') }}"><button type="submit" class="btn btn-sm btn-outline-primary">Restore</button></form>{% else %}
<a href="{{ path('dashboard_organizer_live_edit',{slug:live.slug}) }}" class="btn btn-sm btn-outline-primary">Edit</a>
{% if not live.hidden %}<a href="{{ path('live',{slug:live.slug}) }}" class="btn btn-sm btn-link">View</a>{% endif %}
<form class="d-inline" method="post" action="{{ path(live.hidden?'dashboard_organizer_live_show':'dashboard_organizer_live_hide',{slug:live.slug}) }}"><input type="hidden" name="_action_token" value="{{ csrf_token('action') }}"><button class="btn btn-sm btn-link" type="submit">{{ live.hidden?'Show':'Hide' }}</button></form>
<form class="d-inline" method="post" action="{{ path('dashboard_organizer_live_delete',{slug:live.slug}) }}"><input type="hidden" name="_action_token" value="{{ csrf_token('action') }}"><button class="btn btn-sm btn-link text-danger" type="submit">Delete</button></form>
{% endif %}</td></tr>{% else %}<tr><td colspan="4">No live sessions yet.</td></tr>{% endfor %}
</tbody></table></div>{{ knp_pagination_render(lives) }}</div></div></div></section>
{% endblock %}
