<section class="section-content padding-y bg-white"><div class="{{ services.getSetting('app_layout') }}"><div class="row"><aside class="col-lg-3">{% include 'Dashboard/sidebar.html.twig' %}</aside><div class="col-lg-9"><div class="card box"><div class="card-body">{{ form_start(form) }}{{ form_widget(form) }}{{ form_end(form) }}</div></div></div></div></div></section>{% endblock %}
