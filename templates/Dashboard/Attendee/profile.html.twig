{% extends "Global/layout.html.twig" %}

{% set pagetitle = attendee.getCrossRoleName() %}

{% block title %}{{ pagetitle }}{% endblock %}

{% block content %}

    <section class="section-content padding-y bg-white">
        <div class="{{ services.getSetting("app_layout") }}">
            <div class="row">
                <main class="col-12">

                    <div class="shadow rounded overflow-hidden" style="min-height: 100vh">
                        {% if attendee.coverName %}
                        <img class="organizer-profile-cover parallax-window" data-parallax="scroll"
                             style="height: 350px !important; width: 100% !important; object-fit: cover; object-position: center"
                             src="{{ asset(attendee.getCoverPath) }}"></img>{% endif %}

                        <div class="row mt-5">
                            <div class="col-12 col-lg-4" style="background: white !important;">
                                <div class="attendee-profile-sidebar text-center {% if not attendee.getCrossRoleName() %}mt-3 mb-3{% endif %}">

                                        <span class="avatar organizer-profile-logo"
                                              style="background-size: cover; background: url('{{ attendee.logoName ? asset(attendee.getLogoPath) : attendee.getLogoPlaceholder }}');"></span>

                                    <h4 class="font-weight-bold text-center my-5">{{ attendee.getCrossRoleName() }}</h4>

                                    {% if attendee.hasSocialMedia %}
                                        <ul class="list-inline mb-0">
                                            {% if attendee.website %}
                                                <li class="list-inline-item">
                                                    <a href="{% if 'http://' not in attendee.website and 'https://' not in attendee.website %}http://{% endif %}{{ attendee.website }}"
                                                       class="display-inline-block mr-3" target="_blank"><i
                                                                class="icon fas fa-globe fa-lg fa-fw"></i></a>
                                                </li>
                                            {% endif %}
                                            {% if attendee.email %}
                                                <li class="list-inline-item">
                                                    <a href="mailto:{{ attendee.email }}"
                                                       class="display-inline-block mr-3" target="_blank"><i
                                                                class="icon fas fa-at fa-lg fa-fw"></i></a>
                                                </li>
                                            {% endif %}
                                            {% if attendee.phone %}
                                                <li class="list-inline-item">
                                                    <a href="tel:{{ attendee.phone }}"
                                                       class="display-inline-block mr-3"><i
                                                                class="icon fas fa-phone fa-lg fa-fw"></i></a>
                                                </li>
                                            {% endif %}
                                            {% if attendee.facebook %}
                                                <li class="list-inline-item">
                                                    <a href="{% if 'http://' not in attendee.facebook and 'https://' not in attendee.facebook %}http://{% endif %}{{ attendee.facebook }}"
                                                       class="display-inline-block mr-3" target="_blank"><i
                                                                class="icon fab fa-facebook-f fa-lg fa-fw"></i></a>
                                                </li>
                                            {% endif %}
                                            {% if attendee.twitter %}
                                                <li class="list-inline-item">
                                                    <a href="{% if 'http://' not in attendee.twitter and 'https://' not in attendee.twitter %}http://{% endif %}{{ attendee.twitter }}"
                                                       class="display-inline-block mr-3" target="_blank"><i
                                                                class="icon fab fa-twitter fa-lg fa-fw"></i></a>
                                                </li>
                                            {% endif %}
                                            {% if attendee.tiktok %}
                                                <a href="{% if 'http://' not in attendee.tiktok and 'https://' not in attendee.tiktok %}http://{% endif %}{{ attendee.tiktok }}"
                                                   class="display-inline-block mr-3" target="_blank"><i
                                                            class="icon fab fa-google-plus fa-lg fa-fw"></i></a>
                                            {% endif %}
                                            {% if attendee.instagram %}
                                                <a href="{% if 'http://' not in attendee.instagram and 'https://' not in attendee.instagram %}http://{% endif %}{{ attendee.instagram }}"
                                                   class="display-inline-block mr-3" target="_blank"><i
                                                            class="icon fab fa-instagram fa-lg fa-fw"></i></a>
                                            {% endif %}
                                            {% if attendee.linkedin %}
                                                <a href="{% if 'http://' not in attendee.linkedin and 'https://' not in attendee.linkedin %}http://{% endif %}{{ attendee.linkedin }}"
                                                   class="display-inline-block mr-3" target="_blank"><i
                                                            class="icon fab fa-linkedin fa-lg fa-fw"></i></a>
                                            {% endif %}
                                        </ul>
                                    {% endif %}

                                    {% if attendee.bio %}
                                        <div class="py-4 px-4 text-muted line-height-2 readmore"
                                             data-collapsed-height="150" data-height-margin="20">
                                            {{ attendee.bio|raw|nl2br }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="col-12 col-lg-8 bg-light">

                                {% set publishedeventscount = services.getEvents({"count": true, elapsed: "all", attendee: attendee.slug}).getQuery().getResult() | length %}

                                <div class="p-4 d-flex justify-content-end text-center">
                                    <ul class="list-inline mb-0">
                                        <li class="list-inline-item mr-3">
                                            <h5 class="font-weight-bold mb-0 d-block">{{ attendedEvents | length }}</h5>
                                            <small class="text-muted"> <i
                                                        class="fas fa-calendar-alt fa-fw mr-1"></i>{{ "Attended Events" }}
                                            </small>
                                        </li>
                                        <li class="list-inline-item">
                                            <h5 class="font-weight-bold mb-0 d-block">{{ favoriteEvents | length }}</h5>
                                            <small class="text-muted"> <i
                                                        class="fas fa-newspaper mr-1"></i>{{ "Favorite Events" }}
                                            </small>
                                        </li>
                                        <li class="list-inline-item">
                                            <h5 class="font-weight-bold mb-0 d-block">{{ comments|length }}</h5>
                                            <small class="text-muted"> <i
                                                        class="fas fa-folder-plus mr-1"></i>{{ "Comments" }}
                                            </small>
                                        </li>
                                        {#                                        <li class="list-inline-item ml-3"> #}
                                        {#                                            {% if not is_granted('IS_AUTHENTICATED_REMEMBERED') or is_granted('ROLE_ATTENDEE') %} #}
                                        {#                                                {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %} #}
                                        {#                                                    {% if attendee.isFollowedBy(app.attendee) %} #}
                                        {#                                                        <button class="attendee-unfollow btn btn-outline-primary btn-sm btn-block" #}
                                        {#                                                                data-target="{{ path('app_dashboard_attendee_following_remove', { slug : attendee.slug }) }}"> #}
                                        {#                                                            <i class="fas fa-folder-minus"></i> {{ "Unfollow" }} #}
                                        {#                                                        </button> #}
                                        {#                                                    {% else %} #}
                                        {#                                                        <button class="attendee-follow btn btn-outline-primary btn-sm btn-block" #}
                                        {#                                                                data-target="{{ path('app_dashboard_attendee_following_add', { slug : attendee.slug }) }}" #}
                                        {#                                                        > #}
                                        {#                                                            <i class="fas fa-folder-plus"></i> {{ "Follow" }} #}
                                        {#                                                        </button> #}
                                        {#                                                    {% endif %} #}
                                        {#                                                {% else %} #}
                                        {#                                                    <a href="{{ path('fos_attendee_security_login')~'?_target_path='~app.request.getPathInfo }}" #}
                                        {#                                                       class="btn btn-outline-primary btn-sm btn-block"><i #}
                                        {#                                                                class="fas fa-folder-plus"></i> {{ "Follow" }}</a> #}
                                        {#                                                {% endif %} #}
                                        {#                                            {% endif %} #}
                                        {#                                        </li> #}
                                    </ul>
                                </div>

                                {% set attendedEventscount = attendedEvents | length %}
                                {% set favoriteEventscount = favoriteEvents | length %}
                                {% set commentscount = comments | length %}
                                <div class="py-4 px-4">
                                    <ul class="nav nav-pills mb-3">
                                        <li class="nav-item">
                                            <a class="nav-link active" data-toggle="pill"
                                               href="#attendee-onsale-events" role="tab"
                                               aria-controls="attendee-onsale-events"
                                               aria-selected="true">{{ "Attended Events" }}
                                                ({{ attendedEventscount }})</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" data-toggle="pill"
                                               href="#attendee-past-events" role="tab"
                                               aria-controls="attendee-past-events"
                                               aria-selected="true">{{ "Favorite Events" }}
                                                ({{ favoriteEventscount }})</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" data-toggle="pill"
                                               href="#attendee-news" role="tab"
                                               aria-controls="attendee-news"
                                               aria-selected="true">{{ "Comments" }}
                                                ({{ commentscount }})</a>
                                        </li>
                                    </ul>
                                    <div class="tab-content">
                                        <div class="tab-pane fade show active" id="attendee-onsale-events"
                                             role="tabpanel" aria-labelledby="attendee-onsale-events-tab">
                                            {% if attendedEventscount > 0 %}
                                                {% for event in attendedEvents %}
                                                    {% include "Global/event-card.html.twig" with {event: event} %}
                                                {% endfor %}
                                            {% else %}
                                                {% include "Global/message.html.twig" with { type: "info", message: ('This user prefers an air of mystery around their attendeed events') } %}
                                            {% endif %}
                                        </div>
                                        <div class="tab-pane fade active" id="attendee-past-events"
                                             role="tabpanel" aria-labelledby="attendee-past-events-tab">
                                            {% if favoriteEventscount > 0 %}
                                                {% for event in favoriteEvents %}
                                                    {% include "Global/event-card.html.twig" with {event: event} %}
                                                {% endfor %}
                                            {% else %}
                                                {% include "Global/message.html.twig" with { type: "info", message: ('This user prefers an air of mystery around their favorite events') } %}
                                            {% endif %}
                                        </div>
                                        <div class="tab-pane fade active" id="attendee-news"
                                             role="tabpanel" aria-labelledby="attendee-news-tab">
                                            {% if commentscount > 0 %}
                                                {% for comment in comments %}
                                                    {#                                                    {% include "Global/new-card.html.twig" with {new: new} %} #}
                                                {% endfor %}
                                            {% else %}
                                                {% include "Global/message.html.twig" with { type: "info", message: ('This user prefers an air of mystery around their comments') } %}
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>

                                {% if attendee.youtubeurl %}
                                    <div class="py-4 px-4">
                                        <h4 class="mb-2"><i class="fab fa-youtube-square mr-1"></i> {{ "Video" }}
                                        </h4>
                                        <iframe width="100%" height="400"
                                                src="https://www.youtube.com/embed/{{ attendee.youtubeurl|split('=')[1] }}"
                                                frameborder="0"
                                                allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
                                                allowfullscreen></iframe>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </section>

{% endblock %}

{% block javascripts %}
    {% if google_maps_api_key != "" %}
        {{ encore_entry_script_tags('organizerprofile') }}
        <script async defer
                src="https://maps.googleapis.com/maps/api/js?key={{ google_maps_api_key }}&callback=initMap">
        </script>
        <script>
            // Add an event listener to the tabs to handle tab switching
            document.querySelectorAll('.nav-pills .nav-link').forEach(function (tab) {
                tab.addEventListener('click', function (e) {
                    e.preventDefault();
                    // Remove the 'active' class from all tab links
                    document.querySelectorAll('.nav-pills .nav-link').forEach(function (link) {
                        link.classList.remove('active');
                    });
                    // Add the 'active' class to the clicked tab link
                    this.classList.add('active');

                    // Remove the 'show' class from all tab panes
                    document.querySelectorAll('.tab-pane').forEach(function (pane) {
                        pane.classList.remove('show', 'active');
                    });
                    // Add the 'show' class to the clicked tab's associated pane
                    const targetId = this.getAttribute('href').replace('#', '');
                    document.getElementById(targetId).classList.add('show', 'active');
                });
            });

            // Show the first tab by default
            document.querySelector('.nav-pills .nav-link:first-child').classList.add('show', 'active');
        </script>

        {#        {% include "Global/organ-info-box.html.twig" %} #}
    {% endif %}

    <style>
        .parallax-mirror {
            position: absolute !important;
            display: none;
        }
    </style>

{% endblock %}
