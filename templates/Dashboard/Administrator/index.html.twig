{% extends "Global/layout.html.twig" %}

{% set pagetitle = 'Dashboard' %}

{% block title %}{{ pagetitle }}{% endblock %}

{% block content %}

    {% set navigation = [{"current":(pagetitle)}] %}
    {% include "Global/navigation.html.twig" with navigation %}

    <section class="section-content padding-y bg-white">
        <div class="{{ services.getSetting("app_layout") }}">
            <div class="row">
                <aside class="col-lg-3 pt-3 pt-lg-0">
                    {% include "Dashboard/sidebar.html.twig" %}
                </aside>
                <div class="col-lg-9 mt-4 mt-lg-0">
                    <div class="card box">
                        <div class="card-body">

                            <header class="section-heading mb-3">
                                <h4 class="title-section float-left"><i
                                            class="fas fa-calendar-alt"></i> {{ "Events summary" }}</h4>
                                <a href="{{ path('dashboard_administrator_event') }}" class="float-right"><i
                                            class="fas fa-cog"></i> {{ "Manage events" }}</a>
                                <div class="clearfix"></div>
                            </header>
                            <div class="row mb-3 pl-2 pr-2">
                                <div class="col-md-3 col-sm-6 col-12 p-1">
                                    <div class="bg-primary rounded p-4 text-center text-white position-relative counter-box">
                                        <i class="fas fa-calendar-alt"></i>
                                        <h4>{{ services.getEvents({"count": true}) | length }}</h4>
                                        <h5 class="mb-0">{{ "Events added" }}</h5>
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-6 col-12 p-1">
                                    <div class="bg-primary rounded p-4 text-center text-white position-relative counter-box">
                                        <i class="fas fa-calendar-alt"></i>
                                        <h4>{{ services.getEvents({"count": true, "published": true}) | length }}</h4>
                                        <h5 class="mb-0">{{ "Published events" }}</h5>
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-6 col-12 p-1">
                                    <div class="bg-primary rounded p-4 text-center text-white position-relative counter-box">
                                        <i class="fas fa-calendar-alt"></i>
                                        <h4>{{ services.getEvents({"count": true, "published": true, "elapsed": false}) | length }}</h4>
                                        <h5 class="mb-0">{{ "Upcoming events" }}</h5>
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-6 col-12 p-1">
                                    <div class="bg-primary rounded p-4 text-center text-white position-relative counter-box">
                                        <i class="fas fa-user"></i>
                                        <h4>{{ services.getUsersTotal() }}</h4>
                                        <h5 class="mb-0">{{ "Total users" }}</h5>
                                    </div>
                                </div>
                            </div>
                            {% set events = services.getEvents({"published": "all", "elapsed": "all", "limit": 3}) %}
                            {% if events|length > 0 %}
                                <div class="row">
                                    <div class="col-12">
                                        <div class="card">
                                            {% include "Dashboard/Shared/Event/manage-events-table.html.twig" with {events: events} %}
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>

{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
{% endblock %}