{% extends "Global/layout.html.twig" %}

{% block content %}
    <section class="section-content padding-y bg-white">
        <div class="{{ services.getSetting("app_layout") }}">
            <div class="row">
                <aside class="col-lg-3 pt-3 pt-lg-0">
                    {% include "Dashboard/sidebar.html.twig" %}
                </aside>
                <div class="col-xl-4 col-12">
                    <h3>Create creator</h3>
                    <br>
                    {{ form_start(form, {'method': 'post', 'attr': {'novalidate': 'novalidate'}}) }}
                    {{ form_errors(form) }}

                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text border-0"> <i class="far fa-id-card"></i> </span>
                            </div>
                            {{ form_widget(form.organizer.name, {'attr': {'placeholder': 'Enter organizer name'}}) }}
                        </div>
                        {{ form_errors(form.organizer.name) }}
                        <small class="form-text text-muted">Please enter organizer name.</small>
                    </div>

                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text border-0"> <i class="fas fa-users"></i> </span>
                            </div>
                            {{ form_widget(form.organizer.category, {'attr': {'placeholder': 'Enter organizer category'}}) }}
                        </div>
                        {{ form_errors(form.organizer.category) }}
                        <small class="form-text text-muted">Please enter organizer category.</small>
                    </div>

                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text border-0"> <i class="fas fa-user"></i> </span>
                            </div>
                            {{ form_widget(form.firstname, {'attr': {'placeholder': 'Enter your first name'}}) }}
                        </div>
                        {{ form_errors(form.firstname) }}
                        <small class="form-text text-muted">Please enter your first name.</small>
                    </div>
                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text border-0"> <i class="fas fa-user"></i> </span>
                            </div>
                            {{ form_widget(form.lastname, {'attr': {'placeholder': 'Enter your last name'}}) }}
                        </div>
                        {{ form_errors(form.lastname) }}
                        <small class="form-text text-muted">Please enter your last name.</small>
                    </div>
                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text border-0"> <i class="fas fa-user-tag"></i> </span>
                            </div>
                            {{ form_widget(form.username, {'attr': {'placeholder': 'Choose a username'}}) }}
                        </div>
                        {{ form_errors(form.username) }}
                        <small class="form-text text-muted">Please choose a username.</small>
                    </div>
                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text border-0"> <i class="fas fa-envelope"></i> </span>
                            </div>
                            {{ form_widget(form.email, {'attr': {'placeholder': 'Enter your email address'}}) }}
                        </div>
                        {{ form_errors(form.email) }}
                        <small class="form-text text-muted">Please enter your email address.</small>
                    </div>
                    <p>Is this a multi-ticket user?</p>
                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-prepend mr-3">
                                <span class="input-group-text border-0"> <i class="fas fa-user"></i> </span>
                            </div>
                            {{ form_widget(form.isbusinessweek) }}
                        </div>
                        {{ form_errors(form.isbusinessweek) }}
                        <small class="form-text text-muted">Please indicate if this is a multi-ticket user.</small>
                    </div>
                    <div class="form-group">
                        <button type="submit"
                                class="btn btn-primary btn-block">Create
                        </button>
                    </div>

                    {{ form_widget(form._token) }}
                    {{ form_end(form, {'render_rest': false}) }}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
