{% extends "Global/layout.html.twig" %}

{% set pagetitle = 'Manage categories' %}

{% block title %}{{ pagetitle }}{% endblock %}

{% block content %}

    {% set navigation = [{ "dashboard_index": ('Dashboard' ), "current":(pagetitle) }] %}
    {% include "Global/navigation.html.twig" with navigation %}

    <section class="section-content padding-y bg-white">
        <div class="{{ services.getSetting("app_layout") }}">
            <div class="row">
                <aside class="col-lg-3 pt-3 pt-lg-0">
                    {% include "Dashboard/sidebar.html.twig" %}
                </aside>
                <div class="col-lg-9 mt-4 mt-lg-0">

                    <div class="box shadow-none bg-gray mb-4">
                        <div class="row">
                            <a href="{{ path('dashboard_administrator_listing_category_add') }}"
                               class="btn btn-primary ml-3" data-toggle="tooltip"
                               title="{{ 'Add a new category' }}"><i class="fas fa-plus"></i></a>
                            {#                        </div> #}
                        </div>
                    </div>

                    {% if categories.getTotalItemCount > 0 %}

                        <div class="row">

                            <div class="col-12">
                                <div class="card">
                                    <div class="table-responsive">
                                        <table class="table table-hover table-vcenter text-nowrap">
                                            <thead>
                                            <tr>
                                                <th>{{ 'Name' }}</th>
                                                <th>{{ 'Events count' }}</th>
                                                <th>{{ 'Status' }}</th>
                                                <th class="text-center"><i class="fas fa-cog"></i></th>
                                            </tr>
                                            </thead>
                                            <tbody>

                                            {% for category in categories %}

                                                <tr>
                                                    <td>
                                                        {{ category.name }}
                                                    </td>
                                                    <td>
                                                        {{ category.listings|length }}
                                                    </td>
                                                    <td>
                                                        {% if category.hidden %}
                                                            <span class="badge badge-danger"><i
                                                                        class="fas fa-eye-slash fa-fw"></i> {{ "Hidden" }}</span>
                                                        {% else %}
                                                            <span class="badge badge-success"><i
                                                                        class="fas fa-eye fa-fw"></i> {{ "Visible" }}</span>
                                                        {% endif %}
                                                        {% if category.deletedAt %}
                                                            <br>
                                                            <br>
                                                            <span class="badge badge-danger"><i
                                                                        class="fas fa-times fa-fw"></i> {{ "Deleted" }}</span>
                                                        {% endif %}
                                                    </td>
                                                    <td class="text-center">
                                                        <div class="item-action dropdown">
                                                            <a href="javascript:void(0)" data-toggle="dropdown"
                                                               data-boundary="window" class="icon"><i
                                                                        class="fas fa-ellipsis-v"></i></a>
                                                            <div class="dropdown-menu dropdown-menu-right">
                                                                <a href="{{ path('dashboard_administrator_listing_category_edit', { slug : category.slug }) }}"
                                                                   class="dropdown-item"><i
                                                                            class="dropdown-icon fas fa-edit fa-fw text-muted"></i> {{ "Edit" }}
                                                                </a>
                                                                {% if category.hidden %}
                                                                    <a href="{{ path('dashboard_administrator_listing_category_show', { slug : category.slug }) }}"
                                                                       class="dropdown-item"><i
                                                                                class="dropdown-icon fas fa-eye fa-fw text-muted"></i> {{ "Show" }}
                                                                    </a>
                                                                {% else %}
                                                                    <a href="{{ path('dashboard_administrator_listing_category_hide', { slug : category.slug }) }}"
                                                                       class="dropdown-item"><i
                                                                                class="dropdown-icon fas fa-eye-slash fa-fw text-muted"></i> {{ "Hide" }}
                                                                    </a>
                                                                {% endif %}
                                                                {#                                                                    {% if category.featured %} #}
                                                                {#                                                                        <a href="{{ path('dashboard_administrator_category_notfeatured', { slug : category.slug }) }}" #}
                                                                {#                                                                           class="dropdown-item"><i #}
                                                                {#                                                                                    class="dropdown-icon fas fa-thumbtack fa-fw text-muted"></i> {{ "Mark as not featured" }} #}
                                                                {#                                                                        </a> #}
                                                                {#                                                                    {% else %} #}
                                                                {#                                                                        <a href="{{ path('dashboard_administrator_category_featured', { slug : category.slug }) }}" #}
                                                                {#                                                                           class="dropdown-item"><i #}
                                                                {#                                                                                    class="dropdown-icon fas fa-star fa-fw text-muted"></i> {{ "Mark as featured" }} #}
                                                                {#                                                                            <i class="fas fa-info-circle" #}
                                                                {#                                                                               title="{{ "Will be show in the homepage, the explore menu item dropdown and in the footer" }}" #}
                                                                {#                                                                               data-toggle="tooltip" #}
                                                                {#                                                                               data-placement="left"></i> </a> #}
                                                                {#                                                                    {% endif %} #}
                                                                {% if category.deletedAt %}
                                                                    <a href="{{ path('dashboard_administrator_listing_category_restore', { slug : category.slug }) }}"
                                                                       class="dropdown-item"><i
                                                                                class="dropdown-icon fas fa-trash-restore fa-fw text-muted"></i> {{ "Restore" }}
                                                                    </a>
                                                                    <span data-target="{{ path('dashboard_administrator_listing_category_delete', { slug : category.slug }) }}"
                                                                          class="dropdown-item requires-confirmation"
                                                                          data-confirmation-text="{{ "You are about to delete the category PERMANENTLY" }}"><i
                                                                                class="dropdown-icon fas fa-trash fa-fw text-muted"></i> {{ "Delete" }}</span>
                                                                {% else %}
                                                                    <a href="{{ path('dashboard_administrator_listing_category_disable', { slug : category.slug }) }}"
                                                                       class="dropdown-item"><i
                                                                                class="dropdown-icon fas fa-times fa-fw text-muted"></i> {{ "Delete" }}
                                                                    </a>
                                                                {% endif %}
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>

                                            {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                {{ knp_pagination_render(categories, null, {}, {'align': 'center'}) }}
                            </div>

                        </div>

                    {% else %}

                        {% include "Global/message.html.twig" with { type: "info", message: ('No Listings categories found'), icon: "fas fa-exclamation-circle" } %}

                    {% endif %}
                </div>
            </div>

        </div>
    </section>

{% endblock %}

{% block javascripts %}

    <script>

        $(document).ready(function () {
            if (getURLParameter('featured')) {
                $('input[type="radio"][name="featured"][value="' + getURLParameter('featured') + '"]').attr("checked", "checked");
            }
        });

    </script>

{% endblock %}