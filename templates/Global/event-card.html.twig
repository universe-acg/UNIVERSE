{% set runtimeConfig = {"thumbnail": {"size": [500, 250] }} %}

{% if eventDate is defined %}
    {% set displayedEventDate = eventDate %}
{% else %}
    {% set displayedEventDate = event.getFirstOnSaleEventDate %}
{% endif %}

{% if customLink is defined %}
    {% set link = customLink %}
{% else %}
    {% set link = path('event', { slug : event.slug }) %}
{% endif %}

<style>
    .link-style {
        color: #007bff; /* Set the text color to a blue shade (you can change the color to your preference) */
        text-decoration: none; /* Remove the underline by default */
        font-weight: bold; /* Optionally, make the text bold */
    }

    /* Define a hover effect for the hyperlink */
    .link-style:hover {
        text-decoration: underline; /* Underline the text when hovering */
    }
</style>

<div class="card card-event">
    <div class="img-wrap img-lazy-load"
         data-src="{{ event.imageName ? asset(event.getImagePath|imagine_filter('thumbnail', runtimeConfig)) : event.getImagePlaceholder }}">
        <a href="{{ link }}"></a>
        <div class="loader"></div>
    </div>
    <div class="info-wrap">
        {% if (not is_granted('IS_AUTHENTICATED_REMEMBERED') or is_granted('ROLE_ATTENDEE')) and hideFavoriteButton is not defined %}
            <div class="event-favorite">
                {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                    {% if event.isAddedToFavoritesBy(app.user) %}
                        <button class="event-favorites-remove"
                                data-target="{{ path('dashboard_attendee_favorites_remove', { slug : event.slug }) }}"
                                data-toggle="tooltip" title="{{ "Remove from favorites" }}"><i class="fas fa-heart"></i>
                        </button>
                    {% else %}
                        <button class="event-favorites-add"
                                data-target="{{ path('dashboard_attendee_favorites_add', { slug : event.slug }) }}"
                                data-toggle="tooltip" title="{{ "Add to favorites" }}"><i class="far fa-heart"></i>
                        </button>
                    {% endif %}
                {% else %}
                    <a href="{{ path('fos_user_security_login')~'?_target_path='~app.request.getPathInfo }}"
                       data-toggle="tooltip" title="{{ "Add to favorites" }}"><i class="far fa-heart"></i></a>
                {% endif %}
            </div>
        {% endif %}
        <div class="event-info" style="width: 100%;">
            <h5>
                <a href="{{ link }}" class="text-dark">{{ event.name }}</a>
            </h5>

            <div class="text-black-50 small">
                {% if displayedEventDate %}
                    {#                    {% if displayedEventDate.venue %} #}
                    {#                        {{ displayedEventDate.venue.name }}: {{ displayedEventDate.venue.city ~ ', ' ~ displayedEventDate.venue.country.name }} #}
                    {#                    {% else %} #}
                    {#                        {{ "Online" }} #}
                    {#                    {% endif %} #}
                {% endif %}
                &nbsp;
            </div>
            {% if displayedEventDate.startdate %}
                {% set currentDate = "now"|date('F j, Y H:i', 'Europe/Athens') %}
                {% if displayedEventDate.startdate|date('F j, Y H:i', 'Europe/Athens') <= currentDate %}
                    {% if displayedEventDate.enddate is not null and displayedEventDate.enddate|date('F j, Y H:i', 'Europe/Athens') < currentDate %}
                        {{ displayedEventDate.startdate|date('F j, Y H:i', 'Europe/Athens') }} | Event has ended
                    {% else %}
                        {{ displayedEventDate.startdate|date('F j, Y H:i', 'Europe/Athens') }} | Event has started
                    {% endif %}
                {% else %}
                    {{ displayedEventDate.startdate|date('F j, Y H:i', 'Europe/Athens') }}
                {% endif %}
            {% endif %}

            <span style="float: right"><a href="{{ path('organizer', {slug: (event.getOrganizer().getSlug())}) }}"
                                          class="link-style text-dark">{{ (event.getOrganizer().getName()) }}</a></span>

        </div>
        {% if hidePrice is not defined %}
            <div class="price-wrap">
                {% if event.isFree %}
                    {#                    <span class="price-new">{{ "Free" }}</span> #}
                {% else %}
                    {% if displayedEventDate %}
                        {#                        <span class="price-new">{{ services.getSetting('currency_position') == 'left' ? services.getSetting('currency_symbol') : '' }}{{ event.getCheapestTicket.getSalePrice }}{{ services.getSetting('currency_position') == 'right' ? services.getSetting('currency_symbol') : '' }}</span> #}
                    {% endif %}
                {% endif %}
            </div>
        {% endif %}
        {% if orderReference is defined %}
            <div class="order-reference">
                <a href="{{ path('dashboard_attendee_order_details', {reference: orderReference}) }}"><small>{{ "Order" }}
                        #{{ orderReference }}</small></a>
            </div>
        {% endif %}
        <div class="clearfix"></div>
    </div>
    {#    <span class="event-category"> #}
    {#        {% if ticketName is defined %} #}
    {#            #}{#            <b>{{ ticketName }}</b> <br> #}
    {#        {% endif %} #}
    {#        {% if ticketsCount is defined %} #}
    {#            #}{#            {{ ticketsCount }} {{ ticketsCount > 1 ? "tickets" : "ticket" }} #}
    {#        {% else %} #}
    {#            #}{#            {{ event.category.name }} #}
    {#        {% endif %} #}
    {#    </span> #}
    {% if displayedEventDate %}
        {% if displayedEventDate.startdate %}
            <div class="event-date text-center">
                <div class="event-month bg-primary text-light">{{ displayedEventDate.startdate|localizeddate('none', 'none', app.request.locale, null, "MMM")|upper }}</div>
                <div class="event-day bg-white">{{ displayedEventDate.startdate|localizeddate('none', 'none', app.request.locale, null, "d") }}</div>
            </div>
        {% endif %}
    {% endif %}
</div>