{% set displayedEventDate = event.eventdates|first %}
{% set link = customLink|default(path('event', {slug: event.slug})) %}
<article class="card public-card card-event">
    <a href="{{ link }}" tabindex="-1" aria-hidden="true">{% include 'Global/public-image.html.twig' with {image: event.imageName ? event.getImagePath : null, alt: ''} only %}</a>
    <div class="card-body">
        {% if (not is_granted('IS_AUTHENTICATED_REMEMBERED') or is_granted('ROLE_ATTENDEE')) and hideFavoriteButton is not defined %}
            <div class="event-favorite">
            {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                {% set favorite = event.isAddedToFavoritesBy(app.user) %}
                <button type="button" class="event-favorites-{{ favorite ? 'remove' : 'add' }}" data-target="{{ path(favorite ? 'dashboard_attendee_favorites_remove' : 'dashboard_attendee_favorites_add', {slug: event.slug}) }}" aria-label="{{ favorite ? 'Remove from favorites' : 'Add to favorites' }}" title="{{ favorite ? 'Remove from favorites' : 'Add to favorites' }}"><i class="{{ favorite ? 'fas' : 'far' }} fa-heart" aria-hidden="true"></i></button>
            {% else %}
                <a href="{{ path('fos_user_security_login', {_target_path: app.request.pathInfo}) }}" aria-label="Sign in to save this event"><i class="far fa-heart" aria-hidden="true"></i></a>
            {% endif %}
            </div>
        {% endif %}
        {% if displayedEventDate and displayedEventDate.startdate %}
            <div class="public-card-date"><time datetime="{{ displayedEventDate.startdate|date('c') }}">{{ displayedEventDate.startdate|format_datetime(pattern='EEE, d MMM yyyy · HH:mm', locale=app.request.locale, timezone='Europe/Athens') }}</time></div>
        {% endif %}
        <h2 class="card-title"><a class="text-dark" href="{{ link }}">{{ event.name }}</a></h2>
        {% if event.isPassed %}<p class="small text-muted">Event has ended</p>{% endif %}
        <div class="public-card-meta">
            <a href="{{ path('organizer', {slug: event.organizer.user.username}) }}">{{ event.organizer.name }}</a>
            {% if event.venue %}<a href="{{ path('venue', {slug: event.venue.slug}) }}">{{ event.venue.title }}</a>{% endif %}
        </div>
        {% if orderReference is defined %}<p class="mt-3 mb-0"><a href="{{ path('dashboard_attendee_order_details', {reference: orderReference}) }}">Order #{{ orderReference }}</a></p>{% endif %}
    </div>
</article>
