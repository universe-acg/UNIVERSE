{% set runtimeConfig = {"thumbnail": {"size": [500, 250] }} %}
{% set displayedEventDate = event.eventdates|first %}
{% set endedEventDate = (event.eventdates|last).enddate|default(null) %}
{% if customLink is defined %}
    {% set link = customLink %}
{% else %}
    {% set link = path('event', { slug : event.slug }) %}
{% endif %}

 {% set past = past|default(false) %}
{# {% set attendeed = attendeed|default(false) %} #}
{#    <div class="card card-event {{ attendeed ? 'attended-event' }}" style="z-index: 999 !important;"> #}
<div class="card card-event" style="z-index: 999 !important;">
    {#    <div class="img-wrap img-lazy-load {{ event.isPassed or past or  attendeed  ? 'grayed-out' : '' }}" #}
    <div class="img-wrap img-lazy-load {{ event.isPassed ? 'grayed-out' : '' }}"
         data-src="{{ event.imageName ? asset(event.getImagePath) : event.getImagePlaceholder }}">
        <a href="{{ link }}"></a>
        <div class="loader"></div>
    </div>
    <div class="info-wrap">
        {% if (not is_granted('IS_AUTHENTICATED_REMEMBERED') or is_granted('ROLE_ATTENDEE')) and hideFavoriteButton is not defined %}
            <div class="event-favorite">
                {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                    {% if event.isAddedToFavoritesBy(app.user) %}
                        <button class="event-favorites-remove"
                                data-target="{{ path('dashboard_attendee_favorites_remove', { slug : event.slug }) }}"
                                data-toggle="tooltip" title="{{ "Remove from favorites" }}"><i class="fas fa-heart"></i>
                        </button>
                    {% else %}
                        <button class="event-favorites-add"
                                data-target="{{ path('dashboard_attendee_favorites_add', { slug : event.slug }) }}"
                                data-toggle="tooltip" title="{{ "Add to favorites" }}"><i class="far fa-heart"></i>
                        </button>
                    {% endif %}
                {% else %}
                    <a href="{{ path('fos_user_security_login')~'?_target_path='~app.request.getPathInfo }}"
                       data-toggle="tooltip" title="{{ "Add to favorites" }}"><i class="far fa-heart"></i></a>
                {% endif %}
            </div>
        {% endif %}

        <span class="event-info" style="float: left">
                    {% if  event.getOrganizer().getUser().isAdmin() %}
                    <h5 style="float: left;">
                         <a style="float: left" href="{{ link }}"
                            class="text-dark">{{ event.name }} {{ event.isPassed }}</a>
                            </h5>
                        {% else %}
                    <h5 style="float: left;">
                         <a style="float: left" href="{{ link }}"
                            class="text-dark">{{ event.name }} {{ event.isPassed }}</a>
                            </h5>

                <span style="float: right">
                             <div style="display: inline-block">
         <a
                 href="{{ path('organizer', {slug: (event.getOrganizer().getUser().getUsername())}) }}">
                          <div class="outer-image">
{#                                 {% if event.getOrganizer().getUser().getPoints() > 0 and event.getOrganizer().getUser().orggoodrole %} #}
                              {#                                     <img src="{{ asset(event.getOrganizer().getUser().imagiifypointslevel) }}"> #}
                              <img src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/wcAAgAB/axikW8AAAAASUVORK5CYII=">
{#                                 {% endif %} #}
                                <div class="inner-image">
                                            <img src="{{ event.getOrganizer().logoName ? asset(event.getOrganizer().getLogoPath) : event.getOrganizer().getLogoPlaceholder }}">
                                        </div>
                                    </div>
             </a>
                        {% endif %}
                        </div>
           </span>


                 {% if event.isattended %}
                     {{ displayedEventDate and displayedEventDate.startdate ? displayedEventDate.startdate|date('F j, Y H:i', 'Europe/Athens') : "Date not recorded"|trans }} |<span
                         class="accomplishment">✨Attended✨</span>
                 {% elseif event.isPassed %}
                     {{ displayedEventDate and displayedEventDate.startdate ? displayedEventDate.startdate|date('F j, Y H:i', 'Europe/Athens') : "Date not recorded"|trans }} | Event has ended
                 {% else %}
                     {% set currentDate = "now"|date('U', 'Europe/Athens') %}
                     {% if displayedEventDate.startdate|date('U') > currentDate %}
                         Starts on: {{ displayedEventDate and displayedEventDate.startdate ? displayedEventDate.startdate|date('F j, Y H:i', 'Europe/Athens') : "Date not recorded"|trans }}
                     {% else %}
                         {{ displayedEventDate and displayedEventDate.startdate ? displayedEventDate.startdate|date('F j, Y H:i', 'Europe/Athens') : "Date not recorded"|trans }}| Event has started
                     {% endif %}
                 {% endif %}


            {% if  is_granted('IS_AUTHENTICATED_REMEMBERED') and event.showattendees %}
                <div class="mt-3">
                    {% set attendees = services.getUsersShuffled({"hasbookedticketfor": event.slug, "limit": 14, "role": "attendee"}).getQuery().getResult() %}
                    {% if attendees | length > 0 %}
                        {% for user in attendees %}
                            {% if user.showattendeed %}
                                {% include "Global/user-avatar-events.html.twig" with { user: user, showusernametooltip: true } %}
                            {% endif %}
                        {% endfor %}
                    {% else %}
                        {#                        <p>No attendees as of yet</p> #}
                    {% endif %}
                </div>
            {% endif %}
        </span>

        {% if orderReference is defined %}
            <div class="order-reference">
                <a href="{{ path('dashboard_attendee_order_details', {reference: orderReference}) }}"><small>{{ "Order" }}
                        #{{ orderReference }}</small></a>
            </div>
        {% endif %}

        Organized by: <a href="{{ path('organizer', {slug: (event.getOrganizer().getUser().getUsername())}) }}"
                         class="link-style text-dark">{{ (event.getOrganizer().getName()) }}</a>

        {% if event.venue %}
            | <a
                href="{{ path('venue', {slug: (event.getVenue().getSlug())}) }}"
                class="link-style text-dark">{{ (event.getVenue().getTitle()) }}</a>
        {% endif %}

        <div class="clearfix"></div>
    </div>
    {% if displayedEventDate %}
        {% if displayedEventDate.startdate %}
            <div class="event-date text-center">
                <div class="event-month bg-primary text-light">{{ displayedEventDate.startdate|localizeddate('none', 'none', app.request.locale, null, "MMM")|upper }}</div>
                <div class="event-day bg-white">{{ displayedEventDate.startdate|localizeddate('none', 'none', app.request.locale, null, "d") }}</div>
            </div>
        {% endif %}
    {% endif %}
</div>
