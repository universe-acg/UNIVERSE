{% set runtimeConfig = {"thumbnail": {"size": [600, 450] }} %}
<a href="{{ path('events', { category: category.slug }) }}" class="zoom-wrap">
    <div class="card-banner mb-3">
        <div class="card-body zoom-in img-lazy-load"
             data-src="{{ category.imageName ? asset(category.getImagePath|imagine_filter('thumbnail', runtimeConfig)) : category.getImagePlaceholder }}"
             style="height:350px; background-repeat: no-repeat; background-position: center center;">
            <div class="loader"></div>
        </div>
    </div>
</a>
