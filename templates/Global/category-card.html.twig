{% set runtimeConfig = {"thumbnail": {"size": [400, 250] }} %}
<a href="{{ path('events', { category: category.slug }) }}" class="zoom-wrap">
    <div class="card-banner mb-3">
        <div class="card-body zoom-in img-lazy-load"
             data-src="{{ category.imageName ? asset(category.getImagePath) : category.getImagePlaceholder }}"
             style="height: 300px; background-repeat: no-repeat; background-position: center center;">
            <div class="loader"></div>
        </div>
    </div>
</a>
