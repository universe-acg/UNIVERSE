<section class="header-main sticky-top">
    <div class="{{ services.getSetting("app_layout") }}">
        <div class="row align-items-center">
            <div class="col-6 col-lg-3 order-0 order-lg-0 header-logo-wrapper">
                <div class="brand-wrap">
                    <a href="{{ path('homepage') }}">
                        <img class="logo img-fluid" src="{{ asset(services.getAppLayoutSettings.getLogoPath) }}"
                             alt="{{ services.getSetting("website_name") }}">
                    </a>
                </div>
            </div>
            <div class="col-12 col-lg-5 order-2 order-lg-1 mt-3 mb-3 mt-lg-0 mb-lg-0 header-search-wrapper">
                <form action="{{ path('events') }}" class="search-wrap">
                    <div class="input-icon">
                        <i class="fa fa-search"></i>
                        <input name="keyword" class="form-control top-search" placeholder="{{ "Search for events" }}"
                               type="search" id="search-input" aria-label="Search for events">
                    </div>
                </form>
            </div>
            <div class="col-6 col-lg-4 text-right order-1 order-lg-2 header-actions-wrapper">
                <div class="widgets-wrap d-flex justify-content-end">

                    {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                        {% set notificationsData = services.getLastFiveNotificationsWithUnreadFlag() %}

                        <div class="widget-header dropdown"
                             style="display: flex;justify-content: center;align-items: center;">
                            <a href="#" class="icontext" data-toggle="dropdown" aria-label="Notifications" aria-haspopup="true" aria-expanded="false">
                                <i class="{{ notificationsData.hasUnreadNotifications ? 'fas' : 'far' }} fa-bell" aria-hidden="true"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-right header-notifications-dropdown-menu">
                                {% for notification in notificationsData.lastFiveNotifications %}
                                    {% if not notification.read %}
                                        <span style="display: flex; justify-content: space-between; align-items: center; align-content: center">
            <a class="dropdown-item"
               href="{{ path('notification_show', {'id': notification.id}) }}">
                {{ notification.name }}
            </a>
            <span style="cursor: pointer; margin-right: 10px"
                  data-notification-id="{{ notification.id }}"
                  class="badge badge-warning mark-as-read" data-read-url="{{ path('notification_mark_as_read_xhr', {id:notification.id}) }}" role="button" tabindex="0" aria-label="Mark notification as read">
                <i class="fas fa-check"></i>
            </span>
        </span>
                                    {% else %}
                                        <a class="dropdown-item"
                                           href="{{ path('notification_show', {'id': notification.id}) }}">
                                            {{ notification.name }}
                                        </a>
                                    {% endif %}
                                {% endfor %}

                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="{{ path('notification_list') }}">{{ 'All notifications'|trans }}</a>
                            </div>
                        </div>

                        <div class="widget-header dropdown">
                            <a href="#" class="ml-3 icontext" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Account menu">
                                {% if is_granted('ROLE_ADMINISTRATOR') %}
                                    <span class="avatar">
                                        <i class="far fa-user"></i>
                                    </span>
                                {% else %}
                                    {% include "Global/user-avatar.html.twig" with { user : app.user } %}
                                {% endif %}
                                <div class="text-wrap ">
                                    <span>{{ app.user.getCrossRoleName }} <i class="fas fa-caret-down"></i></span>
                                </div>
                            </a>

                            <div class="dropdown-menu dropdown-menu-left header-user-dropdown-menu">

                                {% if is_granted('ROLE_ADMINISTRATOR') %}
                                    <a class="dropdown-item" href="{{ path('dashboard_index') }}">
                                        <i class="fas fa-tachometer-alt fa-fw"></i> {{ 'Dashboard' }}
                                    </a>
                                {% elseif is_granted('ROLE_ORGANIZER') %}
                                    <a class="dropdown-item"
                                       href="{{ path('dashboard_organizer_event') }}">
                                        <i class="fas fa-tachometer-alt fa-fw"></i> {{ 'Dashboard' }}
                                    </a>
                                {% elseif is_granted('ROLE_ATTENDEE') %}
                                    <a class="dropdown-item" href="{{ path('dashboard_index') }}">
                                        <i class="fas fa-tachometer-alt fa-fw"></i> {{ 'Dashboard' }}
                                    </a>
                                {% endif %}
                                <button type="button" class="dropdown-item d-lg-none" data-dashboard-menu-toggle aria-controls="dashboard-sidenav" aria-expanded="false" onclick="openDashboardSideNav()"><i class="fas fa-bars fa-fw" aria-hidden="true"></i> {{ 'Dashboard menu'|trans }}</button>
                                <a class="dropdown-item" href="{{ path('chat_index') }}"><i class="far fa-comments fa-fw" aria-hidden="true"></i> {{ 'Chat'|trans }}</a>
                                {% if is_granted('ROLE_ATTENDEE') %}
                                    <a class="dropdown-item" href="{{ path('dashboard_attendee_account_settings') }}"><i class="fas fa-user-cog fa-fw" aria-hidden="true"></i> {{ 'Account settings'|trans }}</a>
                                {% elseif is_granted('ROLE_ORGANIZER') %}
                                    <a class="dropdown-item" href="{{ path('dashboard_organizer_account_settings') }}"><i class="fas fa-user-cog fa-fw" aria-hidden="true"></i> {{ 'Account settings'|trans }}</a>
                                {% endif %}
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="{{ path('fos_user_security_logout') }}"><i
                                            class="fas fa-sign-out-alt fa-fw"></i> {{ "Sign out" }}</a>
                            </div>
                        </div>

                    {% else %}

                        <div class="widget-header">
                            <a href="{{ path('fos_user_security_login') }}" aria-label="Sign in">
                                <div class="icon-wrap icon-xs bg-primary round text-secondary d-lg-none d-xl-none">
                                    <i class="fas fa-sign-in-alt text-light fa-sm fa-fw"></i>
                                </div>
                                <span class="d-none d-lg-block">{{ "Sign in" }}</span>
                            </a>
                        </div>


                        <div class="widget-header dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-label="Sign up"
                               aria-haspopup="true" aria-expanded="false">
                                <div class="icon-wrap icon-xs bg-primary round text-secondary d-lg-none d-xl-none">
                                    <i class="fas fa-user-plus text-light fa-sm fa-fw"></i>
                                </div>
                                <span class="d-none d-lg-inline">{{ "Sign up" }}</span>
                            </a>
                            <div class="dropdown-menu {% if app.request.locale == "ar" %}registration-dropdown dropdown-menu-left{% else %}dropdown-menu-right{% endif %}">
                                <a href="{{ path('fos_user_registration_register_attendee') }}" class="dropdown-item"><i
                                            class="fas fa-user fa-fw"></i> {{ "Attendee" }}</a>
                                <a href="{{ path('fos_user_registration_register_organizer') }}"
                                   class="dropdown-item"><i
                                            class="fas fa-calendar-plus fa-fw"></i> {{ "Organizer" }}</a>
                            </div>
                        </div>

                    {% endif %}

                    <div class="widget-header d-lg-none">
                        <button class="navbar-toggler collapsed" type="button"
                                aria-controls="main_nav" aria-expanded="false" aria-label="Toggle navigation"
                                id="mobile-nav-toggler">
                            <span class="icon-bar top-bar"></span>
                            <span class="icon-bar middle-bar"></span>
                            <span class="icon-bar bottom-bar"></span>
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>
<div class="mobile-nav-backdrop" id="mobile-nav-backdrop"></div>
<header class="section-header">
    <nav aria-label="Main navigation" class="navbar navbar-expand-lg navbar-light bg-white {% if app.request.get("_route") == "homepage" and herosettings is defined and herosettings.content != "none" %}border-0{% endif %}">
        <div class="{{ services.getSetting("app_layout") }}">
            <div class="collapse navbar-collapse" id="main_nav">
                <div class="mobile-nav-close d-lg-none">
                    <button type="button" id="mobile-nav-close" aria-label="Close navigation">
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </button>
                </div>
                {% set headerMenu = navigation_menu('header-menu') %}
                {% set primaryItems = headerMenu.items|filter(item => item.placement != 'more') %}
                {% set moreItems = headerMenu.items|filter(item => item.placement == 'more') %}
                <ul class="navbar-nav nav-fill">
                    {% for item in primaryItems %}{% include 'Global/header-menu-item.html.twig' with {item:item} %}{% endfor %}
                    {% if moreItems|length %}
                        <li class="nav-item dropdown dropdown-hover">
                            <a class="nav-link dropdown-toggle" href="#" id="header-more-menu" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">{{ 'More'|trans }}</a>
                            <div class="dropdown-menu" aria-labelledby="header-more-menu">
                                {% for item in moreItems %}
                                    {% if item.kind in ['categories_dropdown','footer_categories_section'] %}
                                        <h6 class="dropdown-header">{{ item.label }}</h6>
                                        {% for category in services.getCategories({'featured':true,'limit':9}).getQuery().getResult() %}
                                            <a class="dropdown-item" href="{{ path('events',{category:category.slug}) }}">{{ category.name }}</a>
                                        {% endfor %}
                                    {% elseif item.url %}
                                        {% set active = app.request.pathinfo == item.url or (item.url != '/' and app.request.pathinfo starts with (item.url ~ '/')) %}
                                        <a class="dropdown-item{% if active %} active{% endif %}" href="{{ item.url }}"{% if active %} aria-current="page"{% endif %}>{% if item.icon %}<i class="{{ item.icon }} fa-fw" aria-hidden="true"></i>{% endif %} {{ item.label }}</a>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>
</header>
<script>
    // Function to get URL parameters by name
    function getUrlParameter(name) {
        name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
        var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
        var results = regex.exec(location.search);
        return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
    }

    // Get the "keyword" parameter value from the URL
    var keywordValue = getUrlParameter('keyword');

    // Check if the "keyword" parameter exists and is not empty
    if (keywordValue !== '') {
        // Set the input field's value to the "keyword" parameter value
        document.getElementById('search-input').value = keywordValue;
    }

    function markHeaderNotification(event) {
        var control = event.target.closest('[data-read-url]');
        if (!control || (event.type === 'keydown' && event.key !== 'Enter' && event.key !== ' ')) return;
        event.preventDefault();
        var config = document.getElementById('universe-action-config');
        if (!config) return;
        fetch(control.dataset.readUrl, {method:'POST',headers:{'X-CSRF-Token':JSON.parse(config.textContent).token}}).then(function(response) {
            if (response.ok) control.closest('span').remove();
        });
    }
    document.addEventListener('click', markHeaderNotification);
    document.addEventListener('keydown', markHeaderNotification);

    // --- Scroll shadow ---
    (function() {
        var header = document.querySelector('.header-main');
        if (!header) return;
        var scrolled = false;
        window.addEventListener('scroll', function() {
            var shouldBeScrolled = window.scrollY > 10;
            if (shouldBeScrolled !== scrolled) {
                scrolled = shouldBeScrolled;
                header.classList.toggle('header-scrolled', scrolled);
            }
        }, {passive: true});
    })();

    // --- Mobile slide-in nav ---
    (function() {
        var toggler = document.getElementById('mobile-nav-toggler');
        var nav = document.getElementById('main_nav');
        var backdrop = document.getElementById('mobile-nav-backdrop');
        var closeBtn = document.getElementById('mobile-nav-close');
        if (!toggler || !nav) return;

        function openNav() {
            nav.classList.add('show');
            if (backdrop) backdrop.classList.add('show');
            toggler.classList.remove('collapsed');
            toggler.setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';
        }

        function closeNav() {
            nav.classList.remove('show');
            if (backdrop) backdrop.classList.remove('show');
            toggler.classList.add('collapsed');
            toggler.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
        }

        toggler.addEventListener('click', function(e) {
            e.preventDefault();
            if (nav.classList.contains('show')) {
                closeNav();
            } else {
                openNav();
            }
        });

        if (backdrop) backdrop.addEventListener('click', closeNav);
        if (closeBtn) closeBtn.addEventListener('click', closeNav);
    })();
</script>
