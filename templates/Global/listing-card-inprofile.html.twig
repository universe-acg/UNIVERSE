{% set runtimeConfig = {"thumbnail": {"size": [500, 250] }} %}
{% set link = "http://localhost/newunvierse/listing" ~ listing.slug %}
<div class="col-12 col-lg-6">
    <div class="card mb-4 border-0">
        <a href="{{ path('listing', { slug : listing.slug }) }}">
            <img class="card-img-top img-lazy-load" src="{{ asset('assets/img/loader.svg') }}"
                 data-src="{{ listing.imageName ? asset(listing.getImagePath) : listing.getImagePlaceholder }}"
                 alt="{{ listing.name }}">
        </a>
        <div class="card-body">
            <h5 class="card-text">{{ listing.name }}</h5>
            <p class="card-title"><a href="{{ path('listing', { slug : listing.slug }) }}"
                                     class="text-dark">{{ listing.shortdescription }}</a></p>
            <small class="text-muted mr-3"><i class="far fa-clock"></i> {{ listing.createdAt|ago }}</small>
        </div>
    </div>
</div>