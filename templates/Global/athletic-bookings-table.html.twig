<table class="rwd-table">
    <caption>Reservations</caption>
    <tbody>
    <tr>
        <th scope="col">Date & Time</th>
        <th scope="col">Players</th>
        <th scope="col">Duration</th>
        <th scope="col">Participation</th>
        <th scope="col">Status</th>
    </tr>
    {% for reserv in reservations %}
        <tr>
            <td data-th="Date & Time">
                {{ reserv.bookingDate|date('F d, Y H:i') }}
            </td>
            <td data-th="Players">
                {% if reserv.amount == 1 %}
                    {{ reserv.amount }} player
                {% else %}
                    {{ reserv.amount }} players
                {% endif %}
            </td>
            <td data-th="Duration">
                {{ reserv.duration }} minutes
            </td>
            <td data-th="Participation">
                {% if reserv.stringifyStatus == "Reserved" %}
                    Full
                {% else %}
                    {{ reserv.stringifyStatus }}
                {% endif %}
            </td>
            <td data-th="Status">
                {% if reserv.ispast %}
                    Ended
                {% elseif reserv.stringifyStatus == "Reserved" %}
                    Reserved
                {% else %}
                    Open
                {% endif %}
            </td>
        </tr>
    {% else %}<tr><td colspan="5">No reservations yet. Choose a time above to make the first one.</td></tr>{% endfor %}
    </tbody>
</table>
