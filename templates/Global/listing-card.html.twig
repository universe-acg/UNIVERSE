<article class="card public-card">
    <a href="{{ path('listing', {slug: listing.slug}) }}" tabindex="-1" aria-hidden="true">{% include 'Global/public-image.html.twig' with {image: listing.imageName ? listing.getImagePath : null, alt: ''} only %}</a>
    <div class="card-body">
        <h2 class="card-title"><a class="text-dark" href="{{ path('listing', {slug: listing.slug}) }}">{{ listing.name }}</a></h2>
        {% if listing.shortdescription %}<p class="mb-0">{{ listing.shortdescription }}</p>{% endif %}
    </div>
    <div class="card-footer d-flex">
        <div class="public-card-meta">
            {% if listing.category %}<span>{{ listing.category.name }}</span>{% endif %}
            <a href="{{ path('organizer', {slug: listing.organizer.user.username}) }}">{{ listing.organizer.name }}</a>
            <time datetime="{{ listing.createdAt|date('c') }}">{{ listing.createdAt|ago }}</time>
        </div>
        <a class="btn btn-primary" href="{{ path('listing', {slug: listing.slug}) }}">View opportunity</a>
    </div>
</article>
