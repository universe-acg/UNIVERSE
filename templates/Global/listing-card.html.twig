{% set runtimeConfig = {"thumbnail": {"size": [500, 250] }} %}
{% set link = "https://universeacg.xyz/listing" ~ listing.slug %}

<div class="card mb-4 border-0 h-100">
    <a href="{{ path('listing', { slug : listing.slug }) }}">
        <img class="card-img-top img-lazy-load" src="{{ asset('assets/img/loader.svg') }}"
             data-src="{{ listing.imageName ? asset(listing.getImagePath) : listing.getImagePlaceholder }}"
             alt="{{ listing.name }}">
    </a>
    <div class="card-body">
        <h5 class="card-title">{{ listing.name }}</h5>
        <p class="card-text"><a href="{{ path('listing', { slug : listing.slug }) }}"
                                class="text-dark">{{ listing.shortdescription }}</a></p>
    </div>

    <div class="card-footer d-flex justify-content-between">
        <div>
            <div>
                <small class="text-muted"><i class="far fa-clock"></i> {{ listing.createdAt|ago }}</small>
            </div>
            <div>
                <small class="text-muted"><i
                            class="fas fa-stream"></i> {{ listing.category.name }}
                </small>
            </div>
            <small class="text-muted w-100 text-wrap"><i class="far fa-user"></i> By: <a
                        href="{{ path('organizer', { slug : listing.organizer.user.username }) }}">{{ listing.organizer.name|length > 15 ? listing.organizer.name|slice(0, 15) ~ '...' : listing.organizer.name }}
                </a></small>
        </div>
        <button type="submit" class="btn btn-primary" style="border-radius: 0.25em">Quick apply</button>
    </div>
</div>
