{% set runtimeConfig = {"thumbnail": {"size": [400, 250] }} %}

<div class="card">
    <figure class="itemside">
        <div class="aside">
            <div class="img-wrap img-md d-flex" style="height: 100px !important;">
                <img class="img-100-100 align-self-center" style="object-fit: contain !important;"
                     src="{{ organizer.logoName ? asset(organizer.getLogoPath) : organizer.getLogoPlaceholder }}"
                     alt="{{ organizer.name }}">
            </div>
        </div>
        <figcaption class="p-2 align-self-center">
            <h6 class="tit le">{{ organizer.name }}</h6>
            <a href="{{ path('organizer', { slug : organizer.user.username }) }}">{{ "More details" }}</a>
        </figcaption>
    </figure>
</div>