<article class="card public-card">
    <a href="{{ path('blog_article', {slug: blogpost.slug}) }}" tabindex="-1" aria-hidden="true">{% include 'Global/public-image.html.twig' with {image: blogpost.imageName ? blogpost.getImagePath : null, alt: ''} only %}</a>
    <div class="card-body">
        <h2 class="card-title"><a class="text-dark" href="{{ path('blog_article', {slug: blogpost.slug}) }}">{{ blogpost.name }}</a></h2>
        <div class="public-card-meta">
            {% if blogpost.user %}
                <a href="{{ blogpost.user.organizer ? path('organizer', {slug: blogpost.user.username}) : path('profile_attendee', {slug: blogpost.user.slug}) }}">{{ blogpost.user.getCrossRoleName }}</a>
            {% endif %}
            {% if blogpost.category %}<a href="{{ path('blog', {category: blogpost.category.slug}) }}">{{ blogpost.category.name }}</a>{% endif %}
            {% if showdate is defined %}<time datetime="{{ blogpost.createdAt|date('c') }}">{{ blogpost.createdAt|ago }}</time>{% endif %}
        </div>
    </div>
</article>
