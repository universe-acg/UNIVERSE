<footer class="section-footer border-top-gray">
    <div class="{{ services.getSetting("app_layout") }}">
        <section class="footer-top padding-top">
            <div class="row">
                <aside class="col-sm-6 col-lg-3">
                    <h5 class="title text-dark">{{ services.getMenus({"slug" : "first-footer-section-menu"}).getQuery().getOneOrNullResult().getHeader() }}</h5>
                    <ul class="list-unstyled">
                        {% for menuElement in services.getMenus({"slug" : "first-footer-section-menu"}).getQuery().getOneOrNullResult().getMenuElements() %}
                            <li class="mb-1">
                                {% set link = "#0" %}
                                {% if menuElement.customLink %}
                                    {% set link = menuElement.customLink %}
                                {% endif %}
                                {% if menuElement.link %}
                                    {% set link =  menuElement.link %}
                                {% endif %}
                                <a href="{{ link }}">
                                    {% if menuElement.icon %}
                                        <i class="{{ menuElement.icon }} fa-fw"></i>
                                    {% endif %}
                                    {% if menuElement.label %}
                                        {{ menuElement.label }}
                                    {% endif %}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </aside>
                <aside class="col-sm-6 col-lg-3">
                    <h5 class="title text-dark">{{ services.getMenus({"slug" : "second-footer-section-menu"}).getQuery().getOneOrNullResult().getHeader() }}</h5>
                    <ul class="list-unstyled">
                        {% for menuElement in services.getMenus({"slug" : "second-footer-section-menu"}).getQuery().getOneOrNullResult().getMenuElements() %}
                            <li class="mb-1">
                                {% set link = "#0" %}
                                {% if menuElement.customLink %}
                                    {% set link = menuElement.customLink %}
                                {% endif %}
                                {% if menuElement.link %}
                                    {% set link =  menuElement.link %}
                                {% endif %}
                                <a href="{{ link }}">
                                    {% if menuElement.icon %}
                                        <i class="{{ menuElement.icon }} fa-fw"></i>
                                    {% endif %}
                                    {% if menuElement.label %}
                                        {{ menuElement.label }}
                                    {% endif %}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </aside>
                <aside class="col-sm-6 col-lg-3">
                    <h5 class="title text-dark">{{ services.getMenus({"slug" : "third-footer-section-menu"}).getQuery().getOneOrNullResult().getHeader() }}</h5>
                    <ul class="list-unstyled">
                        {% for menuElement in services.getMenus({"slug" : "third-footer-section-menu"}).getQuery().getOneOrNullResult().getMenuElements() %}
                            {% set link = "#0" %}
                            {% if menuElement.customLink %}
                                {% set link = menuElement.customLink %}
                            {% endif %}
                            {% if menuElement.link %}
                                {% set link =  menuElement.link %}
                            {% endif %}
                            {% if link == "footer_categories_section" %}
                                {% for category in services.getCategories({ "featured": true, "limit": 4 }).getQuery().getResult() %}
                                    <li class="mb-1"><a
                                                href="{{ path('events', { category: category.slug }) }}">{{ category.name }}</a>
                                    </li>
                                {% endfor %}
                            {% else %}
                                <li class="mb-1">
                                    <a href="{{ link }}">
                                        {% if menuElement.icon %}
                                            <i class="{{ menuElement.icon }} fa-fw"></i>
                                        {% endif %}
                                        {% if menuElement.label %}
                                            {{ menuElement.label }}
                                        {% endif %}
                                    </a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </aside>
                <aside class="col-sm-6 col-lg-3">
                    <article>
                        {% if services.getSetting("contact_phone") != "" or services.getSetting("contact_email") != "" or services.getSetting("facebook_url") != "" or services.getSetting("instagram_url") != "" or services.getSetting("youtube_url") != "" or services.getSetting("twitter_url") != "" %}
                            <h5 class="title text-dark">{{ "Contact Us" }}</h5>
                        {% endif %}

                        {% if services.getSetting("contact_phone") != "" or services.getSetting("contact_email") != "" %}
                            <p>
                                {#                                {% if services.getSetting("contact_phone") != "" %} #}
                                {#                                    <strong>{{ "Phone" }}: </strong> {{ services.getSetting("contact_phone") }} #}
                                {#                                {% endif %} #}
                                {% if services.getSetting("contact_email") != "" %}
                                    <strong>{{ "Email" }}:</strong> {{ services.getSetting("contact_email") }}
                                {% endif %}

                            </p>
                        {% endif %}

                        {% if services.getSetting("facebook_url") != "" or services.getSetting("instagram_url") != "" or services.getSetting("youtube_url") != "" or services.getSetting("twitter_url") != "" %}
                            <div class="btn-group white">
                                {% if services.getSetting("facebook_url") != "" %}
                                    <a class="btn btn-facebook" title="{{ "Facebook" }}" target="_blank"
                                       href="{{ services.getSetting("facebook_url") }}"><i
                                                class="fab fa-facebook-f fa-fw"></i></a>
                                {% endif %}
                                {% if services.getSetting("instagram_url") != "" %}
                                    <a class="btn btn-instagram" title="{{ "Instagram" }}" target="_blank"
                                       href="{{ services.getSetting("instagram_url") }}"><i
                                                class="fab fa-instagram fa-fw"></i></a>
                                {% endif %}

                                {% if services.getSetting("youtube_url") != "" %}
                                    <a class="btn btn-youtube" title="{{ "Youtube" }}" target="_blank"
                                       href="{{ services.getSetting("youtube_url") }}"><i
                                                class="fab fa-youtube fa-fw"></i></a>
                                {% endif %}

                                {% if services.getSetting("twitter_url") != "" %}
                                    <a class="btn btn-twitter" title="{{ "Twitter" }}" target="_blank"
                                       href="{{ services.getSetting("twitter_url") }}"><i
                                                class="fab fa-twitter fa-fw"></i></a>
                                {% endif %}
                            </div>
                        {% endif %}

                        <div class="clearfix"></div>

                    </article>
                </aside>
            </div>
            <br>
        </section>
        <section class="footer-bottom row">
            <div class="col-sm-12">
                <p class="text-center text-dark">
                    <a href="http://localhost/newunvierse/page/legal-notice" class="text-dark">{{ "Legal Notice" }}</a>
                    <span class="text-gray">|</span>
                    <a href="http://localhost/newunvierse/page/privacy-policy"
                       class="text-dark">{{ "Privacy policy" }}</a>
                    <span class="text-gray">|</span>
                    <a href="http://localhost/newunvierse/page/cookie-policy"
                       class="text-dark">{{ "Cookie policy" }}</a>
                    <span class="text-gray">|</span>
                    <a href="http://localhost/newunvierse/page/community-guidelines"
                       class="text-dark">{{ "Community Guidelines" }}</a>
                    <span class="text-gray">|</span>
                    <a href="http://localhost/newunvierse/page/about-us" class="text-dark">{{ "About us" }}</a>
                    <span class="text-gray">|</span>
                </p>
            </div>
            <div class="col-sm-12">
                <p class="text-dark-50 text-center">
                    The creators of this project are the <a href="https://www.instagram.com/dereeibsociety/">IB
                        Society</a>, <a
                            href="https://www.instagram.com/deree_cyber_club/">Cyber Club</a>, <a
                            href="https://www.instagram.com/all.conditions.graphics/">ACG (All Conditions Graphics)</a>,
                    <a href="https://www.instagram.com/alexandros.kourtis.98/?hl=en">Alexandros Kourtis</a>
                    &copy; {{ "now"|date('Y') }}
                </p>
            </div>
        </section>
    </div>
</footer>