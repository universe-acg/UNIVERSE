<footer class="section-footer border-top-gray mt-4">
    <div class="{{ services.getSetting('app_layout') }}">
        <section class="footer-top padding-top" aria-label="Footer navigation">
            <div class="row">
                {% for slug in ['first-footer-section-menu','second-footer-section-menu','third-footer-section-menu'] %}
                    {% set menu = navigation_menu(slug) %}
                    {% if menu.items|length %}
                        <aside class="col-sm-6 col-lg-3">
                            <h5 class="title text-dark">{{ menu.heading }}</h5>
                            <ul class="list-unstyled">
                                {% for item in menu.items %}
                                    {% if item.kind in ['footer_categories_section','categories_dropdown'] %}
                                        {% for category in services.getCategories({'featured':true,'limit':4}).getQuery().getResult() %}<li class="mb-1"><a href="{{ path('events',{category:category.slug}) }}">{{ category.name }}</a></li>{% endfor %}
                                    {% elseif item.url %}
                                        <li class="mb-1"><a href="{{ item.url }}">{% if item.icon %}<i class="{{ item.icon }} fa-fw" aria-hidden="true"></i>{% endif %} {{ item.label }}</a></li>
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        </aside>
                    {% endif %}
                {% endfor %}
                <aside class="col-sm-6 col-lg-3">
                    <h5 class="title text-dark">{{ 'Contact us'|trans }}</h5>
                    <p><a href="{{ path('contact') }}">{{ 'Contact'|trans }}</a></p>
                    <p><a href="{{ path('help_center') }}">{{ 'Help center'|trans }}</a></p>
                </aside>
            </div>
        </section>
        <section class="footer-bottom row"><div class="col-12"><p class="text-muted">{{ services.getSetting('website_name') }} &copy; {{ 'now'|date('Y') }}</p></div></section>
    </div>
</footer>
