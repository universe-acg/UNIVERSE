{% if user.hasRole('ROLE_ATTENDEE') %}
    {#    <a href="{{ path('profile_attendee', { slug : user.slug }) }}"> #}
    <span
            class="avatar"{% if user.avatarName %}  style="float: left !important; background: url('{{ asset(user.getAvatarPath) }}');" {% endif %} {% if showusernametooltip is defined %}data-toggle="tooltip" title="{{ user.username }}{{ user.stringifypointslevel }}" data-container="body"{% endif %} >
        {% if not user.avatarName %}
            <i class="far fa-user"></i>
        {% endif %}
    </span>
    {#    </a> #}
{% elseif user.hasRole('ROLE_ORGANIZER') %}
    {#    <a href="{{ path('profile_attendee', { slug : user.slug }) }}"> #}
    <span class="avatar"{% if user.organizer.logoName %} style="float: left !important; background: url('{{ asset(user.organizer.getLogoPath) }}');"{% endif %} {% if showusernametooltip is defined %}data-toggle="tooltip" title="{{ user.username }}{{ user.stringifypointslevel }}" data-container="body"{% endif %} >
        {% if not user.organizer.logoName %}
            <i class="far fa-user"></i>
        {% endif %}
    </span>
    {#    </a> #}
{% endif %}
