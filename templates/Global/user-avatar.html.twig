{% if user.hasRole('ROLE_ATTENDEE') %}
    <span class="avatar" style="width: 23px; height: 23px; margin-bottom: 10px;"
          {% if showusernametooltip is defined %}data-toggle="tooltip"
          title="{{ user.getCrossRoleName }}{{ user.stringifypointslevel }}" data-container="body"{% endif %}>
                <img src="{{ user.logoName ? asset(user.getLogoPath) : user.getLogoPlaceholder }}" alt="Profile Image"
                     style="width: 23px; height: 23px; border-radius: 50%; object-fit: cover;">

            </span>
{% elseif user.hasRole('ROLE_ORGANIZER') %}
    <span class="avatar" style="width: 23px; height: 23px; margin-bottom: 10px;"
          {% if showusernametooltip is defined %}data-toggle="tooltip"
          title="{{ user.getCrossRoleName }}{{ user.stringifypointslevel }}" data-container="body"{% endif %}>
                <img src="{{ user.organizer.logoName ? asset(user.organizer.getLogoPath) : user.organizer.getLogoPlaceholder }}"
                     alt="Profile Image"
                     style="width: 23px; height: 23px; border-radius: 50%; object-fit: cover;">

            </span>
{% endif %}
