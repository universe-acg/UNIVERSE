{% if user.hasRole('ROLE_ATTENDEE') %}
    <span class="avatar" {% if showusernametooltip is defined %}data-toggle="tooltip"
          title="{{ user.username }}{{ user.stringifypointslevel }}" data-container="body"{% endif %}>
 <img src="{{ user.logoName ? asset(user.getLogoPath) : user.getLogoPlaceholder }}"
      alt="Profile Image" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;">
    </span>
{% elseif user.hasRole('ROLE_ORGANIZER') %}
    <span class="avatar" {% if showusernametooltip is defined %}data-toggle="tooltip"
          title="{{ user.username }}{{ user.stringifypointslevel }}" data-container="body"{% endif %}>
        <img src="{{ user.organizer.logoName ? asset(user.organizer.getLogoPath) : user.organizer.getLogoPlaceholder }}"
             alt="Profile Image" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;">
    </span>
{% endif %}
