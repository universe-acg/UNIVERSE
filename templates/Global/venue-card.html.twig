<div class="venue-card">
    <img class="img-lazy-load" src="{{ asset('assets/img/loader.gif') }}"
         data-src="{{ venue.secondaryImages|length > 0 ? venue.getImagePath: venue.getImagePlaceholder }}"
         alt="{{ venue.title }}"/>
    <h3>{{ venue.title }}</h3>
    <p>{{ venue.description }}</p>
</div>
