<article class="card public-card">
    <a href="{{ path('venue', {slug: venue.slug}) }}" tabindex="-1" aria-hidden="true">{% include 'Global/public-image.html.twig' with {image: venue.imageName ? venue.getImagePath : null, alt: ''} only %}</a>
    <div class="card-body">
        <h2 class="card-title"><a class="text-dark" href="{{ path('venue', {slug: venue.slug}) }}">{{ venue.title }}</a></h2>
        {% if venue.description %}<p class="mb-0">{{ venue.description|striptags|slice(0, 140) }}{{ venue.description|striptags|length > 140 ? '…' : '' }}</p>{% endif %}
    </div>
</article>
