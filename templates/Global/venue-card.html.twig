{% set runtimeConfig = {"thumbnail": {"size": [500, 250] }} %}

<style>
    .image-container[data-src] {
        object-fit: contain !important;
    }
</style>
<a href="{{ path('venue_details', { slug : venue.slug }) }}" class="text-dark">

    <div class="card card-event pb-2">
        <div class="img-wrap img-lazy-load image-container"
             style="height: 260px;"
             data-src="{{ venue.getImagePath ? asset(venue.getImagePath) : venue.getImagePlaceholder }}">
            <div class="loader"></div>
        </div>
        <div class="info-wrap" style="min-height: initial !important;">
            <div class="event-info">
                <h5>
                    <a href="{{ path('venue_details', { slug : venue.slug }) }}"
                       class="text-dark">{{ venue.title }}</a>
                </h5>
            </div>
            <div class="clearfix"></div>
            {{ venue.description|striptags|slice(0, 150) ~ (venue.description|striptags|length > 150 ? '...' : '') }}
        </div>
    </div>
</a>
