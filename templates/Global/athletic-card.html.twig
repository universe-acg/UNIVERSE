<article class="card public-card">
    <a href="{{ path('athletic_details', {slug: athletic.slug}) }}" tabindex="-1" aria-hidden="true">{% include 'Global/public-image.html.twig' with {image: athletic.imageName ? athletic.getImagePath : null, alt: ''} only %}</a>
    <div class="card-body">
        <h2 class="card-title"><a class="text-dark" href="{{ path('athletic_details', {slug: athletic.slug}) }}">{{ athletic.name }}</a></h2>
        {% if athletic.description %}<p class="mb-0">{{ athletic.description|striptags|slice(0, 140) }}{{ athletic.description|striptags|length > 140 ? '…' : '' }}</p>{% endif %}
    </div>
</article>
