<article class="card public-card">
    <a href="{{ path('organizer', {slug: creator.user.username}) }}" tabindex="-1" aria-hidden="true">{% include 'Global/public-image.html.twig' with {image: creator.logoName ? creator.getLogoPath : null, alt: '', imageClass: 'public-card-image logo-image'} only %}</a>
    <div class="card-body">
        <span class="creator-tier">{{ creator.category }}</span>
        <h2 class="card-title"><a class="text-dark" href="{{ path('organizer', {slug: creator.user.username}) }}">{{ creator.name }}</a></h2>
        <div class="public-card-meta"><span>{{ creator.getEventscount() }} events</span><span>{{ creator.user.getFollowerscount() }} followers</span><span>{{ creator.members|length }} members</span></div>
        {% if creator.user.stringifypointslevel %}<p class="small mt-3 mb-0"><a href="{{ path('leaderboards', {tag: creator.user.stringifypointslevel}) }}">{{ creator.user.stringifypointslevel }}</a></p>{% endif %}
    </div>
</article>
