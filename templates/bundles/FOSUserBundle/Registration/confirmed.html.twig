{% extends 'Global/layout.html.twig' %}
{% block title %}Account created{% endblock %}
{% block content %}
<section class="section-content info-page"><div class="container"><div class="card"><div class="card-body prose">
    <p class="text-success mb-3"><i class="far fa-check-circle fa-2x" aria-hidden="true"></i></p>
    <h1>Your account is ready</h1>
    <p>Your Universe account{% if user.username %}, <strong>{{ user.username }}</strong>,{% endif %} has been created.</p>
    {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
        <a class="btn btn-primary" href="{{ path('dashboard_index') }}">Go to your dashboard</a>
    {% else %}
        <p>Sign in to connect with your campus community.</p>
        <a class="btn btn-primary" href="{{ path('fos_user_security_login') }}">Sign in</a>
    {% endif %}
    <a class="btn btn-outline-primary" href="{{ path('events') }}">Browse events</a>
</div></div></div></section>
{% endblock %}
