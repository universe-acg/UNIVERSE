{% extends "Global/layout.html.twig" %}

{% trans_default_domain 'FOSUserBundle' %}

{% set pagetitle = 'Sign up' %}

{% block title %}{{ pagetitle }}{% endblock %}

{% block content %}
    <style>
        .bg-image {
            background-image: url('https://universe.alexandroskourtis.me/uploads/imgs/register.jpg');
            background-size: cover;
            background-position: center center;
        }
    </style>

    <div class="container-fluid" style="height: 100vh">
        <div class="row no-gutter" style="height: 100vh">
            <!-- The image half -->
            <div class="col-md-8 d-none d-md-flex bg-image"></div>
            <div class="col-md-4 bg-light">
                <div class="login d-flex align-items-center align-content-center justify-content-center">
                    <div class="container">
                        <div class="container d-flex align-items-center justify-content-center vh-100">
                            <div class="row col">
                                <div class="col-lg-12 col-xl-12 mx-auto">
                                    <h3><b>Register as Attendee</b></h3>
                                    <br>
                                    {{ form_start(form, {'method': 'post', 'attr': {'novalidate': 'novalidate'}}) }}
                                    {{ form_errors(form) }}

                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text border-0"> <i
                                                            class="fas fa-user"></i> </span>
                                            </div>
                                            {{ form_widget(form.firstname) }}
                                        </div>
                                        <small class="form-text text-muted">Enter your official first name.</small>
                                        {{ form_errors(form.firstname) }}
                                    </div>

                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text border-0"> <i
                                                            class="fas fa-user"></i> </span>
                                            </div>
                                            {{ form_widget(form.lastname) }}
                                        </div>
                                        <small class="form-text text-muted">Enter your official last name.</small>
                                        {{ form_errors(form.lastname) }}
                                    </div>

                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text border-0"> <i
                                                            class="fas fa-user"></i> </span>
                                            </div>
                                            {{ form_widget(form.studentid) }}
                                        </div>
                                        <small class="form-text text-muted">Enter your student ID issued by the
                                            IRM.</small>
                                        {{ form_errors(form.studentid) }}
                                    </div>

                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text border-0"> <i class="fas fa-user-tag"></i> </span>
                                            </div>
                                            {{ form_widget(form.username) }}
                                        </div>
                                        <small class="form-text text-muted">Choose a username. Usernames are
                                            unique.</small>
                                        {{ form_errors(form.username) }}
                                    </div>

                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text border-0"> <i class="fas fa-envelope"></i> </span>
                                            </div>
                                            {{ form_widget(form.email) }}
                                        </div>
                                        <small class="form-text text-muted">Enter your email address. Make sure you use
                                            an official valid email that only you have access to.</small>
                                        {{ form_errors(form.email) }}
                                    </div>

                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text border-0"> <i
                                                            class="fas fa-user-lock"></i> </span>
                                            </div>
                                            {{ form_widget(form.plainPassword.first) }}
                                        </div>
                                        <small class="form-text text-muted">Enter your password.</small>
                                        {{ form_errors(form.plainPassword.first) }}
                                    </div>

                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text border-0"> <i
                                                            class="fas fa-user-lock"></i> </span>
                                            </div>
                                            {{ form_widget(form.plainPassword.second) }}
                                        </div>
                                        <small class="form-text text-muted">Confirm your password.</small>
                                        {{ form_errors(form.plainPassword.second) }}
                                    </div>

                                    {% if services.getSetting('google_recaptcha_enabled') == "yes" %}
                                        <div class="form-group">
                                            {{ form_widget(form.recaptcha) }}
                                            {{ form_errors(form.recaptcha) }}
                                        </div>
                                    {% endif %}

                                    <div class="mb-3 text-sm text-center">
                                        {#                                        {% if services.getSetting('show_terms_of_service_page') == "yes" %} #}
                                        <span class="text-muted">{{ "By clicking the Sign Up button, I agree to" }}</span>
                                        <a href="{{ path('page', { slug : services.getSetting('terms_of_service_page_slug') }) }}">{{ "Terms of service" }}</a>
                                        {#                                        {% endif %} #}
                                        {#                                        {% if services.getSetting('show_privacy_policy_page') == "yes" %} #}
                                        <span class="text-muted">{{ "and" }}</span>
                                        <a href="{{ path('page', { slug : services.getSetting('privacy_policy_page_slug') }) }}">{{ "Privacy policy" }}</a>
                                        {#                                        {% endif %} #}
                                    </div>

                                    <div class="form-group">
                                        <button type="submit"
                                                class="btn btn-primary btn-block">{{ "Create Account" }}</button>
                                    </div>

                                    <p class="text-center">{{ "Already have an account?" }} <a
                                                href="{{ path('fos_user_security_login') }}">{{ "Sign in" }}</a>
                                    </p>

                                    {{ form_widget(form._token) }}
                                    {{ form_end(form, {'render_rest': false}) }}

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
