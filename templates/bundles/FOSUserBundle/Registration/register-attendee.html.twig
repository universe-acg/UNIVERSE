{% extends 'Global/layout.html.twig' %}
{% form_theme form 'bootstrap_4_layout.html.twig' %}
{% block title %}Register as attendee{% endblock %}
{% block content %}
<div class="auth-layout">
    <div class="auth-art" style="background-image: url('{{ public_image('uploads/imgs/register.jpg') }}')" aria-hidden="true"></div>
    <section class="auth-panel">
        <h1>Register as attendee</h1>
        <p class="text-muted">Discover campus events, connect with clubs, and take part in your community.</p>
        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}
        {% for field in form %}
            {% if field.vars.name not in ['_token', 'recaptcha'] %}
                {{ form_row(field, {label: {'firstname': 'First name', 'lastname': 'Last name', 'studentid': 'Student ID', 'username': 'Username', 'email': 'Email address', 'plainPassword': 'Password', 'organizer': 'Creator profile'}[field.vars.name]|default(field.vars.label)}) }}
            {% endif %}
        {% endfor %}
        {% if services.getSetting('google_recaptcha_enabled') == 'yes' and form.recaptcha is defined %}{{ form_row(form.recaptcha) }}{% endif %}
        <p class="small">By creating an account, you agree to the <a href="{{ path('page', {slug: services.getSetting('terms_of_service_page_slug')}) }}">Terms of service</a> and <a href="{{ path('page', {slug: services.getSetting('privacy_policy_page_slug')}) }}">Privacy policy</a>.</p>
        <button class="btn btn-primary btn-block" type="submit">Create account</button>
        {{ form_widget(form._token) }}
        {{ form_end(form, {render_rest: false}) }}
        <p class="mt-4 mb-2">Already have an account? <a href="{{ path('fos_user_security_login') }}">Sign in</a></p>
        <p class="small mb-0">Organizing campus activities? <a href="{{ path('fos_user_registration_register_organizer') }}">Register as creator</a></p>
    </section>
</div>
{% endblock %}
