{% extends "Global/layout.html.twig" %}

{% trans_default_domain 'FOSUserBundle' %}

{% set pagetitle = 'Sign in' %}

{% block title %}{{ pagetitle }}{% endblock %}

{% block content %}
    <style>
        .bg-image {
            background-image: url('https://universe.alexandroskourtis.me/uploads/imgs/login.jpg');
            background-size: cover;
            background-position: center center;
        }
    </style>
    <div class="container-fluid" style="height: 100vh">
        <div class="row no-gutter" style="height: 100vh">
            <!-- The image half -->
            <div class="col-md-8 d-none d-md-flex bg-image"></div>
            <div class="col-md-4 bg-light">
                <div class="login d-flex align-items-center align-content-center justify-content-center">
                    <div class="container">
                        <div class="container d-flex align-items-center justify-content-center vh-100">
                            <div class="row col">
                                <div class="col-lg-12 col-xl-12 mx-auto">
                                    <h3><b>Log in</b></h3>
                                    <br>
                                    {% if error %}
                                        {% include "Global/message.html.twig" with { message: (error.messageKey|trans(error.messageData, 'security')), type: "danger", icon: "fas fa-exclamation-circle" } %}
                                    {% endif %}
                                    <form action="{{ path("fos_user_security_check") }}" method="post">
                                        {% if csrf_token %}
                                            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}"/>
                                        {% endif %}

                                        <div class="form-group">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                <span class="input-group-text border-0"> <i
                                                            class="fa fa-user"></i> </span>
                                                </div>
                                                <input name="_username" value="{{ last_username }}" class="form-control"
                                                       placeholder="{{ 'Username' }}"
                                                       type="text" autocomplete="username">
                                            </div>
                                            <small class="form-text text-muted">
                                                {{ 'Enter your username.' }}
                                            </small>
                                        </div>

                                        <div class="form-group">
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                <span class="input-group-text border-0"> <i
                                                            class="fa fa-lock"></i> </span>
                                                </div>
                                                <input name="_password" class="form-control"
                                                       placeholder="{{ 'Password' }}"
                                                       type="password" autocomplete="current-password">
                                            </div>
                                            <small class="form-text text-muted">
                                                {{ 'Enter your password.' }}
                                            </small>
                                        </div>
                                        <div class="form-group">
                                            <div class="custom-control custom-checkbox">
                                                <input type="checkbox" class="custom-control-input" id="remember_me"
                                                       name="_remember_me" value="on">
                                                <label class="custom-control-label"
                                                       for="remember_me">{{ 'Remember me' }}</label>
                                            </div>
                                        </div>

                                        {% if app.request.get('_target_path') is not null %}
                                            <input type="hidden" name="_target_path"
                                                   value="{{ app.request.get('_target_path') }}"/>
                                        {% endif %}

                                        <div class="form-group">
                                            <button type="submit" name="_submit"
                                                    class="btn btn-primary btn-block">{{ pagetitle }}</button>
                                        </div>
                                        <p class="text-center"><a
                                                    href="{{ path('fos_user_resetting_request') }}">{{ 'Forgot your password?' }}</a>
                                        </p>
                                        <p class="text-center">{{ 'Not a member yet ?' }} <a
                                                    href="{{ path('fos_user_registration_register_attendee') }}"
                                                    class="text-primary _600">{{ 'Sign up' }}</a></p>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
