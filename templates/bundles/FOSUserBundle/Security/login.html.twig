{% extends "Global/layout.html.twig" %}

{% trans_default_domain 'FOSUserBundle' %}

{% set pagetitle = 'Sign in' %}

{% block title %}{{ pagetitle }}{% endblock %}

{% block content %}
    <section class="section-content padding-y bg-white">
        <div class="{{ services.getSetting("app_layout") }}">
            <div class="row">
                <div class="col-12 col-lg-4 offset-lg-4">
                    <div class="col-12 mb-5">
                        <h1 class="card-title text-center">{{ pagetitle }}</h1>
                        {% if error %}
                            {% include "Global/message.html.twig" with { message: (error.messageKey(error.messageData, 'security')), type: "danger", icon: "fas fa-exclamation-circle" } %}
                        {% endif %}
                        <form action="{{ path("fos_user_security_check") }}" method="post">
                            {% if csrf_token %}
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token }}"/>
                            {% endif %}

                            <div class="form-group">
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text border-0"> <i class="fa fa-user"></i> </span>
                                    </div>
                                    <input name="_username" value="{{ last_username }}" class="form-control"
                                           placeholder="{{ 'Username' }}"
                                           type="text" autocomplete="username">
                                </div>
                                <small class="form-text text-muted">
                                    {{ 'Enter your username.' }}
                                </small>
                            </div>

                            <div class="form-group">
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text border-0"> <i class="fa fa-lock"></i> </span>
                                    </div>
                                    <input name="_password" class="form-control"
                                           placeholder="{{ 'Password' }}"
                                           type="password" autocomplete="current-password">
                                </div>
                                <small class="form-text text-muted">
                                    {{ 'Enter your password.' }}
                                </small>
                            </div>
                            <div class="form-group">
                                <div class="custom-control custom-checkbox">
                                    <input type="checkbox" class="custom-control-input" id="remember_me"
                                           name="_remember_me" value="on">
                                    <label class="custom-control-label"
                                           for="remember_me">{{ 'Remember me' }}</label>
                                </div>
                            </div>

                            {% if app.request.get('_target_path') is not null %}
                                <input type="hidden" name="_target_path" value="{{ app.request.get('_target_path') }}"/>
                            {% endif %}

                            <div class="form-group">
                                <button type="submit" name="_submit"
                                        class="btn btn-primary btn-block">{{ pagetitle }}</button>
                            </div>
                            <p class="text-center"><a
                                        href="{{ path('fos_user_resetting_request') }}">{{ 'Forgot your password?' }}</a>
                            </p>
                            <p class="text-center">{{ 'Not a member yet ?' }} <a
                                        href="{{ path('fos_user_registration_register_attendee') }}"
                                        class="text-primary _600">{{ 'Sign up' }}</a></p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
