{% extends 'Global/layout.html.twig' %}
{% block title %}Sign in{% endblock %}
{% block content %}
<div class="auth-layout">
    <div class="auth-art" style="background-image: url('{{ public_image('images/auth/sign-in-campus-1454360.webp') }}')" aria-hidden="true"></div>
    <section class="auth-panel">
        <h1>Welcome back</h1><p class="text-muted">Sign in to your Universe account.</p>
        {% if error %}<div class="alert alert-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>{% endif %}
        <form action="{{ path('fos_user_security_check') }}" method="post">
            {% if csrf_token %}<input type="hidden" name="_csrf_token" value="{{ csrf_token }}">{% endif %}
            <div class="form-group"><label for="username">Username or email</label><input class="form-control" id="username" name="_username" value="{{ last_username }}" required autocomplete="username"></div>
            <div class="form-group"><label for="password">Password</label><input class="form-control" id="password" name="_password" type="password" required autocomplete="current-password"></div>
            <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
                <div><input type="checkbox" id="remember_me" name="_remember_me" value="on"><label class="d-inline ml-2" for="remember_me">Remember me</label></div>
                <a href="{{ path('fos_user_resetting_request') }}">Forgot password?</a>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Sign in</button>
        </form>
        <p class="mt-4">New to Universe? <a href="{{ path('fos_user_registration_register_attendee') }}">Register as attendee</a> or <a href="{{ path('fos_user_registration_register_organizer') }}">register as creator</a>.</p>
    </section>
</div>
{% endblock %}
