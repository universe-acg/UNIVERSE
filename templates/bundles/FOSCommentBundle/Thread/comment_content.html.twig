{% trans_default_domain 'FOSCommentBundle' %}
<article id="fos_comment_{{ comment.id }}" class="fos_comment_comment_show comment-card comment-depth-{{ depth }}" {% if parent is defined and parent is not null %}data-parent="{{ parent.id }}"{% endif %}>
    <header class="comment-card-header">
        <div class="comment-author">
            {% if comment is fos_comment_in_state(1) %}<span>{{ 'fos_comment_comment_deleted'|trans }}</span>{% else %}
                {% include 'Global/user-avatar.html.twig' with {user: comment.author, showusernametooltip: true} %}
                <strong>{{ comment.authorName }}</strong>
            {% endif %}
        </div>
        <div class="comment-actions">
            <time datetime="{{ comment.createdAt|date('c') }}">{{ comment.createdAt|format_datetime(pattern='d MMM yyyy, HH:mm', locale=app.request.locale, timezone='Europe/Athens') }}</time>
            {% if not (comment is fos_comment_in_state(1)) and fos_comment_can_edit_comment(comment) %}
                <button type="button" data-container="#fos_comment_comment_body_{{ comment.id }}" data-url="{{ url('fos_comment_edit_thread_comment', {id: comment.thread.id, commentId: comment.id}) }}" class="fos_comment_comment_edit_show_form btn btn-link">{{ 'fos_comment_comment_edit'|trans }}</button>
                <button type="button" class="delete-comment-btn btn btn-link text-danger" data-comment-id="{{ comment.id }}" aria-label="Delete comment">Delete</button>
            {% endif %}
        </div>
    </header>
    <div id="fos_comment_comment_body_{{ comment.id }}" class="fos_comment_comment_body comment-body">
        {% if comment is fos_comment_in_state(1) %}<p class="text-muted">This comment was deleted.</p>{% else %}<p>{{ comment.body|nl2br }}</p>{% endif %}
    </div>
    {% if view != 'flat' and not (comment is fos_comment_in_state(1)) and fos_comment_can_comment_thread(comment.thread) %}
        <button type="button" data-url="{{ url('fos_comment_new_thread_comments', {id: comment.thread.id}) }}" data-name="{{ comment.authorName }}" data-parent-id="{{ comment.id }}" class="fos_comment_comment_reply_show_form btn btn-link">{{ 'fos_comment_comment_show_reply'|trans }}</button>
    {% endif %}
    {% if children is defined and children|length %}<div class="fos_comment_comment_replies">{% include '@FOSComment/Thread/comments.html.twig' with {comments: children, depth: depth + 1, parent: comment, view: view} %}</div>{% endif %}
</article>
