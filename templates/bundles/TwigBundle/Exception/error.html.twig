{% set errorMessages = [
    {"message": "This is an intergalactic emergency!", "image": "WARNING-02.png"},
    {"message": "Huston, we have a problem!", "image": "HOUSTN-03.png"},
    {"message": "AAAAAH! This is the part where we blow up!", "image": "BLOWUP-04.png"},
    {"message": "We have a friend in need, and we will not rest until he’s safe in Andy’s room! Now, let’s move out!", "image": "SERVER1.png"},
    {"message": "Aw, Snap!", "image": "AWSNAP-05.png"},
    {"message": "Blip, Blap, Bloobity Bloop!", "image": "500.png"}
] %}

{% set randomError = errorMessages|shuffle|first %}

{% set pagetitle = 'Error' %}

<!DOCTYPE html>
<html>
<head>
    <title>{{ pagetitle }} | {{ services.getSetting("website_name") }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no"/>
    <link rel="shortcut icon" href="{{ absolute_url(asset(services.getAppLayoutSettings.getFaviconPath)) }}"/>
    {{ encore_entry_link_tags('app') }}

    {# i18n lang specific styles #}
    {% if app.request.locale == "fr" %}
        {{ encore_entry_link_tags('app.fr') }}
    {% elseif app.request.locale == "ar" %}
        {{ encore_entry_link_tags('app.ar') }}
    {% endif %}

    {# Application theme #}
    {{ encore_entry_link_tags('app.'~services.getSetting('app_theme')) }}

    {# Custom css code added in the app parameters #}
    {% if services.getSetting('custom_css') != "" and services.getSetting('custom_css') is not null %}
        <style>
            {{ services.getSetting('custom_css')|raw }}
        </style>
    {% endif %}

</head>

<body class="vh-100 {% if app.request.locale == "ar" %}rtl{% endif %}"
      data-currency-ccy="{{ services.getSetting('currency_ccy') }}"
      data-currency-symbol="{{ services.getSetting('currency_symbol') }}"
      data-currency-position="{{ services.getSetting('currency_position') }}" data-timezone="{{ date_timezone }}"
      {% if services.getSetting('show_cookie_policy_bar') == "yes" %}data-cookie-bar-page-link="{{ path('page', { slug : services.getSetting('cookie_policy_page_slug') }) }}" {% endif %} {% if services.getEnv('DEMO_MODE') == "1" %}data-demo-mode="1"{% endif %}>

<div class="container h-100">
    <div class="row align-items-center h-100 align-content-center">
        <div class="col-lg-6 mx-auto">
            <img src="{{ asset('assets/img/illustrations/' ~ randomError.image) }}" class="img-fluid"/>
        </div>
        <div class="col-lg-6 mx-auto">
            <div class="jumbotron">
                <h2>
                    {{ randomError.message }}
                </h2>
                <p>
                    {{ "An error has occured while processing your request" }}
                </p>
                <a href="{{ path('homepage') }}" class="btn btn-primary mt-3">
                    <i class="fas fa-home fa-fw"></i> {{ "return to the homepage" }}
                </a>
                <button type="button" onclick="window.history.back();" class="btn btn-outline-dark mt-3">
                    <i class="fas fa-undo"></i> {{ "Go back" }}
                </button>
            </div>
        </div>
    </div>
</div>

<script id="top-search-result-template" type="text/x-handlebars-template">
    {% include "Global/event-preview-horizontal.html.twig" with { handlebarstemplate: true } %}
</script>

{{ encore_entry_script_tags('app') }}

</body>
</html>