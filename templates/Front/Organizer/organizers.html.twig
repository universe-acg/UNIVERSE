{% extends "Global/layout.html.twig" %}
{% block content %}

    <section class="section-content bg-white padding-y">
        <div class="{{ services.getSetting("app_layout") }}">

            <div class="row">
                <aside class="col-lg-3 order-2 order-lg-1">
                    <div class="card card-filter">
                        <form method="post" action="{{ path('creators') }}">
                            <article class="card-group-item">
                                <header class="card-header">
                                    <a href="#" data-toggle="collapse" data-target="#filter-keyword">
                                        <i class="icon-action fa fa-chevron-down"></i>
                                        <h6 class="title">{{ "Keyword" }}</h6>
                                    </a>
                                </header>
                                <div class="filter-content collapse show" id="filter-keyword">
                                    <div class="card-body">
                                        <input id="keyword" name="keyword" type="text" class="form-control"
                                               value="{{ keyword }}">
                                    </div>
                                </div>
                            </article>
                            {% if services.getSetting("show_category_filter") == "yes" %}
                                <article class="card-group-item">
                                    <header class="card-header">
                                        <a href="#" data-toggle="collapse" data-target="#filter-category">
                                            <i class="icon-action fa fa-chevron-down"></i>
                                            <h6 class="title">{{ "Category" }}</h6>
                                        </a>
                                    </header>
                                    <div class="filter-content collapse show" id="filter-category">
                                        <div class="card-body">
                                            <select id="category" name="category" class="select2" data-sort-options="1">
                                                <option value="">&nbsp;</option>
                                                <option value="all">All
                                                </option>
                                                <option {% if selectedCategory == "Club" %}selected{% endif %}
                                                        value="Clubs">Clubs
                                                </option>
                                                <option {% if  selectedCategory == "Society" %}selected{% endif %}
                                                        value="Societies">Societies
                                                </option>
                                                <option {% if  selectedCategory == "Office" %}selected{% endif %}
                                                        value="Offices">
                                                    Offices
                                                </option>
                                                <option {% if  selectedCategory == "Organization" %}selected{% endif %}
                                                        value="Organizations">Organizations
                                                </option>

                                            </select>
                                        </div>
                                    </div>
                                </article>
                            {% endif %}
                            <div class="row">
                                <div class="col-4">
                                    <article class="card-group-item">
                                        <div class="card-body">
                                            <a href="{{ path('creators') }}" class="btn btn-outline-primary">
                                                {{ "Clear" }}
                                            </a>
                                        </div>
                                    </article>
                                </div>
                                <div class="col-8">
                                    <article class="card-group-item">
                                        <div class="card-body">
                                            <button class="btn btn-outline-primary"><i
                                                        class="fas fa-search"></i> {{ "Search" }}</button>
                                        </div>
                                    </article>
                                </div>
                            </div>
                        </form>
                    </div>
                </aside>


                <div class="col-lg-9 order-1 order-lg-2">
                    {% if creators.getTotalItemCount > 0 %}
                        <div class="row">
                            {% for creator in creators %}
                                <div class="col-12 col-sm-4 col-lg-4 mb-3">
                                    {% include "Global/creator-card.html.twig" with {event: creator.user} %}
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        {% include "Global/message.html.twig" with { type: "info", message: ('No creators found'), icon: "fas fa-exclamation-circle" } %}
                    {% endif %}
                    {{ knp_pagination_render(creators, null, {}, {'align': 'center'}) }}
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {% if services.getSetting("show_map_button") == "yes" and google_maps_api_key != "" %}
        <script async defer
                src="https://maps.googleapis.com/maps/api/js?key={{ google_maps_api_key }}&callback=initMap">
        </script>
        {% include "Global/event-info-box.html.twig" %}
    {% endif %}
{% endblock %}