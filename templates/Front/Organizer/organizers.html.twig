{% extends "Global/layout.html.twig" %}

{% set pagetitle = 'Universe Creators' %}
{% block title %}{{ pagetitle }}{% endblock %}

{% block content %}

    <style>
        .card-event .info-wrap {
            padding-bottom: 4px !important;
        }
    </style>


    {% set navigation = [{"current" : (pagetitle)}] %}
    {#    {% include "Global/navigation.html.twig" with navigation %} #}

    <section class="section-content bg-white padding-y">
        <div class="{{ services.getSetting("app_layout") }}">

            <div class="row" style="">
                <aside class="col-lg-3 order-2 order-lg-1">

                    <div class="box shadow-none bg-gray mb-4">
                        <div class="row flex-wrap flex-md-nowrap">
                            <div class="col-sm-12">
                                <span class="center-lg-y text-muted">{{ "%resultsCount% creator(s) found"  |trans ({'%resultsCount%': creators.getTotalItemCount}) }}</span>
                            </div>
                        </div>
                    </div>

                    <div class="card card-filter filters-section">
                        <form method="get" action="{{ path('creators') }}" id="search-form">
                            <article class="card-group-item filter-item">
                                <header class="card-header">
                                    <a href="#" data-toggle="collapse" data-target="#filter-sortby">
                                        <i class="icon-action fa fa-chevron-down"></i>
                                        <h6 class="title">{{ "Sort By" }}</h6>
                                    </a>
                                </header>
                                <div class="filter-content collapse show" id="filter-sortby">
                                    <div class="card-body">
                                        <select class="form-control" name="sortedby">
                                            <option selected value="all">Sort By</option>
                                            <option value="mostevents"
                                                    {% if app.request.get('sortedby') == 'mostevents' %}selected{% endif %}>
                                                Most Events
                                            </option>
                                            <option value="mostnews"
                                                    {% if app.request.get('sortedby') == 'mostnews' %}selected{% endif %}>
                                                Most News
                                            </option>
                                            <!-- Add more options as needed -->
                                        </select>
                                    </div>
                                </div>
                            </article>
                            <article class="card-group-item filter-item">
                                <header class="card-header">
                                    <a href="#" data-toggle="collapse" data-target="#filter-level">
                                        <i class="icon-action fa fa-chevron-down"></i>
                                        <h6 class="title">{{ "Level" }}</h6>
                                    </a>
                                </header>
                                <div class="filter-content collapse show" id="filter-level">
                                    <div class="card-body">
                                        <select class="form-control" name="level">
                                            <option value="all">All Levels</option>
                                            <option {% if app.request.get('level') == "UniverseNewbie" %}selected{% endif %}
                                                    value="UniverseNewbie">Universe Newbie
                                            </option>
                                            <option {% if app.request.get('level') == "UniverseWannabe" %}selected{% endif %}
                                                    value="UniverseWannabe">Universe Wannabe
                                            </option>
                                            <!-- Add more options as needed -->
                                        </select>
                                    </div>
                                </div>
                            </article>
                            <article class="card-group-item filter-item">
                                <header class="card-header">
                                    <a href="#" data-toggle="collapse" data-target="#filter-category">
                                        <i class="icon-action fa fa-chevron-down"></i>
                                        <h6 class="title">{{ "Category" }}</h6>
                                    </a>
                                </header>
                                <div class="filter-content collapse show" id="filter-category">
                                    <div class="card-body">
                                        <select class="form-control" name="category">
                                            <option value="all">All Categories</option>
                                            <option {% if selectedCategory == "Club" %}selected{% endif %}
                                                    value="Clubs">Clubs
                                            </option>
                                            <option {% if selectedCategory == "Society" %}selected{% endif %}
                                                    value="Societies">Societies
                                            </option>
                                            <!-- Add more options as needed -->
                                        </select>
                                    </div>
                                </div>
                            </article>
                            <article class="card-group-item filter-item">
                                <header class="card-header">
                                    <a href="#" data-toggle="collapse" data-target="#filter-keyword">
                                        <i class="icon-action fa fa-chevron-down"></i>
                                        <h6 class="title">{{ "Keyword" }}</h6>
                                    </a>
                                </header>
                                <div class="filter-content collapse show" id="filter-keyword">
                                    <div class="card-body">
                                        <input type="text" class="form-control" name="keyword"
                                               placeholder="{{ "Search creators" }}"
                                               value="{{ app.request.get('keyword') }}">
                                    </div>
                                </div>
                                <div class="text-left mt-2 mt-sm-0 pl-3 pb-5">
                                    <button type="submit" class="btn btn-primary d-inline-block"><i
                                                class="fas fa-search"></i> Search
                                    </button>
                                    <button type="reset" class="btn btn-primary d-inline-block" onclick="clearForm()"><i
                                                class="fas fa-eraser"></i> Clear
                                    </button>
                                </div>
                            </article>
                        </form>
