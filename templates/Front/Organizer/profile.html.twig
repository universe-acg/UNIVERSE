{% extends "Global/layout.html.twig" %}

{% set pagetitle = organizer.name %}

{% block title %}{{ pagetitle }}{% endblock %}

{% block content %}

    <section class="section-content padding-y bg-white">
        <div class="{{ services.getSetting("app_layout") }}">
            <div class="row">
                <div class="col-12">

                    {% if is_granted('ROLE_ORGANIZER') %}
                        {% if app.user.organizer == organizer %}
                            {% include "Global/message.html.twig" with { type: 'info', icon: 'fas fa-info-circle', message: ('<a href="'~ path('dashboard_organizer_profile') ~'">' ~ 'Click here'  ~ '</a> ' ~ 'to edit your profile') } %}
                        {% endif %}
                    {% endif %}

                    <div class="shadow rounded overflow-hidden">
                        {% if organizer.coverName %}
                            <img class="organizer-profile-cover parallax-window" data-parallax="scroll"
                                 style="height: 350px !important; width: 100% !important; object-fit: cover; object-position: center"
                                 alt="" src="{{ public_image(organizer.getCoverPath) }}">{% endif %}

                        <div class="row">
                            <div class="col-12 col-lg-4" style="background: white !important;">
                                <div class="organizer-profile-sidebar text-center {% if not organizer.coverName %}mt-3 mb-3{% endif %}">

                                                                        <span class="avatar organizer-profile-logo"
                                                                              style="background-size: cover; background: url('{{ public_image(organizer.logoName ? organizer.getLogoPath : null) }}');"></span>

                                    <h1 class="h4 font-weight-bold text-center mt-5">{{ organizer.name }}</h1>
                                    <p class="mb-5">
                                        <a href="{{ path('leaderboards', {tag: organizer.user.stringifypointslevel}) }}"
                                        >{{ organizer.user.stringifypointslevel }}</a>
                                    </p>
                                    {% if organizer.hasSocialMedia %}

                                        <ul class="list-inline mb-0">
                                            {% if organizer.website %}
                                                <li class="list-inline-item">
                                                    <a href="{% if 'http://' not in organizer.website and 'https://' not in organizer.website %}http://{% endif %}{{ organizer.website }}"
                                                       class="display-inline-block mr-3" target="_blank"><i
                                                                class="icon fas fa-globe fa-lg fa-fw"></i></a>
                                                </li>
                                            {% endif %}
                                            {% if organizer.email %}
                                                <li class="list-inline-item">
                                                    <a href="mailto:{{ organizer.email }}"
                                                       class="display-inline-block mr-3" target="_blank"><i
                                                                class="icon fas fa-at fa-lg fa-fw"></i></a>
                                                </li>
                                            {% endif %}
                                            {% if organizer.phone %}
                                                <li class="list-inline-item">
                                                    <a href="tel:{{ organizer.phone }}"
                                                       class="display-inline-block mr-3"><i
                                                                class="icon fas fa-phone fa-lg fa-fw"></i></a>
                                                </li>
                                            {% endif %}
                                            {% if organizer.facebook %}
                                                <li class="list-inline-item">
                                                    <a href="{% if 'http://' not in organizer.facebook and 'https://' not in organizer.facebook %}http://{% endif %}{{ organizer.facebook }}"
                                                       class="display-inline-block mr-3" target="_blank"><i
                                                                class="icon fab fa-facebook-f fa-lg fa-fw"></i></a>
                                                </li>
                                            {% endif %}
                                            {% if organizer.twitter %}
                                                <li class="list-inline-item">
                                                    <a href="{% if 'http://' not in organizer.twitter and 'https://' not in organizer.twitter %}http://{% endif %}{{ organizer.twitter }}"
                                                       class="display-inline-block mr-3" target="_blank"><i
                                                                class="icon fab fa-twitter fa-lg fa-fw"></i></a>
                                                </li>
                                            {% endif %}
                                            {% if organizer.tiktok %}
                                                <a href="{% if 'http://' not in organizer.tiktok and 'https://' not in organizer.tiktok %}http://{% endif %}{{ organizer.tiktok }}"
                                                   class="display-inline-block mr-3" target="_blank"><i
                                                            class="icon fab fa-google-plus fa-lg fa-fw"></i></a>
                                            {% endif %}
                                            {% if organizer.instagram %}
                                                <a href="{% if 'http://' not in organizer.instagram and 'https://' not in organizer.instagram %}http://{% endif %}{{ organizer.instagram }}"
                                                   class="display-inline-block mr-3" target="_blank"><i
                                                            class="icon fab fa-instagram fa-lg fa-fw"></i></a>
                                            {% endif %}
                                            {% if organizer.linkedin %}
                                                <a href="{% if 'http://' not in organizer.linkedin and 'https://' not in organizer.linkedin %}http://{% endif %}{{ organizer.linkedin }}"
                                                   class="display-inline-block mr-3" target="_blank"><i
                                                            class="icon fab fa-linkedin fa-lg fa-fw"></i></a>
                                            {% endif %}
                                        </ul>
                                    {% endif %}

                                    {% if organizer.description %}
                                        <div class="py-4 px-4 text-muted line-height-2 readmore"
                                             data-collapsed-height="150" data-height-margin="20">
                                            {{ organizer.description|raw|nl2br }}
                                        </div>
                                    {% endif %}

                                    {% if organizer.user.showfollowers and organizer.user.followedby|length %}
                                        <div class="py-4 px-4">
                                            <h4 class="mb-2"><i
                                                        class="fas fa-user-plus mr-1"></i> {{ "Followers" }}
                                            </h4>
                                            <div class="card border-0 card-body overflow-auto text-nowrap">
                                                <div class="avatar-list py-4">
                                                    {% for user in organizer.user.followedby %}
                                                        {% if user.id != organizer.user.id %}
                                                            {% include "Global/user-avatar-events.html.twig" with { user: user, showusernametooltip: true } %}
                                                        {% endif %}
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="col-12 col-lg-8 bg-light">

                                {% set publishedeventscount = services.getEvents({"count": true, elapsed: "all", organizer: organizer.slug}) | length %}
                                <div style="display: block">

                                    <div class="p-4 d-flex justify-content-end text-center" style="float: right">
                                        <ul class="list-inline mb-0">
                                            {% if organizer.categories|length %}
                                                {% for category in organizer.categories %}
                                                    <li class="list-inline-item mr-3">
                                                        <h5 class="font-weight-bold mb-0 d-block">
                                                            <i class="{{ category.icon }}"></i>
                                                        </h5>
                                                        <small class="text-muted">
                                                            {{ category.name }}
                                                        </small>
                                                    </li>
                                                {% endfor %}

                                            {% endif %}
                                            <li class="list-inline-item mr-3">
                                                <h5 class="font-weight-bold mb-0 d-block">{{ publishedeventscount }}</h5>
                                                <small class="text-muted"> <i
                                                            class="fas fa-calendar-alt fa-fw mr-1"></i>{{ "Events" }}
                                                </small>
                                            </li>
                                            <li class="list-inline-item">
                                                <h5 class="font-weight-bold mb-0 d-block">{{ news | length }}</h5>
                                                <small class="text-muted"> <i
                                                            class="fas fa-newspaper mr-1"></i>{{ "Announcements" }}
                                                </small>
                                            </li>
                                            <li class="list-inline-item">
                                                <h5 class="font-weight-bold mb-0 d-block">{{ organizer.user.followedby|length }}</h5>
                                                <small class="text-muted"> <i
                                                            class="fas fa-users mr-1"></i>{{ "Followers" }}
                                                </small>
                                            </li>
                                            <li class="list-inline-item">
                                                <h5 class="font-weight-bold mb-0 d-block">{{ organizer.members|length }}</h5>
                                                <small class="text-muted"> <i
                                                            class="fas fa-users mr-1"></i>{{ "Members" }}
                                                </small>
                                            </li>

                                            <li class="list-inline-item">
                                                {% if not is_granted('IS_AUTHENTICATED_REMEMBERED') or is_granted('ROLE_ATTENDEE') %}
                                                    {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                                                        {% if organizer.user.isFollowedBy(app.user) %}
                                                            <button class="organizer-unfollow btn btn-outline-primary btn-sm btn-block"
                                                                    data-target="{{ path('app_dashboard_attendee_following_remove', { id : organizer.user.id }) }}">
                                                                <i class="fas fa-bell-slash"></i>
                                                            </button>
                                                        {% else %}
                                                            <button class="organizer-follow btn btn-outline-primary btn-sm btn-block"
                                                                    data-target="{{ path('app_dashboard_attendee_following_add', { id : organizer.user.id }) }}"
                                                            >
                                                                <i class="fas fa-bell"></i>
                                                            </button>
                                                        {% endif %}
                                                    {% else %}
                                                        <a href="{{ path('fos_user_security_login')~'?_target_path='~app.request.getPathInfo }}"
                                                           class="btn btn-outline-primary btn-sm btn-block"><i
                                                                    class="fas fa-bell"></i></a>
                                                    {% endif %}
                                                {% endif %}
                                            </li>

                                            <li class="list-inline-item">
                                                {% if not is_granted('IS_AUTHENTICATED_REMEMBERED') or is_granted('ROLE_ATTENDEE') %}
                                                    {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                                                        {% if managementClubsSocietiesService.isaccepted(app.user.id, organizer.id) %}
                                                            <button class="organizer-leave btn btn-outline-primary btn-sm btn-block"
                                                                    data-target="{{ path('app_dashboard_attendee_join_leave', { organizerid: organizer.id, attendeeid : app.user.id }) }}">
                                                                <i class="fas fa-folder-minus"></i> {{ "Leave" }}
                                                            </button>
                                                        {% elseif managementClubsSocietiesService.isrejected(app.user.id, organizer.id) %}
                                                            <button class="organizer-join btn btn-outline-primary btn-sm btn-block"
                                                                    data-target="{{ path('app_dashboard_attendee_join_add', { organizerid: organizer.id, attendeeid : app.user.id }) }}">
                                                                <i class="fas fa-folder-plus"></i> {{ "Join" }}
                                                            </button>
                                                        {% elseif managementClubsSocietiesService.ispending(app.user.id, organizer.id) %}
                                                            {% if initiatedbyme %}
                                                                <button class="organizer-cancel btn btn-outline-primary btn-sm btn-block"
                                                                        data-target="{{ path('app_dashboard_attendee_join_cancel', { attendeeid : app.user.id, organizerid: organizer.id}) }}">
                                                                    <i class="fas fa-folder-minus"></i> {{ "Cancel pending request" }}
                                                                </button>
                                                            {% else %}
                                                                <div style="display: flex; justify-content: center; align-items: center; align-content: center">
                                                                    <button style="float: left; margin-top: 0 !important;"
                                                                            class="organizer-reject btn btn-outline-primary btn-sm btn-block mr-2 ml-2"
                                                                            data-target="{{ path('app_dashboard_attendee_join_reject', {  attendeeid : app.user.id, organizerid: organizer.id }) }}">
                                                                        <i class="fas fa-folder-minus"></i> {{ "Reject" }}
                                                                    </button>

                                                                    <button style="float: left; margin-top: 0 !important;"
                                                                            class="organizer-accept btn btn-outline-primary btn-sm btn-block"
                                                                            data-target="{{ path('app_dashboard_attendee_join_accept_xml', { attendeeid : app.user.id, organizerid: organizer.id  }) }}">
                                                                        <i class="fas fa-folder-minus"></i> {{ "Accept" }}
                                                                    </button>
                                                                </div>
                                                            {% endif %}

                                                        {% else %}
                                                            <button class="organizer-join btn btn-outline-primary btn-sm btn-block"
                                                                    data-target="{{ path('app_dashboard_attendee_join_add', { organizerid: organizer.id, attendeeid : app.user.id }) }}">
                                                                <i class="fas fa-folder-plus"></i> {{ "Join" }}
                                                            </button>
                                                        {% endif %}
                                                    {% else %}
                                                        <a href="{{ path('fos_user_security_login')~'?_target_path='~app.request.getPathInfo }}"
                                                           class="btn btn-outline-primary btn-sm btn-block"><i
                                                                    class="fas fa-folder-plus"></i> {{ "Join" }}</a>
                                                    {% endif %}
                                                {% endif %}
                                            </li>

                                        </ul>
                                    </div>
                                </div>
                                <div class="clearfix"></div>
                                {% set onsaleeventscount = currentevnts | length %}
                                {% set pasteventscount = pastevents | length %}
                                {% set newscount = news | length %}
                                {% set listingscount = listings | length %}
                                {% set gbcount = gb | length %}

                                <div class="py-4 px-4">
                                    <ul class="nav nav-pills mb-3 profile-tabs" role="tablist" aria-label="Creator activity">
                                        <li class="nav-item">
                                            <a class="nav-link active"
                                               href="#organizer-onsale-events" role="tab" id="organizer-onsale-events-tab"
                                               aria-controls="organizer-onsale-events"
                                               aria-selected="true">{{ "Active events" }}
                                                ({{ onsaleeventscount }})</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link"
                                               href="#organizer-past-events" role="tab" id="organizer-past-events-tab"
                                               aria-controls="organizer-past-events"
                                               aria-selected="true">{{ "Past events" }}
                                                ({{ pasteventscount }})</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link"
                                               href="#organizer-news" role="tab" id="organizer-news-tab"
                                               aria-controls="organizer-news"
                                               aria-selected="true">{{ "Announcements" }}
                                                ({{ newscount }})</a>
                                        </li>

                                        {% if gb|length> 0 %}
                                            <li class="nav-item">
                                                <a class="nav-link"
                                                   href="#organizer-gb" role="tab" id="organizer-gb-tab"
                                                   aria-controls="organizer-gb"
                                                   aria-selected="true">{{ "Governing Body Members" }}
                                                    ({{ gbcount }})</a>
                                            </li>
                                        {% endif %}
                                    </ul>

                                    <div class="tab-content">
                                        <div class="tab-pane fade show active" id="organizer-onsale-events"
                                             role="tabpanel" aria-labelledby="organizer-onsale-events-tab">
                                            {% if onsaleeventscount > 0 %}
                                                <div class="profile-card-grid">
                                                    {% for event in currentevnts %}
                                                        {% include "Global/profile/profile-event-card.html.twig" with {event: event} %}
                                                    {% endfor %}
                                                </div>
                                            {% else %}
                                                {% include "Global/message.html.twig" with { type: "info", message: ('No active events for now') } %}
                                            {% endif %}
                                        </div>
                                        <div class="tab-pane fade" id="organizer-past-events"
                                             role="tabpanel" aria-labelledby="organizer-past-events-tab">
                                            {% if pasteventscount > 0 %}
                                                <div class="profile-card-grid">
                                                    {% for event in pastevents %}
                                                        {% include "Global/profile/profile-event-card.html.twig" with {event: event} %}
                                                    {% endfor %}
                                                </div>
                                            {% else %}
                                                {% include "Global/message.html.twig" with { type: "info", message: ('No past events') } %}
                                            {% endif %}
                                        </div>
                                        <div class="tab-pane fade" id="organizer-news"
                                             role="tabpanel" aria-labelledby="organizer-news-tab">
                                            {% if newscount > 0 %}
                                                <div class="profile-card-grid">
                                                    {% for new in news %}
                                                        {% include "Global/profile/profile-new-card.html.twig" with {new: new} %}
                                                    {% endfor %}
                                                </div>
                                            {% else %}
                                                {% include "Global/message.html.twig" with { type: "info", message: ('No announcements published yet') } %}
                                            {% endif %}
                                        </div>

                                        <div class="tab-pane fade" id="organizer-gb"
                                             role="tabpanel" aria-labelledby="organizer-gb-tab">
                                            {% if gbcount > 0 %}
                                                <div class="profile-card-grid">
                                                    {% for gbmember in gb %}
                                                        {% include "Global/gb-card.html.twig" with {gbmember: gbmember} %}
                                                    {% endfor %}
                                                </div>
                                            {% else %}
                                                {% include "Global/message.html.twig" with { type: "info", message: ('No listings published yet') } %}
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>

                                {% if organizer.youtubeurl %}
                                    <div class="py-4 px-4">
                                        <h4 class="mb-2"><i class="fab fa-youtube-square mr-1"></i> {{ "Video" }}
                                        </h4>
                                        <iframe width="100%" height="400"
                                                src="https://www.youtube.com/embed/{{ organizer.youtubeurl|split('=')[1] }}"
                                                frameborder="0"
                                                allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
                                                allowfullscreen></iframe>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

{% endblock %}

{% block javascripts %}
    {% if google_maps_api_key != "" %}
        {{ encore_entry_script_tags('organizerprofile') }}
        <script async defer
                src="https://maps.googleapis.com/maps/api/js?key={{ google_maps_api_key }}&callback=initMap">
        </script>

        {% include "Global/organizer-info-box.html.twig" %}
    {% endif %}

    <style>
        .parallax-mirror {
            position: absolute !important;
            display: none;
        }
    </style>

{% endblock %}
