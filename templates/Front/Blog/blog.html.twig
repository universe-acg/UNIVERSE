{% extends "Global/layout.html.twig" %}

{% set pagetitle = 'News' %}

{% block title %}{{ pagetitle }}{% endblock %}

{% block content %}

    {% set navigation = [{"current" : (pagetitle)}] %}
    {% include "Global/navigation.html.twig" with navigation %}

    <section class="section-content padding-y bg-white">
        <div class="{{ services.getSetting("app_layout") }}">

            <div class="box shadow-none bg-gray mb-4">
                <div class="row flex-wrap flex-md-nowrap"
                     style="align-items: center;">
                    <div class="col-sm-12 col-md-2 mb-3 mb-lg-0">
                        <span class="center-lg-y text-muted">{{ "%resultsCount% post(s) found"  |trans ({'%resultsCount%': blogposts.getTotalItemCount}) }}</span>
                    </div>

                    <div class="col-sm-12 col-md-10 offset-lg-1 text-right">
                        <form method="get" action="{{ path('blog') }}" id="search-form">
                            <div class="d-flex flex-wrap w-100">
                                <!-- Use d-flex and flex-wrap to control the wrapping on mobile -->
                                <div class="col-md-2 col-sm-6">
                                    <select class="form-control bg-white col-12" name="tag">
                                        <option value="">Tags</option>
                                        {% for tag in tags %}
                                            <option value="{{ tag }}"
                                                    {% if tag == app.request.get('tag') %}selected{% endif %}>{{ tag }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <select class="form-control bg-white col-12" name="category">
                                        <option value="">All Categories</option>
                                        {% for category in blogpostcategories %}
                                            <option value="{{ category.slug }}"
                                                    {% if category.slug == app.request.get('category') %}selected{% endif %}>{{ category.name }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-4 col-sm-12">
                                    <input type="text" class="form-control bg-white col-12" name="keyword"
                                           placeholder="{{ "Search news/blog posts" }}"
                                           value="{{ app.request.get('keyword') }}"/>
                                </div>
                                <div class="col-md-2 col-sm-12 text-left mt-2 mt-sm-0">
                                    <button type="submit" class="btn btn-primary d-inline-block"><i
                                                class="fas fa-search"></i></button>
                                    <button type="reset" class="btn btn-primary d-inline-block" onclick="clearForm()"><i
                                                class="fas fa-eraser"></i>
                                    </button>
                                </div>
                            </div>
                        </form>

                    </div>
                </div>
            </div>

            <div class="row">
                {% for blogpost in blogposts %}
                    <div class="col-12 col-sm-6 col-lg-3">
                        {% include "Global/blog-card.html.twig" with {blogpost: blogpost, thumbnailsize: [397, 397], showdate: 1} %}
                    </div>
                {% endfor %}
            </div>

            {{ knp_pagination_render(blogposts, null, {}, {'align': 'center'}) }}

        </div>
    </section>

    <script>
        function clearForm() {
            window.location.href = "https://universeacg.xyz/blog";
        }
    </script>
{% endblock %}