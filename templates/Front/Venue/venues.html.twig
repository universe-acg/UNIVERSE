{% extends "Global/layout.html.twig" %}

{% set pagetitle = 'Venues' %}

{% block title %}{{ pagetitle }}{% endblock %}

{% block content %}
{% include "Global/navigation.html.twig" with {navigation: [{current: "Venues"}]} %}

    <section class="section-content padding-y bg-white">
        <div class="{{ services.getSetting("app_layout") }}">

            <div class="catalog-layout">
                <aside class="catalog-filters" id="catalog-filters">{% include 'Global/catalogue-filters.html.twig' with {route: 'venues', noun: 'venues', total: venues.getTotalItemCount} %}</aside>
                <div class="catalog-results">
                    {% if venues.getTotalItemCount > 0 %}
                        <div class="catalog-grid">
                            {% for venue in venues %}
                                <div class="col-12 col-sm-4 col-lg-3 mb-3">
                                    {% include "Global/venue-card.html.twig" with {venue: venue} %}
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        {% include "Global/message.html.twig" with { type: "info", message: ('No venues found'), icon: "fas fa-exclamation-circle" } %}
                    {% endif %}
                    {{ knp_pagination_render(venues, 'Global/pagination.html.twig', {}, {'align': 'center'}) }}
                </div>

            </div>
        </div>
    </section>

{% endblock %}

{% block javascripts %}
{% endblock %}
