{% extends "Global/layout.html.twig" %}

 {% set pagetitle = venue.title %}

 {% block title %}{{ pagetitle }}{% endblock %}

 {% block meta_dynamic_seo %}
 {% endblock %}

 {% block content %}
     <style>
         .mycontainer {
             max-width: 75vw !important;
         }
     </style>
     {#     {% set navigation = [{"venues": "venues", "current" : (pagetitle)}] %} #}
     {#     {% include "Global/navigation.html.twig" with navigation %} #}

     <div class="row no-gutters">
         <div class="col-12 p-0">
             <section class="section-main">
                 <div class="owl-init slider-main owl-carousel" data-items="1" data-dots="false" data-nav="false"
                      data-autoplay="false">
                     <div class="item-slide d-flex" style="height: 600px; width: 100% !important;">
                         <img class="slider-img justify-content-center align-self-center"
                              style="object-fit: cover; width: 100% !important;"
                              src="{{ asset(venue.getImagePath  ? asset(venue.getImagePath) : venue.getImagePlaceholder ) }}"
                              alt="{{ venue.title }}"/>
                     </div>
                 </div>
             </section>
         </div>
     </div>
     <section class="section-content padding-y bg-white mycontainer mx-auto">
         <div class="{{ services.getSetting("app_layout") }}">
             <div class="card">
                 <div class="row">
                     <div class="col-12 col-lg-8 order-1 order-lg-0">
                         <div class="card-body">
                             <h1 class="card-title b d-none d-lg-block">{{ venue.title }}</h1>
                             {% if venue.description %}
                                 <dl class="mt-5 venue-description">
                                     <dt class="text-muted">{{ "Description" }}</dt>
                                     <dd class="line-height-2 readmore" data-collapsed-height="500"
                                         data-height-margin="20">
                                         {{ venue.description|raw|nl2br }}
                                     </dd>
                                 </dl>
                             {% endif %}
                             {% if venue.amenities|length > 0 %}
                                 <dl class="dlist-align dlist-border clearfix mb-0">
                                     <dt>{{ "Amenities" }}</dt>
                                     <dd class="pb-0">
                                         <ul class="fa-ul list-lg list-inline ml-0">
                                             {% for amenity in venue.amenities %}
                                                 <li class="list-inline-item text-muted mr-3 mb-3"><i
                                                             class="icon {{ amenity.icon }} fa-fw"></i>
                                                     <span>{{ amenity.name }}</span></li>
                                             {% endfor %}
                                         </ul>
                                     </dd>
                                 </dl>
                             {% endif %}
                             {% if venue.getSecondaryImages|length > 0 %}
                                 <dl class="mt-5">
                                     <dt class="text-muted">{{ "Photos" }}</dt>
                                     <dd class="mr-0">
                                         <div class="gallery photos-gallery clearfix">
                                             {% for image in venue.getSecondaryImages %}
                                                 <figure>
                                                     <a href="{{ asset(image.getImagePath) }}"
                                                        data-size="{{ image.imageDimensions is not empty ? image.imageDimensions[0] ~ 'x' ~ image.imageDimensions[1] : 'N/A' }}
                                                        "
                                                     >
                                                         <img class="img-lazy-load img-thumbnail img-100-100"
                                                              src="{{ asset('assets/img/loader.gif') }}"
                                                              data-src="{{ asset(image.getImagePath  ? asset(image.getImagePath) : image.getImagePlaceholder ) }}"
                                                              alt="{{ venue.title }}"/>
                                                     </a>
                                                 </figure>
                                             {% endfor %}

                                         </div>
                                     </dd>
                                 </dl>
                             {% endif %}
                             <h3 class="card-title b d-none d-lg-block">Events that took place here</h3>
                         </div>
                     </div>

                     <div class="col-lg-12 order-1 order-lg-2 mt-2 mt-md-0 ">
                         {% if events.getTotalItemCount > 0 %}
                             <div class="row px-4" style="overflow-y: scroll">
                                 {% for event in events %}
                                     <div class="col-12 col-sm-6 col-lg-3 mb-3 p-3">
                                         {% include "Global/event-card.html.twig" with {event: event, past: event.isPassed} %}
                                     </div>
                                 {% endfor %}
                             </div>
                         {% else %}
                             <div class="p-3">
                                 {% include "Global/message.html.twig" with { type: "info", message: ('No events found'), icon: "fas fa-exclamation-circle" } %}
                             </div>
                         {% endif %}
                         {{ knp_pagination_render(events, null, {}, {'align': 'center'}) }}
                     </div>
                 </div>
             </div>
         </div>
     </section>

 {% endblock %}

 {% block javascripts %}
 {% endblock %}