{% extends 'Global/layout.html.twig' %}
{% form_theme form 'bootstrap_4_layout.html.twig' %}
{% block title %}Contact{% endblock %}
{% block content %}
{% include 'Global/navigation.html.twig' with {navigation: [{current: 'Contact'}]} %}
<section class="section-content padding-y"><div class="container">
    <div class="contact-layout">
        <div>
            <h2>How can we help?</h2>
            <p>Find answers about your account, campus events, clubs, and reservations in the <a href="{{ path('help_center') }}">Help Center</a>.</p>
            <div class="contact-details mt-4">
                <h2>Get in touch</h2>
                {% if services.getSetting('contact_email') %}<p><a href="mailto:{{ services.getSetting('contact_email') }}">{{ services.getSetting('contact_email') }}</a></p>{% endif %}
                {% if services.getSetting('contact_phone') %}<p><a href="tel:{{ services.getSetting('contact_phone') }}">{{ services.getSetting('contact_phone') }}</a></p>{% endif %}
                {% if services.getSetting('contact_address') %}<p>{{ services.getSetting('contact_address') }}</p>{% endif %}
                <p class="mb-0">For official College services or urgent campus matters, contact the relevant ACG department directly. This portal’s demo activity does not represent official bookings or applications.</p>
            </div>
            {% if services.getSetting('contact_email') %}
                <h2 class="mt-4">Send a message</h2>
                {{ form_start(form) }}{{ form_errors(form) }}{{ form_widget(form) }}{{ form_end(form) }}
            {% endif %}
        </div>
        <div>
            <h2>Frequently asked questions</h2>
            <ul class="contact-faqs">
            {% for article in services.getHelpCenterArticles({featured: true, limit: 12, order: 'title', sort: 'ASC'}).getQuery().getResult() %}
                <li><a href="{{ path('help_center_article', {slug: article.slug}) }}">{{ article.title }}</a></li>
            {% endfor %}
            </ul>
            <a class="btn btn-outline-primary mt-4" href="{{ path('help_center') }}">Browse the Help Center</a>
        </div>
    </div>
</div></section>
{% endblock %}
