{% extends "Global/layout.html.twig" %}
{% block title %}Leaderboards{% endblock %}

{% block content %}
    <style>
        .mylist li {
            cursor: pointer;
        }

        .outer-image {
            position: relative;
            display: inline-block;
            z-index: 10;
        }

        .outer-image img {
            width: 100px;
            height: 100px;
        }

        .inner-image {
            position: absolute;
            top: 50%;
            left: 52%;
            height: 100%;
            transform: translate(-50%, -45%);
            width: 100%;
            padding: 17px;
            z-index: -1;
        }

        .inner-image img {
            width: 90%;
            height: 90%;
            border-radius: 50%;
        }

        /* Add a class for paused animation */
        .paused-animation {
            animation-play-state: paused !important;
        }

        /* Keyframe animations for dancing effect */
        @keyframes dance1 {
            0%, 100% {
                transform: translate(0, 0);
            }
            25% {
                transform: translate(5px, -5px);
            }
            50% {
                transform: translate(0, 0);
            }
            75% {
                transform: translate(-5px, 5px);
            }
        }

        @keyframes dance2 {
            0%, 100% {
                transform: translate(0, 0);
            }
            25% {
                transform: translate(5px, 5px);
            }
            50% {
                transform: translate(0, 0);
            }
            75% {
                transform: translate(-5px, -5px);
            }
        }

        @keyframes dance3 {
            0%, 100% {
                transform: translate(0, 0);
            }
            25% {
                transform: translate(-5px, -5px);
            }
            50% {
                transform: translate(0, 0);
            }
            75% {
                transform: translate(5px, 5px);
            }
        }

        /* Add dancing animation to the first row */
        .dancing-rowc {
            animation: dance1 2s infinite; /* Start with the first dance pattern */
            cursor: pointer !important;
        }

        .dancing-row {
            animation: dance1 2s infinite; /* Start with the first dance pattern */
            cursor: pointer !important;
        }

        /* Style for table th and td */
        table {
            width: 100%; /* Ensure the table takes up the full width of its container */
        }

        table th, table td {
            text-align: center; /* Center-align text within th and td */
        }

        /* If you want different text alignment for specific columns, you can use nth-child selectors */
        /* Example: Align the first column (index 1) to the left */
        table th:nth-child(1), table td:nth-child(1) {
            text-align: center;
        }

        /* Example: Align the second column (index 2) to the right */
        table th:nth-child(2), table td:nth-child(2) {
            text-align: right;
        }

        #attendees-content {
            display: none;
        }

        .styled-button {
            background-color: #2E7599; /* Purple background color */
            color: #FFFFFF; /* White text color */
            border: none;
            border-radius: 10px; /* Adds a curved shape */
            padding: 5px 11px;
            margin: 5px;
            cursor: pointer;
            font-size: 16px;
        }

        /* Style for the circular image container */
        .circular-image-container {
            position: relative;
            width: 100px; /* Set your desired size for the circular image container */
            height: 100px; /* Set your desired size for the circular image container */
            border-radius: 50%; /* Makes the container round */
        }

        /* Style for the circular image */
        .circular-image {
            display: block;
            width: 90%;
            height: 90%;
            object-fit: cover !important; /* Adjust this for image positioning */
            border-radius: 50%; /* Makes the image itself round */
        }

        /* Style for the surrounding image */
        .surrounding-image {
            position: absolute;
            top: 0;
            left: 0;
            width: 110%; /* Set your desired size for the surrounding image */
            height: 110%; /* Set your desired size for the surrounding image */
            object-fit: contain !important; /* Adjust this for image positioning */
        }

        .bottom-right-image {
            position: absolute;
            bottom: 0;
            right: 0;
            width: 40px; /* Set your desired size for the bottom-right image */
            height: 40px; /* Set your desired size for the bottom-right image */
            object-fit: contain; /* Adjust this for image positioning */
        }

    </style>

    <section class="section-content bg-white padding-y">
        <div class="main {{ services.getSetting("app_layout") }}">
            <div class="tab-buttons"
                 style="display: flex; justify-content: start; align-items: center; align-content: center">
                <button type="button" id="creators-tab" class="styled-button btn btn-primary d-inline-block">Creators</button>
                <button type="button" id="attendees-tab" class="styled-button btn btn-primary d-inline-block">
                    Attendees
                </button>
                <div class="input-icon" style="float: left;  width: 100%">
                    <input name="keyword"
                           style="float: left; margin: 5px; height: 36px; border-radius: 10px; width: 100%"
                           class="form-control top-search"
                           placeholder="{{ "Filter users" }}"
                           type="search" aria-label="Filter leaderboard" id="filter-input">
                </div>
            </div>

            <ul style="list-style-type:none; padding: 0; margin-top: 10px" class="mylist">
                <li style="display: inline;"><a id="show-all-button"
                                                class="btn btn-sm btn-default mr-2 mb-2 mt-2 filter-tag"
                                                data-points-level="all">All</a></li>
                <li class="creators-tags" style="display: inline;"><a class="btn btn-sm btn-default mr-2 mb-2 mt-2"
                                                                      id="learnerofone">Learner of One</a></li>
                <li class="creators-tags" style="display: inline;"><a class="btn btn-sm btn-default mr-2 mb-2 mt-2"
                                                                      id="learnermany">Learner of Many Things</a></li>
                <li class="creators-tags" style="display: inline;"><a class="btn btn-sm btn-default mr-2 mb-2 mt-2"
                                                                      id="masterofone">Master of One</a></li>
                <li class="creators-tags" style="display: inline;"><a class="btn btn-sm btn-default mr-2 mb-2 mt-2"
                                                                      id="masterofmost">Master of Most</a></li>
                <li class="creators-tags" style="display: inline;">
                    <a class="btn btn-sm btn-default mr-2 mb-2 mt-2" id="masteroftheuniverse">Master of the Universe</a>
                </li>
                <li class="attendees-tags" style="display: inline;"><a class="btn btn-sm btn-default mr-2 mb-2 mt-2"
                                                                       id="smurfantastic">Smurfantastic</a>
                </li>
                <li class="attendees-tags" style="display: inline;"><a class="btn btn-sm btn-default mr-2 mb-2 mt-2"
                                                                       id="wubba">Wubba Lubba Dub Dub!</a></li>
                <li class="attendees-tags" style="display: inline;"><a class="btn btn-sm btn-default mr-2 mb-2 mt-2"
                                                                       id="theforce">The Force Awakens</a></li>
                <li class="attendees-tags" style="display: inline;"><a class="btn btn-sm btn-default mr-2 mb-2 mt-2"
                                                                       id="intergalactic">Intergalactic</a>
                </li>
            </ul>

            <div id="description-container">
                <p id="description-text"></p>
            </div>
            <!-- Tab Content - Creators -->
            <div id="creators-content" class="tab-content">
                <table class="table table-hover table-vcenter">
                    <thead>
                    <tr>
                        <th>Badge</th>
                        <th>Name</th>
                        <th>Bio</th>
                        <th>Points</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% set dancingRowCreator = false %} <!-- Initialize the dancingRow variable -->
                    {% for user in creators %}
                        {% if user.organizer %}
                            <tr class="trrow{% if not dancingRowCreator %} dancing-rowc{% set dancingRowCreator = true %}{% endif %}">
                                <td>
                                    <div class="outer-image">
                                        <img src="{{ user.imagiifypointslevel ? asset(user.imagiifypointslevel) : user.logoPlaceholder }}" alt="Participation badge">
                                        <div class="inner-image">
                                            <img src="{{ user.organizer.logoName ? asset(user.organizer.getLogoPath) : user.organizer.getLogoPlaceholder }}"
                                            >
                                        </div>
                                    </div>
                                </td>
                                <td><a href="{{ path('organizer', { slug : user.username }) }}"
                                       data-toggle="tooltip">{{ user.getCrossRoleName }}</a></td>
                                <td>{{ user.organizer.description|striptags }}</td>
                                <td style="display: none;" class="points-level">{{ user.stringifypointslevel }}</td>
                                <td>{{ user.points }}</td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            <!-- Tab Content - Attendees -->
            <div id="attendees-content" class="tab-content">
                <table class="table table-hover table-vcenter">
                    <thead>
                    <tr>
                        <th>Badge</th>
                        <th>Name</th>
                        <th>Bio</th>
                        <th>Points</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% set dancingRow = false %} <!-- Initialize the dancingRow variable -->
                    {% for user in attendees %}
                        {% if user.points >= 1 and not user.hideleaderboards %}
                            <tr class="trrow{% if not dancingRow %} dancing-row{% set dancingRow = true %}{% endif %}">
                                <td>
                                    <div class="circular-image-container">
                                        <img class="circular-image"
                                             src="{{ user.logoName ? asset(user.getLogoPath) : user.getLogoPlaceholder }}">
                                        {% if user.getNolevel() == false %}
                                            <img class="bottom-right-image"
                                                 src="{{ user.imagiifypointslevel }}">
                                        {% endif %}
                                    </div>
                                </td>
                                <td><a href="{{ path('profile_attendee', { slug : user.username }) }}"
                                       data-toggle="tooltip">{{ user.getCrossRoleName }}</a></td>
                                <td>{{ user.bio|striptags }}</td>
                                <td style="display: none;"
                                    class="points-level">{{ user.stringifypointslevelAttendee }}</td>
                                <td>{{ user.points }}</td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>
    <p class="text-center" id="leaderboard-status" role="status"></p>
    <style>@media(prefers-reduced-motion:reduce){.dancing-row,.dancing-rowc{animation:none!important}} .tab-content{overflow-x:auto} .tab-content td{overflow-wrap:anywhere;max-width:40vw}</style>
    <script src="{{ asset('js/leaderboards.js') }}" defer></script>
{% endblock %}
