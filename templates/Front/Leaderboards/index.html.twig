{% extends "Global/layout.html.twig" %}
{% block title %}Leaderboards{% endblock %}

{% block content %}
    <style>
        .mylist li {
            cursor: pointer;
        }

        .outer-image {
            position: relative;
            display: inline-block;
            z-index: 10;
        }

        .outer-image img {
            width: 100px;
            height: 100px;
        }

        .inner-image {
            position: absolute;
            top: 50%;
            left: 52%;
            height: 100%;
            transform: translate(-50%, -45%);
            width: 100%;
            padding: 17px;
            z-index: -1;
        }

        .inner-image img {
            width: 90%;
            height: 90%;
            border-radius: 50%;
        }

        /* Add a class for paused animation */
        .paused-animation {
            animation-play-state: paused !important;
        }

        /* Keyframe animations for dancing effect */
        @keyframes dance1 {
            0%, 100% {
                transform: translate(0, 0);
            }
            25% {
                transform: translate(5px, -5px);
            }
            50% {
                transform: translate(0, 0);
            }
            75% {
                transform: translate(-5px, 5px);
            }
        }

        @keyframes dance2 {
            0%, 100% {
                transform: translate(0, 0);
            }
            25% {
                transform: translate(5px, 5px);
            }
            50% {
                transform: translate(0, 0);
            }
            75% {
                transform: translate(-5px, -5px);
            }
        }

        @keyframes dance3 {
            0%, 100% {
                transform: translate(0, 0);
            }
            25% {
                transform: translate(-5px, -5px);
            }
            50% {
                transform: translate(0, 0);
            }
            75% {
                transform: translate(5px, 5px);
            }
        }

        /* Add dancing animation to the first row */
        .dancing-rowc {
            animation: dance1 2s infinite; /* Start with the first dance pattern */
            cursor: pointer !important;
        }

        .dancing-row {
            animation: dance1 2s infinite; /* Start with the first dance pattern */
            cursor: pointer !important;
        }

        /* Style for table th and td */
        table {
            width: 100%; /* Ensure the table takes up the full width of its container */
        }

        table th, table td {
            text-align: center; /* Center-align text within th and td */
        }

        /* If you want different text alignment for specific columns, you can use nth-child selectors */
        /* Example: Align the first column (index 1) to the left */
        table th:nth-child(1), table td:nth-child(1) {
            text-align: center;
        }

        /* Example: Align the second column (index 2) to the right */
        table th:nth-child(2), table td:nth-child(2) {
            text-align: right;
        }

        #attendees-content {
            display: none;
        }

        .styled-button {
            background-color: #2E7599; /* Purple background color */
            color: #FFFFFF; /* White text color */
            border: none;
            border-radius: 10px; /* Adds a curved shape */
            padding: 5px 11px;
            margin: 5px;
            cursor: pointer;
            font-size: 16px;
        }

        /* Style for the circular image container */
        .circular-image-container {
            position: relative;
            width: 100px; /* Set your desired size for the circular image container */
            height: 100px; /* Set your desired size for the circular image container */
            border-radius: 50%; /* Makes the container round */
        }

        /* Style for the circular image */
        .circular-image {
            display: block;
            width: 90%;
            height: 90%;
            object-fit: cover !important; /* Adjust this for image positioning */
            border-radius: 50%; /* Makes the image itself round */
        }

        /* Style for the surrounding image */
        .surrounding-image {
            position: absolute;
            top: 0;
            left: 0;
            width: 110%; /* Set your desired size for the surrounding image */
            height: 110%; /* Set your desired size for the surrounding image */
            object-fit: contain !important; /* Adjust this for image positioning */
        }

        .bottom-right-image {
            position: absolute;
            bottom: 0;
            right: 0;
            width: 40px; /* Set your desired size for the bottom-right image */
            height: 40px; /* Set your desired size for the bottom-right image */
            object-fit: contain; /* Adjust this for image positioning */
        }

    </style>

    <section class="section-content bg-white padding-y">
        <div class="main {{ services.getSetting("app_layout") }}">
            <div class="tab-buttons"
                 style="display: flex; justify-content: start; align-items: center; align-content: center">
                <button id="creators-tab" class="styled-button btn btn-primary d-inline-block">Creators</button>
                <button id="attendees-tab" class="styled-button btn btn-primary d-inline-block">
                    Attendees
                </button>
                <div class="input-icon" style="float: left;  width: 100%">
                    <input name="keyword"
                           style="float: left; margin: 5px; height: 36px; border-radius: 10px; width: 100%"
                           class="form-control top-search"
                           placeholder="{{ "Filter users" }}"
                           type="text" id="filter-input">
                </div>
            </div>

            <ul style="list-style-type:none; padding: 0; margin-top: 10px" class="mylist">
                <li style="display: inline;"><a id="show-all-button"
                                                class="btn btn-sm btn-default mr-2 mb-2 mt-2 filter-tag"
                                                data-points-level="all">All</a></li>
                <li class="creators-tags" style="display: inline;"><a class="btn btn-sm btn-default mr-2 mb-2 mt-2"
                                                                      id="learnerofone">Learner of One</a></li>
                <li class="creators-tags" style="display: inline;"><a class="btn btn-sm btn-default mr-2 mb-2 mt-2"
                                                                      id="learnermany">Learner of Many Things</a></li>
                <li class="creators-tags" style="display: inline;"><a class="btn btn-sm btn-default mr-2 mb-2 mt-2"
                                                                      id="masterofone">Master of One</a></li>
                <li class="creators-tags" style="display: inline;"><a class="btn btn-sm btn-default mr-2 mb-2 mt-2"
                                                                      id="masterofmost">Master of Most</a></li>
                <li class="creators-tags" style="display: inline;">
                    <a class="btn btn-sm btn-default mr-2 mb-2 mt-2" id="masteroftheuniverse">Master of the Universe</a>
                </li>
                <li class="attendees-tags" style="display: inline;"><a class="btn btn-sm btn-default mr-2 mb-2 mt-2"
                                                                       id="smurfantastic">Smurfantastic</a>
                </li>
                <li class="attendees-tags" style="display: inline;"><a class="btn btn-sm btn-default mr-2 mb-2 mt-2"
                                                                       id="wubba">Wubba Lubba Dub Dub!</a></li>
                <li class="attendees-tags" style="display: inline;"><a class="btn btn-sm btn-default mr-2 mb-2 mt-2"
                                                                       id="theforce">The Force Awakens</a></li>
                <li class="attendees-tags" style="display: inline;"><a class="btn btn-sm btn-default mr-2 mb-2 mt-2"
                                                                       id="intergalactic">Intergalactic</a>
                </li>
            </ul>

            <div id="description-container">
                <p id="description-text"></p>
            </div>
            <!-- Tab Content - Creators -->
            <div id="creators-content" class="tab-content">
                <table class="table table-hover table-vcenter">
                    <thead>
                    <tr>
                        <th>Badge</th>
                        <th>Name</th>
                        <th>Bio</th>
                        <th>Points</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% set dancingRowCreator = false %} <!-- Initialize the dancingRow variable -->
                    {% for user in creators %}
                        {% if user.orggoodrole %}
                            <tr class="trrow{% if not dancingRowCreator %} dancing-rowc{% set dancingRowCreator = true %}{% endif %}">
                                <td>
                                    <div class="outer-image">
                                        <img src="{{ asset(user.imagiifypointslevel) }}">
                                        <div class="inner-image">
                                            <img src="{{ user.organizer.logoName ? asset(user.organizer.getLogoPath) : user.organizer.getLogoPlaceholder }}"
                                            >
                                        </div>
                                    </div>
                                </td>
                                <td><a href="{{ path('organizer', { slug : user.slug }) }}"
                                       data-toggle="tooltip">{{ user.getCrossRoleName }}</a></td>
                                <td>{{ user.organizer.description|striptags }}</td>
                                <td style="display: none;" class="points-level">{{ user.stringifypointslevel }}</td>
                                <td>{{ user.points }}</td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            <!-- Tab Content - Attendees -->
            <div id="attendees-content" class="tab-content">
                <table class="table table-hover table-vcenter">
                    <thead>
                    <tr>
                        <th>Badge</th>
                        <th>Name</th>
                        <th>Bio</th>
                        <th>Points</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% set dancingRow = false %} <!-- Initialize the dancingRow variable -->
                    {% for user in attendees %}
                        {% if user.points >= 1 and not user.hideleaderboards %}
                            <tr class="trrow{% if not dancingRow %} dancing-row{% set dancingRow = true %}{% endif %}">
                                <td>
                                    <div class="circular-image-container">
                                        <img class="circular-image"
                                             src="{{ user.logoName ? asset(user.getLogoPath) : user.getLogoPlaceholder }}">
                                        {% if user.getNolevel() == false %}
                                            <img class="bottom-right-image"
                                                 src="{{ user.imagiifypointslevel }}">
                                        {% endif %}
                                    </div>
                                </td>
                                <td><a href="{{ path('profile_attendee', { slug : user.slug }) }}"
                                       data-toggle="tooltip">{{ user.getCrossRoleName }}</a></td>
                                <td>{{ user.bio|striptags }}</td>
                                <td style="display: none;"
                                    class="points-level">{{ user.stringifypointslevelAttendee }}</td>
                                <td>{{ user.points }}</td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>
    <script>
        // Store the initial lists of attendees and creators when the page loads
        let initialCreatorsList;
        let initialAttendeesList;

        // Function to get the "tag" parameter from the URL
        function getTagParameter() {
            const params = new URLSearchParams(location.search);
            return params.get("tag");
        }

        document.addEventListener("DOMContentLoaded", function () {
            initialCreatorsList = document.getElementById("creators-content").innerHTML;
            initialAttendeesList = document.getElementById("attendees-content").innerHTML;
        });

        // Rest of your code...

        // Function to reset the list to show all users
        function resetList() {
            const creatorsContent = document.getElementById("creators-content");
            const attendeesContent = document.getElementById("attendees-content");

            // Reset the displayed content to the initial lists
            creatorsContent.innerHTML = initialCreatorsList;
            attendeesContent.innerHTML = initialAttendeesList;

            // Reset the filter input field
            filterInput.value = '';
            clearDescription();
        }

        // Event listener to reset the list when the "Show All" button is clicked
        document.getElementById("show-all-button").addEventListener("click", resetList);

        // Function to toggle between Creators and Attendees tabs
        function toggleTabs(tabId) {
            const creatorsContent = document.getElementById("creators-content");
            const attendeesContent = document.getElementById("attendees-content");

            if (tabId === "creators-tab") {
                creatorsContent.style.display = "block";
                attendeesContent.style.display = "none";
            } else if (tabId === "attendees-tab") {
                creatorsContent.style.display = "none";
                attendeesContent.style.display = "block";
            }
        }

        document.getElementById("creators-tab").addEventListener("click", function () {
            toggleTabs("creators-tab");
        });

        document.getElementById("attendees-tab").addEventListener("click", function () {
            toggleTabs("attendees-tab");
        });

        // Function to filter the content
        function filterContent() {
            const filterInput = document.getElementById("filter-input");
            const filterText = filterInput.value.trim().toLowerCase();

            function filterTable(tableId, columnIndex, additionalColumnIndex) {
                const table = document.getElementById(tableId);
                const rows = table.querySelectorAll("tbody tr");

                rows.forEach(row => {
                    const cell = row.querySelector(`td:nth-child(${columnIndex})`);
                    let additionalCell = null;

                    if (additionalColumnIndex) {
                        additionalCell = row.querySelector(`td:nth-child(${additionalColumnIndex})`);
                    }

                    if (cell) {
                        const cellText = cell.innerText.toLowerCase();

                        if (additionalCell) {
                            const additionalCellText = additionalCell.innerText.toLowerCase();
                            row.style.display =
                                cellText.includes(filterText) || additionalCellText.includes(filterText) ?
                                    "table-row" : "none";
                        } else {
                            row.style.display = cellText.includes(filterText) ? "table-row" : "none";
                        }
                    }
                });
            }

            filterTable("creators-content", 2, 3); // Filter by Name and Bio, additionalColumnIndex is 3 for Bio
            filterTable("attendees-content", 2, 3); // Filter by Name and Bio, additionalColumnIndex is 4 for Bio
        }

        const filterInput = document.getElementById("filter-input");
        filterInput.addEventListener("input", filterContent);

        // JavaScript to rotate dancing animation patterns
        const dancingRow = document.querySelector(".dancing-row");
        dancingRow.addEventListener("mouseenter", function () {
            dancingRow.classList.add("paused-animation");
        });

        dancingRow.addEventListener("mouseleave", function () {
            dancingRow.classList.remove("paused-animation");
        });
        let currentDancePattern = 1;
        setInterval(() => {
            currentDancePattern = (currentDancePattern % 3) + 1;
            dancingRow.style.animationName = `dance${currentDancePattern}`;
        }, 4000); // Change the pattern every 8 seconds

        dancingRow.addEventListener("click", function () {
            const link = dancingRow.querySelector("a");
            if (link) {
                window.location = link.href;
            }
        });

        // JavaScript to rotate dancing animation patterns
        const dancingRowCreator = document.querySelector(".dancing-rowc");
        dancingRowCreator.addEventListener("mouseenter", function () {
            dancingRowCreator.classList.add("paused-animation");
        });

        dancingRowCreator.addEventListener("mouseleave", function () {
            dancingRowCreator.classList.remove("paused-animation");
        });
        let currentDancePatternc = 1;
        setInterval(() => {
            currentDancePatternc = (currentDancePatternc % 3) + 1;
            dancingRowCreator.style.animationName = `dance${currentDancePatternc}`;
        }, 4000); // Change the pattern every 8 seconds

        dancingRowCreator.addEventListener("click", function () {
            const link = dancingRowCreator.querySelector("a");
            if (link) {
                window.location = link.href;
            }
        });

        // Function to show/hide creators and attendees
        function toggleCreatorsAttendeesDisplay(showCreators) {
            const creatorsContent = document.getElementById("creators-content");
            const attendeesContent = document.getElementById("attendees-content");

            if (showCreators) {
                creatorsContent.style.display = "block";
                attendeesContent.style.display = "none";
            } else {
                creatorsContent.style.display = "none";
                attendeesContent.style.display = "block";
            }
        }

        // Function to clear the description
        function clearDescription() {
            const descriptionText = document.getElementById("description-text");
            descriptionText.textContent = ""; // Clear the description text
        }

        document.addEventListener("DOMContentLoaded", function () {
                // Function to filter the list based on user.stringifypointslevel
                function filterListByPointsLevel(pointsLevel, listId) {
                    const tableRows = document.querySelectorAll(`.trrow`);

                    tableRows.forEach(row => {
                        const userPointsLevel = row.querySelector(".points-level").innerText.toLowerCase();
                        if (userPointsLevel === pointsLevel.toLowerCase()) {
                            row.style.display = "table-row";
                        } else {
                            row.style.display = "none";
                        }
                    });

                    // Set the relevant description unless "All" is clicked
                    setDescription(getDescription(pointsLevel));
                }

                // Function to set the description
                function setDescription(description) {
                    const descriptionText = document.getElementById("description-text");
                    descriptionText.textContent = "Description: " + description;
                }

// Function to get the description based on the points level
                function getDescription(pointsLevel) {
                    switch (pointsLevel.toLowerCase()) {
                        case "master of the universe":
                            return "You've conquered every corner of the cosmos, earning the ultimate title in our gamified universe.";
                        case "master of most":
                            return "You've mastered a multitude of skills and areas, making you a formidable force in the game.";
                        case "master of one":
                            return "Focusing your expertise on a particular skill or field has made you a standout player, demonstrating mastery in one key aspect.";
                        case "learner of many things":
                            return "You're an avid explorer, always eager to dive into new challenges and discover a wide range of skills.";
                        case "learner of one":
                            return "You've embarked on a journey of learning and are already making waves in your chosen discipline.";
                        case "intergalactic":
                            return "You've transcended planetary boundaries and become a true cosmic explorer, navigating through galaxies in this epic journey.";
                        case "the force awakens":
                            return "Just like the Force itself, your potential is awakening, and you're ready to wield incredible abilities in this ever-expanding universe.";
                        case "wubba lubba dub dub!":
                            return "Get ready for some wild and wacky adventures, as you embrace the zany and unpredictable aspects of this level. Anything can happen!";
                        case "smurfantastic":
                            return "Step into the whimsical world of Smurfs, where you'll join the ranks of these charming blue creatures on all sorts of delightful quests.";
                        default:
                            return "";
                    }
                }

                // Event listeners for li elements (tags)
                const tagElements = document.querySelectorAll("ul li");
                tagElements.forEach(tagElement => {
                    tagElement.addEventListener("click", function () {
                        // Get the text of the clicked tag
                        const pointsLevel = tagElement.innerText.trim();

                        // Check if the clicked tag is "All"
                        if (pointsLevel.toLowerCase() === "all") {
                            resetList(); // Show all users
                        } else if (tagElement.classList.contains("attendees-tags")) {
                            filterListByPointsLevel(pointsLevel, "attendees-content");
                            toggleCreatorsAttendeesDisplay(false); // Show attendees
                        } else if (tagElement.classList.contains("creators-tags")) {
                            filterListByPointsLevel(pointsLevel, "creators-content");
                            toggleCreatorsAttendeesDisplay(true); // Show creators
                        }
                    });
                });

                // Event listener to reset the list when a "Show All" button is clicked
                document.getElementById("show-all-button").addEventListener("click", resetList);

                const tagToFeature = getTagParameter();

                // Function to decode the URL-encoded tag
                function decodeTag(tag) {
                    return decodeURIComponent(tag);
                }

                // Function to find the matching tag by its ID
                function findTagByText(tagtext) {
                    const tagElements = document.querySelectorAll(".main ul li");
                    for (const tagElement of tagElements) {
                        if (tagElement.innerText.trim().toLowerCase() === tagtext.trim().toLowerCase()) {
                            return tagElement;
                        }
                    }
                    return null; // Tag not found
                }

                if (tagToFeature) {
                    const decodedTag = decodeTag(tagToFeature).toLowerCase();

                    const tagElement = findTagByText(decodedTag);
                    if (tagElement) {
                        tagElement.click();
                    }
                }
            }
        )
        ;
    </script>
{% endblock %}
