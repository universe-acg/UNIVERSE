{% extends "Global/layout.html.twig" %}

{% set pagetitle = event.name %}

{% block title %}{{ pagetitle }}{% endblock %}

{% block meta_dynamic_seo %}
{% endblock %}

{% block content %}

    {% if is_granted('ROLE_ADMINISTRATOR') %}
        {% include "Global/message.html.twig" with { type: 'info', icon: 'fas fa-info-circle', message: ('<a href="'~ path('dashboard_administrator_event', {slug: event.slug}) ~'">' ~ 'Click here' ~ '</a> ' ~ 'to manage this event') } %}
    {% endif %}
    {% if is_granted('ROLE_ORGANIZER') %}
        {% if event.organizer == app.user.organizer %}
            {% include "Global/message.html.twig" with { type: 'info', icon: 'fas fa-info-circle', message: ('<a href="'~ path('dashboard_organizer_event', {slug: event.slug}) ~'">' ~ 'Click here' ~ '</a> ' ~ 'to manage your event') } %}
        {% endif %}
    {% endif %}
    {% if is_granted('ROLE_ATTENDEE') %}
        {% if app.user.hasBoughtATicketForEvent(event) %}
            {% include "Global/message.html.twig" with { type: 'info', icon: 'fas fa-ticket-alt', message: ('You are going to this event' ~ ' ' ~ '<a href="'~ path('dashboard_attendee_orders', {event: event.slug}) ~'">' ~ 'My tickets' ~ '</a>') } %}
        {% endif %}
    {% endif %}

    {% set navigation = [{"events": "Events", "current" : (pagetitle)}] %}
    {% include "Global/navigation.html.twig" with navigation %}

    <div class="row no-gutters">
        <div class="col-12 p-0">
            <section class="section-main">
                <div class="owl-init slider-main owl-carousel" data-items="1" data-dots="false" data-nav="false"
                     data-autoplay="false">
                    <div class="item-slide d-flex">
                        <img class="slider-img justify-content-center align-self-center img-lazy-load"
                             src="{{ asset('assets/img/loader.gif') }}"
                             data-src="{{ event.imageName ? asset(event.getImagePath) : event.getImagePlaceholder }}"
                             alt="{{ event.name }}"/>
                        <div class="slider-blured-background"
                             style="background-image: url('{{ event.imageName ? asset(event.getImagePath) : event.getImagePlaceholder }}');"></div>
                    </div>
                </div>
            </section>
        </div>
    </div>
    <section class="section-content padding-y bg-white">
        <div class="{{ services.getSetting("app_layout") }}">
            <div class="card">
                <div class="row">
                    <div class="col-12 col-lg-8 order-1 order-lg-0">
                        <div class="card-body">
                            <h1 class="card-title b d-none d-lg-block">{{ event.name }}</h1>
                            {% if event.description %}
                                <dl class="mt-5 event-description">
                                    <dt class="text-muted">{{ "Description" }}</dt>
                                    <dd class="line-height-2 readmore" data-collapsed-height="500"
                                        data-height-margin="20">
                                        {{ event.description|raw|nl2br }}
                                    </dd>
                                </dl>
                            {% endif %}
                            {% if event.images|length > 0 %}
                                <dl class="mt-5">
                                    <dt class="text-muted">{{ "Photos" }}</dt>
                                    <dd class="mr-0">
                                        <div class="gallery photos-gallery clearfix">
                                            {% for image in event.images %}
                                                <figure>
                                                    <a href="{{ asset(image.getImagePath) }}"
                                                       data-size="{{ image.imageDimensions[0] }}x{{ image.imageDimensions[1] }}">
                                                        <img class="img-lazy-load img-thumbnail img-100-100"
                                                             src="{{ asset('assets/img/loader.gif') }}"
                                                             data-src="{{ asset(image.getImagePath) }}"
                                                             alt="{{ event.name }}"/>
                                                    </a>
                                                </figure>
                                            {% endfor %}

                                        </div>
                                    </dd>
                                </dl>
                            {% endif %}
                            <div style="display: flex; justify-content: start; align-content: center; align-items: center">
                                {% for file in event.files %}
                                    <div>
                                        <a
                                                href="{{ path('dashboard_organizer_management_files_download_file_event', {'fileId': file.id}) }}"
                                                style="float: left" class="mr-4">
                                            <img style="width: 75px; height: 75px"
                                                 src="{{ asset('assets/img/icons/file.png') }}"
                                                 alt="File" class="custom-image">
                                            {{ file.fileName }}
                                        </a>
                                    </div>
                                {% endfor %}
                            </div>
                            {% if event.hasContactAndSocialMedia %}
                                <dl class="mt-5">
                                    <dt class="text-muted">{{ "Contact & Social media" }}</dt>
                                    <dd class="mr-0">
                                        <ul class="list-icon row no-gutters">
                                            {% if event.externallink %}
                                                <li class="col-md-6"><a
                                                            href="{% if 'http://' not in event.externallink and 'https://' not in event.externallink %}http://{% endif %}{{ event.externallink }}"
                                                            class="pl-4" target="_blank"><i
                                                                class="icon fas fa-globe fa-fw"></i><span>{{ event.externallink }}</span></a>
                                                </li>
                                            {% endif %}
                                            {% if event.email %}
                                                <li class="col-md-6"><a href="mailto:{{ event.email }}" class="pl-4"><i
                                                                class="icon fas fa-at fa-fw"></i><span>{{ event.email }}</span></a>
                                                </li>
                                            {% endif %}
                                            {% if event.phonenumber %}
                                                <li class="col-md-6"><a href="tel:{{ event.phonenumber }}" class="pl-4"><i
                                                                class="icon fas fa-phone fa-fw"></i><span>{{ event.phonenumber }}</span></a>
                                                </li>
                                            {% endif %}
                                        </ul>
                                    </dd>
                                </dl>
                            {% endif %}
                            <dl class="mt-5">
                                <dt class="text-muted">{{ "Share" }}</dt>
                                <dd class="mr-0">
                                    <div class="sharer"></div>
                                </dd>
                            </dl>
                            {% if event.tags %}
                                <hr class="mt-5">
                                <div class="row">
                                    <div class="col">
                                        {% for tag in event.tags|split(',') %}
                                            <a href="{{ path('events', { keyword : tag }) }}"
                                               class="btn btn-sm btn-default mr-3 mb-3 mt-3">{{ tag }}</a>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="col-12 col-lg-4 order-0 order-lg-1 ">
                        <div class="card-body">
                            <h1 class="card-title b d-lg-none text-center">{{ event.name }}</h1>
                            {#                            {% if event.hasAnEventDateOnSale %} #}
                            {# Event Dates calendar used on multi date events #}
                            {% if event.hasTwoOrMoreEventDatesOnSale %}
                                {% set eventDatesCalendar = [] %}
                                {% for eventDate in event.eventdates %}
                                    {% set eventDatesCalendar = eventDatesCalendar|merge([{"Date": eventDate.startdate|date('Y-m-d'), "Title": eventDate.startdate|date('g:i A'), "Link": eventDate.reference}]) %}
                                {% endfor %}
                                {#                                {% include "Global/message.html.twig" with { type: 'info', icon: 'fas fa-info-circle', message: "Click on a date to view tickets" } %} #}
                                <div id="event-dates-calendar" class="mt-5"
                                     data-event-dates="{{ eventDatesCalendar|json_encode() }}"></div>
                            {% endif %}

                            {% if event.hasTwoOrMoreEventDatesOnSale %}
                            <div style="overflow-y: scroll; height: 500px">
                                {% else %}
                                <div>
                                    {% endif %}
                                    <input type="hidden" name="reference" value="{{ event.id }}">
                                    <dt class="text-muted">
                                        <span>{{ "Dates" }}</span>
                                    </dt>
                                    {% for eventDate in event.eventdates %}
                                        <div id="eventDate-{{ eventDate.reference }}-wrapper"
                                             class="event-eventDate-wrapper">
                                            <dl>
                                                <dd>
                                                    <div class="text-center">
                                                        {# for the add to calendar link #}
                                                        {% set eventstartdate = "" %}
                                                        {% set eventenddate = "" %}
                                                        {% set eventlocation = "" %}
                                                        {% if eventDate.startdate %}
                                                            <div class="display-inline-block">
                                                                <div class="display-inline-block">
                                                                    <span class="font-size-3rem">{{ eventDate.startdate|date('d') }}</span>
                                                                </div>
                                                                <div class="display-inline-block mr-3">
                                                                    <div>
                                                                        <span class="font-size-1rem">{{ eventDate.startdate|localizeddate('none', 'none', app.request.locale, null, "MMMM")|capitalize|slice(0, 3) }}</span>
                                                                    </div>
                                                                    <div>
                                                                        <span>{{ eventDate.startdate|date('Y') }}</span>
                                                                    </div>
                                                                </div>
                                                                <div class="mb-2">
                                                                    <span class="text-muted b">
                                                                        {{ eventDate.startdate|date('g:i a')|upper }}
                                                                        {% if eventDate.enddate %}
                                                                            {% if eventDate.enddate|date('Y-m-d') == eventDate.startdate|date('Y-m-d') %}
                                                                                - {{ eventDate.enddate|date('g:i a')|upper }}
                                                                            {% endif %}
                                                                        {% endif %}
                                                                    </span>
                                                                </div>
                                                            </div>
                                                            {% set eventstartdate = eventDate.startdate|date('F d, Y H:i') %}
                                                        {% endif %}
                                                        {% if eventDate.enddate %}
                                                            {% if eventDate.enddate|date('Y-m-d') != eventDate.startdate|date('Y-m-d') %}
                                                                <div class="display-inline-block">
                                                                    <div class="display-inline-block">
                                                                        <span class="font-size-3rem">{{ eventDate.enddate|date('d') }}</span>
                                                                    </div>
                                                                    <div class="display-inline-block">
                                                                        <div>
                                                                            <span class="font-size-1rem">{{ eventDate.enddate|localizeddate('none', 'none', app.request.locale, null, "MMMM")|capitalize|slice(0, 3) }}</span>
                                                                        </div>
                                                                        <div>
                                                                            <span>{{ eventDate.enddate|date('Y') }}</span>
                                                                        </div>
                                                                    </div>
                                                                    <div class="mb-2"><span
                                                                                class="text-muted b">{{ eventDate.enddate|date('g:i a')|upper }}</span>
                                                                    </div>
                                                                </div>
                                                            {% endif %}
                                                            {% set eventenddate = eventDate.enddate|date('F d, Y H:i') %}
                                                        {% endif %}
                                                        <div class="clearfix"></div>
                                                        <a id="add-to-calendar-link" data-toggle="modal"
                                                           data-target="#add-to-calendar-modal"
                                                           href="javascript:void(0)" data-title="{{ event.name }}"
                                                           data-start="{{ eventstartdate }}"
                                                           data-end="{{ eventenddate }}"
                                                           data-ticket="{{ eventDate.tickets[0].name }}"
                                                           data-address="{{ eventlocation }}"
                                                           data-description="{{ event.description|striptags|slice(0, 250)|raw|nl2br }}"><i
                                                                    class="fas fa-calendar-plus"></i> {{ "Add to calendar" }}
                                                        </a>
                                                        <div class="modal fade" id="add-to-calendar-modal">
                                                            <div class="modal-dialog modal-dialog-centered">
                                                                <div class="modal-content">
                                                                    <div class="modal-header">
                                                                        <h4 class="modal-title"><i
                                                                                    class="fas fa-calendar-plus"></i> {{ "Add to calendar" }}
                                                                        </h4>
                                                                        <button type="button" class="close"
                                                                                data-dismiss="modal">&times;
                                                                        </button>
                                                                    </div>
                                                                    <div id="add-to-calendar" class="modal-body">
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        {#                                                                        <button type="button" #}
                                                                        {#                                                                                disabled="{{ eventDate.tickets[0].isalreadybooked ? 'true' : 'false' }}" #}
                                                                        {#                                                                                class="btn btn-primary" #}
                                                                        {#                                                                                data-dismiss="modal">{{ "Book" }}</button> #}
                                                                        <button type="button" class="btn btn-primary"
                                                                                data-dismiss="modal">{{ "Close"|trans }}</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </dd>
                                            </dl>
                                            {% if eventDate.isOnSale %}
                                                <hr class="hr-md">
                                                <dl class="mt-5">
                                                    <dd class="mr-0">
                                                        <div class="table-responsive">
                                                            <table class="table table-hover table-condensed">
                                                                <tbody>
                                                                {% for ticket in eventDate.tickets %}
                                                                    {% if ticket.active and app.user.hasRole('ROLE_ATTENDEE') %}
                                                                        <tr class="bg-gray">
                                                                            <td class="border-top-white book-ticket btn btn-primary book-ticket"
                                                                                data-event-id="{{ event.id }}"
                                                                                data-event-date-id="{{ eventDate.reference }}"
                                                                                data-ticket-id="{{ ticket.id }}"
                                                                                data-is-already-booked="{{ ticket.isalreadybooked ? 'true' : 'false' }}"
                                                                                style="width: 100%; border-radius: 5px !important; cursor: pointer">
                                                                                <i class="fas fa-ticket-alt"></i>
                                                                                Book: {{ ticket.name }}
                                                                            </td>
                                                                        </tr>
                                                                    {% else %}
                                                                        <p>Only attendees can book events</p>
                                                                    {% endif %}
                                                                {% endfor %}
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </dd>
                                                </dl>
                                            {% endif %}
                                        </div>

                                    {% endfor %}
                                </div>

                                {#                            {% else %} #}
                                {#                                {% include "Global/message.html.twig" with { type: 'info', icon: 'fas fa-info-circle', message: "No tickets at this moment" } %} #}
                                {#                                <hr class="hr-md"> #}
                                {#                            {% endif %} #}

                                <dl class="mt-5 mb-5">
                                    <dt class="text-muted">
                                        <span class="float-left">{{ "Organizer" }}</span>
                                        <a href="{{ path('organizer', { slug : event.organizer.user.username }) }}"
                                           class="float-right text-sm"><i
                                                    class="far fa-id-card"></i> {{ "Details" }}</a>
                                        <div class="clearfix"></div>
                                    </dt>
                                    <dd class="mr-0">
                                        <div class="card-banner {{ event.organizer.coverName ? '' : 'organizer-preview-no-cover' }}"{% if event.organizer.coverName %} style="height:250px;background-image: url('{{ asset(event.organizer.getCoverPath|imagine_filter('thumbnail', {"thumbnail": {"size": [400, 250] }})) }}');" {% endif %}>
                                            <article class="overlay bottom text-center" style="
height: 100%; display: grid; justify-content: center; align-items: center; align-content: center">
                                                <h4 class="card-title" style="margin-top: 0.65rem"><a
                                                            href="{{ path('organizer', { slug : event.organizer.user.username }) }}">{{ event.organizer.name }}</a>
                                                </h4>
                                                {% if event.organizer.logoName %}
                                                    <img src="{{ asset(event.organizer.getLogoPath) }}"
                                                         class="img-100-100 d-block mx-auto mb-3 img-thumbnail"
                                                         alt="{{ event.organizer.name }}"/>
                                                {% endif %}
                                                {% if not is_granted('IS_AUTHENTICATED_REMEMBERED') or is_granted('ROLE_ATTENDEE') %}
                                                    {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                                                        {% if event.organizer.isFollowedBy(app.user) %}
                                                            <button class="organizer-unfollow btn btn-primary btn-sm"
                                                                    data-target="{{ path('app_dashboard_attendee_following_remove', { slug : event.organizer.slug }) }}">
                                                                <i class="fas fa-folder-minus"></i> {{ "Unfollow" }}
                                                            </button>
                                                        {% else %}
                                                            <button class="organizer-follow btn btn-primary btn-sm"
                                                                    data-target="{{ path('app_dashboard_attendee_following_add', { slug : event.organizer.slug }) }}">
                                                                <i class="fas fa-folder-plus"></i> {{ "Follow" }}
                                                            </button>
                                                        {% endif %}
                                                    {% else %}
                                                        <a href="{{ path('fos_user_security_login')~'?_target_path='~app.request.getPathInfo }}"
                                                           class="btn btn-primary btn-sm"><i
                                                                    class="fas fa-folder-plus"></i> {{ "Follow" }}</a>
                                                    {% endif %}
                                                {% endif %}
                                            </article>
                                        </div>
                                    </dd>
                                </dl>
                                {% if event.showattendees and is_granted('ROLE_ATTENDEE') %}
                                    {% set attendeescount = event.getTotalOrderElementsQuantitySum(1, 'all', 'ROLE_ATTENDEE') %}
                                    {% if attendeescount %}
                                        <hr>
                                        <dl class="mt-5">
                                            <dt class="text-muted mb-3">
                                    <span class="float-left">{{ "Attendees" }} <b>({{ attendeescount }})</b>
                                </span>
                                                <a href="#"
                                                   class="float-right text-sm"
                                                   data-toggle="modal" data-target="#attendees-modal"><i
                                                            class="fas fa-users"></i> {{ "See all" }}</a>
                                                <div class="modal fade" id="attendees-modal">
                                                    <div class="modal-dialog modal-dialog-centered">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <div class="modal-title h4">{{ "Attendees" }}
                                                                    ({{ attendeescount }})
                                                                </div>
                                                                <button type="button" class="close"
                                                                        data-dismiss="modal">
                                                                    &times;
                                                                </button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <div class="card border-0 card-body overflow-auto text-nowrap">
                                                                    <div class="avatar-list py-4">
                                                                        {% for user in services.getUsers({"hasbookedticketfor": event.slug, "role": "attendee"}) %}
                                                                            {% include "Global/user-avatar-events.html.twig" with { user: user, showusernametooltip: true } %}
                                                                        {% endfor %}
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="clearfix"></div>
                                            </dt>
                                            <dd class="mr-0">
                                                <div class="card border-0 card-body">
                                                    <div class="avatar-list">
                                                        {% for user in services.getUsersShuffled({"hasbookedticketfor": event.slug, "limit": 12, "role": "attendee"}) %}
                                                            {% include "Global/user-avatar-events.html.twig" with { user: user, showusernametooltip: true } %}
                                                        {% endfor %}
                                                        {% if attendeescount > 12 %}
                                                            <span class="avatar">{{ attendeescount - 12 }}</span>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </dd>
                                        </dl>
                                    {% endif %}
                                {% endif %}
                                {% if is_granted('ROLE_ATTENDEE') %}
                                    {% if event.volsneeded %}
                                        <dl class="mt-5">
                                            <dt class="text-muted pb-1">The organizers are looking for volunteers
                                                to
                                                help.
                                            </dt>
                                            <div class="input-group">
                                                <form method="post" class="input-group"
                                                      action="{{ path('volunteer_event_make_request', {'eventid': event.id}) }}">
        <textarea name="message" rows="3" class="mb-3 form-control">Hello, I would like to volunteer my time and skills to help out with the setting up of this event.
        </textarea>

                                                    <button type="submit" class="btn btn-primary btn-block"
                                                            style="border-radius: 0.25em">
                                                        Volunteer
                                                    </button>
                                                </form>
                                            </div>
                                        </dl>
                                    {% endif %}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="p-5">
                        <div class="mt-5">
                            {% include '@FOSComment/Thread/async.html.twig' with {'id':event.slug} %}
                        </div>
                        {% set similareventscriteria = {"category" : event.category, "limit" : 8, "otherthan": event.slug} %}
                        {% set similarevents = services.getEvents(similareventscriteria) %}
                        {% if similarevents %}
                            <div class="row">
                                <div class="col-12">
                                    <h3 class="mt-5 mb-4 text-center">{{ "Similar events" }}</h3>
                                    <div class="owl-init owl-carousel" data-margin="5" data-items="4" data-dots="false"
                                         data-nav="true" data-autoplay="true" data-loop="false">
                                        {% for event in similarevents %}
                                            {% include "Global/similar-event-card.html.twig" with {event: event} %}
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </section>

{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('event') }}
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Find all "Book" buttons by their class
            var bookButtons = document.querySelectorAll(".book-ticket");

            // Add a click event listener to each button
            bookButtons.forEach(function (bookButton) {
                bookButton.addEventListener("click", function (event) {
                    // Prevent the default form submission
                    event.preventDefault();

                    // Get the event ID, event date ID, and ticket ID from the data attributes
                    var eventId = bookButton.getAttribute("data-event-id");
                    var eventDateId = bookButton.getAttribute("data-event-date-id");
                    var ticketId = bookButton.getAttribute("data-ticket-id");

                    // Check if the ticket is already booked
                    var isAlreadyBooked = bookButton.getAttribute("data-is-already-booked");

                    if (isAlreadyBooked === 'true') {
                        // The ticket is already booked, so don't perform any action
                        alert("You have already booked this ticket");
                        return;
                    }

                    // Display an alert with the chosen event and ticket IDs
                    // Construct the URL for the controller with parameters
                    var url = '/dashboard/attendee/bookevent/' + eventId + '/' + ticketId;

                    // Create a form element
                    var form = document.createElement("form");
                    form.method = "POST"; // Set the HTTP method (POST in this case)
                    form.action = url; // Set the action URL

                    // Create a hidden input field for the event ticket ID
                    var eventTicketIdInput = document.createElement("input");
                    eventTicketIdInput.type = "hidden";
                    eventTicketIdInput.name = "eventicketid"; // Match the parameter name expected by the controller
                    eventTicketIdInput.value = ticketId;

                    // Append the hidden input field to the form
                    form.appendChild(eventTicketIdInput);

                    // Append the form to the document body and submit it
                    document.body.appendChild(form);
                    form.submit();
                });
            });
        });
    </script>
{% endblock %}