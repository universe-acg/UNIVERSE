{% extends 'Global/layout.html.twig' %}
{% set pagetitle=reel.title %}
{% block title %}{{ pagetitle }}{% endblock %}
{% block content %}
    {% set navigation=[{'reels':'Reels','current':pagetitle}] %}{% include 'Global/navigation.html.twig' with navigation %}
    <section class="section-content padding-y bg-white"><div class="{{ services.getSetting('app_layout') }}"><article class="card box"><div class="card-body">
        <div class="row"><div class="col-lg-8">
            {% if reel.type == 'video' and reel.videoFileName %}<video controls playsinline preload="metadata" class="w-100" poster="{{ reel.mainImage ? asset(reel.imagePath) : reel.imagePlaceholder }}" src="{{ asset(reel.videoPath) }}"></video>
            {% else %}<img class="img-fluid" src="{{ reel.mainImage ? asset(reel.imagePath) : reel.imagePlaceholder }}" alt="{{ reel.title }}">{% endif %}
        </div><div class="col-lg-4"><h1>{{ reel.title }}</h1><p>{{ reel.content }}</p>
            {% if reel.user %}<p>By {{ reel.user.crossRoleName }}</p>{% endif %}
            {% if app.user %}<button type="button" class="btn btn-outline-primary" id="reel-like" data-url="{{ path('reel_set_like',{slug:reel.slug}) }}" aria-pressed="{{ liked ? 'true':'false' }}">{{ liked ? 'Unlike':'Like' }}</button>{% else %}<a href="{{ path('fos_user_security_login') }}">Sign in to like</a>{% endif %}
            <span id="reel-like-count">{{ likeCount }}</span> likes <p id="reel-like-status" role="status"></p><a href="{{ path('reels') }}">All reels</a>
        </div></div>
        <h2 class="mt-4">Comments</h2>{% include '@FOSComment/Thread/async.html.twig' with {id:reel.slug} %}
    </div></article></div></section>
    <script src="{{ asset('js/reel-detail.js') }}" defer></script>
{% endblock %}
