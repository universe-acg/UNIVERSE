     <section class="section-content bg-white">
         <div class="container_grid">
             <div class="modal">
                 <div class='carousel'>
                     <div id="close-carousel">
                         <div class="x">
                             <div id="barra1"></div>
                             <div id="barra2"></div>
                         </div>
                     </div>
                     <div class="setas">
                         <div class="seta-esq">
                             <div id='prev-card'><i class="fa-solid fas fa-angle-left" style="color: #ffffff;"></i>
                             </div>
                         </div>
                         <div class="seta-dir">
                             <div id='next-card'><i class="fa-solid fas fa-angle-right" style="color: #ffffff;"></i>
                             </div>
                         </div>
                     </div>
                 </div>
                 <span class="close"></span>
                 <div id="reels-containerbox">
                     {% for reel in reels %}
                         <div class="centered-container" id="box-{{ reel.id }}" style="display:none;">
                             <div class="outerbox" style="z-index: 99999999999 !important;">
                                 <div class="col-lg-9" style="display: flex; justify-content: end">
                                     <img class="modal-contentmedia" style="width: 100%" src="" alt="">
                                     <video class="modal-contentmediavid" style="width: 100%" loop muted playsinline
                                            data-autoplay="{{ reel.getVideoFileName ? asset(reel.getVideoPath) : reel.getImagePlaceholder }}">
                                         <source src="{{ reel.getVideoFileName ? asset(reel.getVideoPath) : reel.getImagePlaceholder }}"
                                                 type="video/mp4">
                                     </video>
                                 </div>
                                 <div class="col-lg-3" style="display: flex;
    justify-content: center;
    align-items: center;
    height: 70% !important;">
                                     <div class="modal-contentbox" style="    overflow-y: scroll;
    height: 500px;
    width: 100%;">
                                         <h1>{{ reel.title }}</h1>
                                         <h4>{{ reel.content }}</h4>
                                         <h5>Comments</h5>
                                         <div class="mt-1">
                                             {% include '@FOSComment/Thread/async.html.twig' with {'id':reel.slug} %}
                                         </div>
                                     </div>
                                 </div>
                             </div>
                         </div>
                     {% endfor %}
                 </div>
             </div>
             <div class='carousel-images' id="reels-container">
                 {% for reel in reels %}
                     <div class="card_medium card_exp">
                         <figcaption style="float:left; top: 0; left: 5px;     padding-left: 10px;"><h4
                                     class="font-weight-bold"></h4></figcaption>
                         <div style="display: flex; justify-content: end; top: 50px !important; z-index: 99999; position: relative; padding-right: 20px; padding-left: 20px;">

                             <span class="avatar" style="width: 23px; height: 23px;" class="avatar"
                                   {% if showusernametooltip is defined %}data-toggle="tooltip"
                                   title="{{ reel.user.getCrossRoleName }}{{ reel.user.stringifypointslevel }}"
                                   data-container="body"{% endif %}>
                         <img src="{{ reel.user.logoName ? asset(reel.user.getLogoPath) : reel.user.getLogoPlaceholder }}"
                              alt="Profile Image"
                              style="width: 23px; height: 23px; border-radius: 50%; object-fit: cover;">
                         </span>
                         </div>

                         {% if reel.type == 'image' %}
                             <img class="img_card" data-reel-id="{{ reel.id }}"
                                  src="{{ reel.getMainImage ? asset(reel.getImagePath) : reel.getImagePlaceholder }}"
                                  alt="">
                         {% else %}
                             <video class="modal-contentmediavid" data-videoreel-id="{{ reel.id }}"
                                    style="width: 100%"
                                    loop muted playsinline
                                    data-autoplay="{{ reel.getVideoFileName ? asset(reel.getVideoPath) : reel.getImagePlaceholder }}">
                                 <source src="{{ reel.getVideoFileName ? asset(reel.getVideoPath) : reel.getImagePlaceholder }}"
                                         type="video/mp4">
                             </video>
                         {% endif %}

                         <div style="display: flex; justify-content: end; top: -50px !important; position: relative; padding-right: 20px; padding-left: 20px;">
                             <figcaption style="float:left; top: 0; left: 5px;     padding-left: 10px;"><h4
                                         class="font-weight-bold">{{ reel.title }}</h4></figcaption>

                             <button class="like-button"
                                     style="float: right; background: transparent; color: white; border: transparent; cursor: pointer; font-size: 20px;"
                                     data-toggle="tooltip"
                                     data-reel-id="{{ reel.id }}"
                                     data-liked="{{ reel.user }}"> {% if reel.user == app.user %}❤<i
                                         class="far fa-heart"></i>{% else %}{% endif %}
                             </button>
                         </div>
                     </div>
                 {% endfor %}
             </div>
         </div>

         <div id="loader-container">
             <div class="myloader"></div>
         </div>
     </section>

 {% endblock %}

 {% block javascripts %}
     <script>
         document.addEventListener('DOMContentLoaded', function () {
             const likeButtons = document.querySelectorAll('.like-button');

             likeButtons.forEach(button => {
                 button.addEventListener('click', function () {
                     const reelId = this.getAttribute('data-reel-id');
                     const isLiked = this.getAttribute('data-liked') === 'true';

                     // Make an AJAX request to your Symfony controller to toggle the like
                     // You should replace the 'your_like_toggle_route' with your actual route
                     // and adjust the controller accordingly
                     fetch(`/reel-likes/toggle-like/${reelId}`, {
                         method: 'POST',
                         headers: {
                             'Content-Type': 'application/json',
                         },
                         body: JSON.stringify({
                             isLiked: !isLiked,
                         }),
                     })
                         .then(response => response.json())
                         .then(data => {
                             // Update the button text and data attribute based on the response
                             this.setAttribute('data-liked', data.isLiked);
                             this.innerHTML = data.isLiked ? '❤️' : '🤍';
                         })
                         .catch(error => console.error('Error:', error));
                 });
             });
         });

         // Get the modal
         var modal = document.getElementsByClassName("card_exp");

         // Get all the image elements with class "card_exp"
         var images = document.getElementsByClassName("card_exp");

         // Get the <span> element that closes the modal
         var x = document.getElementsByClassName('x')[0];
         var span = document.getElementsByClassName('carousel')[0];
         var bg = document.getElementsByClassName("modal");

         // Loop through each image and attach the click event
         for (var i = 0; i < images.length; i++) {
             images[i].onclick = function () {
                 setTimeout('span.style.display = "block";', 100)
                 span.style.opacity = "1";
                 setTimeout('bg[0].style.opacity = "1";', 100)
                 /*modal.style.display = "block";*/
             };
         }

         // When the user clicks on <span> (x), close the modal
         x.onclick = function () {
             span.style.display = "none";
             span.style.opacity = "0";
             modal.style.opacity = "0";
             setTimeout('modal.style.display = "none";', 300)
         };

         var gridImages = Array.from(document.getElementsByClassName('img_card'));
         var carouselImages = document.querySelector('.carousel-images');
         var prevButton = document.querySelector('#prev-card');
         var nextButton = document.querySelector('#next-card');
         var modal = document.querySelector('.modal');
         var modalImg = document.querySelector('.modal-contentmedia');
         var modalvideo = document.querySelector('.modal-contentmediavid');
         var currentIndex = 0;

         var observer = new IntersectionObserver(handleIntersection, {threshold: 0.5});

         gridImages.forEach(function (image, index) {
             image.addEventListener('click', function () {
                 currentIndex = index;
                 modal.style.display = 'block';
                 const reelId = image.dataset.reelId;
                 showImage(currentIndex, reelId);
             });
             observer.observe(image);
         });

         prevButton.addEventListener('click', function () {
             currentIndex--;
             if (currentIndex < 0) {
                 currentIndex = gridImages.length - 1;
             }

             const reelId = gridImages[currentIndex].dataset.reelId;
             showImage(currentIndex, reelId);
         });

         nextButton.addEventListener('click', function () {
             currentIndex++;
             if (currentIndex >= gridImages.length) {
                 currentIndex = 0;
             }

             const reelId = gridImages[currentIndex].dataset.reelId;
             showImage(currentIndex, reelId);
         });

         // Define os manipuladores de eventos para os botões de navegação
         prevButton.addEventListener('click', prevButton);
         nextButton.addEventListener('click', nextButton);

         // Variable to store the currently active box ID
         var activeBoxId = null;

         // When the user presses the ESC key, close the modal
         document.addEventListener('keydown', function (event) {
             if (activeBoxId && event.key === "Escape") {
                 closeModal();
             }
         });

         function closeModal() {
             const box = document.querySelector(activeBoxId);
             setTimeout(function () {
                 box.style.display = 'none';
                 box.classList.remove('active'); // Remove the 'active' class
                 modal.style.display = 'none';
                 activeBoxId = null;
             }, 300);
         }

         var isOpeningImage = false;

         function showImage(index, reelId) {
             // Hide the previous active box, if any
             if (activeBoxId) {
                 document.querySelector(activeBoxId).classList.remove('active');
             }

             // Show the specific box for the selected reelId
             const boxid = '#box-' + reelId;
             var box = document.querySelector(boxid);
             box.style.display = 'flex';
             box.classList.add('active'); // Add the 'active' class
             activeBoxId = boxid;

             // Check if the modal content is a video
             if (gridImages[index].tagName.toLowerCase() === 'video') {
                 modalImg.style.display = 'none';
                 modalvideo.style.display = 'block';

                 // Set video source and restart
                 modalvideo.src = "https://v3.cdnpk.net/videvo_files/video/free/2012-10/large_watermarked/hd1843_preview.mp4";
                 modalvideo.currentTime = 0; // Set current time to 0 (restart)
             } else {
                 modalvideo.style.display = 'none';
                 modalImg.style.display = 'block';

                 // Set image source
                 modalImg.src = gridImages[index].src;
             }

             // Set modal properties
             modal.style.display = 'block';
             modal.style.opacity = '1';

             isOpeningImage = true;
         }

         document.addEventListener('click', function (event) {
             var activeBox = document.querySelector('.centered-container.active');

             if (activeBox && !activeBox.contains(event.target)) {
                 if (!isOpeningImage) {
                     closeModal();
                 } else {
                     isOpeningImage = false;
                 }
             }
         });


         // Assuming you have initialized these variables
         let currentPage = 1;
         let totalPages = 1;
         var canLoadMore = true;

         // Function to load more reels
         // function loadMoreReels() {
         //     // Increment the current page
         //     currentPage++;
         //
         //     // Make an AJAX request to load more reels
         //     $.ajax({
         //         url: 'https://universeacg.xyz/dashboard/attendee/load-more-reels',
         //         type: 'GET',
         //         data: {page: currentPage},
         //         success: function (response) {
         //             // Append the new HTML to your container
         //             $('#reels-container').append(response.html);
         //             $('#reels-containerbox').append(response.html);
         //
         //             // Update total pages based on the response or other logic
         //             totalPages = response.totalPages; // Adjust this based on your response
         //
         //             // Check if all pages are loaded
         //             if (currentPage >= totalPages) {
         //                 // Disable further loading or implement other logic
         //                 console.log('All pages loaded');
         //             }
         //         },
         //         error: function (error) {
         //             console.error('Error loading more reels:', error);
         //         }
         //     });
         // }
         // Function to load more reels

         function loadMoreReels() {
             // Check if the function can be called
             if (canLoadMore) {
                 // Disable the function for 5 seconds
                 canLoadMore = false;
                 setTimeout(function () {
                     canLoadMore = true;
                 }, 5000); // 5000 milliseconds = 5 seconds

                 // Show loader or spinner (adjust the HTML and CSS accordingly)
                 $('#loader-container').show();

                 // Perform the AJAX request to load more reels
                 $.ajax({
                     url: 'https://universeacg.xyz/dashboard/attendee/load-more-reels',
                     type: 'GET',
                     data: {
                         page: getNextPage() // Define a function to get the next page number
                     },
                     success: function (response) {
                         // Hide loader or spinner
                         $('#loader-container').hide();

                         // Append the loaded HTML to your container
                         $('#reels-container').append(response.html);
                         $('#reels-containerbox').append(response.html);

                         // Check if there are more pages
                         if (response.totalPages > getNextPage()) {
                             // Increment the page number for the next call
                             incrementPage();
                         }
                     },
                     error: function () {
                         // Handle error
                         console.error('Error loading more reels.');
                     }
                 });
             }
         }

         // Helper functions to manage page number
         var nextPage = 2; // Assuming the initial page is 1

         function getNextPage() {
             return nextPage;
         }

         function incrementPage() {
             nextPage++;
         }

         // Example with scroll event
         $(window).scroll(function () {
             if ($(window).scrollTop() + $(window).height() >= $(document).height() - 100) {
                 loadMoreReels();
             }
         });

         function handleIntersection(entries, observer) {
             console.log("Intersection Observer triggered");
             entries.forEach(function (entry) {
                 if (entry.isIntersecting) {
                     // Video is in view, start autoplay
                     const reelId = entry.target.dataset.reelId;
                     console.log("reelId: " + reelId);
                     const video = document.querySelector(`#box-${reelId} video[data-autoplay]`);

                     if (video) {
                         video.play();
                     }

                     // Unobserve the element to avoid unnecessary checks
                     observer.unobserve(entry.target);
                 }
             });
         }

     </script>
 {% endblock %}