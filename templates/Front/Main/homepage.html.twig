{% extends "Global/layout.html.twig" %}

{% block title %}{{ services.getSetting("website_description_" ~ "en") }}{% endblock %}

{% block stylesheets %}
<style>
/* ── Landing page scoped styles ── */

.landing-hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #0d1b2a 0%, #1b3a4b 40%, #2A769B 100%);
    overflow: hidden;
    padding: 100px 0 80px;
}
.landing-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 80%;
    height: 200%;
    background: radial-gradient(ellipse at center, rgba(42,118,155,0.25) 0%, transparent 70%);
    pointer-events: none;
}
.landing-hero .hero-artwork {
    max-width: 380px;
    animation: heroFloat 6s ease-in-out infinite;
    filter: drop-shadow(0 20px 40px rgba(0,0,0,0.3));
}
.landing-hero h1 {
    font-family: 'Montserrat', sans-serif;
    font-weight: 800;
    font-size: 3rem;
    line-height: 1.15;
    color: #fff;
}
.landing-hero h1 .text-accent {
    color: #5ec4e8;
}
.landing-hero .hero-subtitle {
    font-size: 1.15rem;
    color: rgba(255,255,255,0.8);
    max-width: 480px;
}
.landing-hero .btn-hero-primary {
    background: #fff;
    color: #1b3a4b;
    font-weight: 700;
    padding: 12px 32px;
    border-radius: 50px;
    border: none;
    transition: transform 0.2s, box-shadow 0.2s;
}
.landing-hero .btn-hero-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.2);
    color: #1b3a4b;
    text-decoration: none;
}
.landing-hero .btn-hero-outline {
    border: 2px solid rgba(255,255,255,0.5);
    color: #fff;
    font-weight: 600;
    padding: 11px 30px;
    border-radius: 50px;
    background: transparent;
    transition: border-color 0.2s, background 0.2s;
}
.landing-hero .btn-hero-outline:hover {
    border-color: #fff;
    background: rgba(255,255,255,0.1);
    color: #fff;
    text-decoration: none;
}

@keyframes heroFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-14px); }
}

/* ── Trusted by strip ── */
.landing-trusted {
    padding: 40px 0;
    background: #f8f9fa;
    border-bottom: 1px solid #e9ecef;
}
.landing-trusted .section-label {
    font-family: 'Montserrat', sans-serif;
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #999;
}
.club-logo {
    height: 50px;
    max-width: 120px;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.5;
    transition: filter 0.3s, opacity 0.3s;
}
.club-logo:hover {
    filter: grayscale(0%);
    opacity: 1;
}

/* ── Section basics ── */
.landing-section {
    padding: 80px 0;
}
.landing-section.bg-alt {
    background: #f8f9fa;
}
.landing-section .section-title {
    font-family: 'Montserrat', sans-serif;
    font-weight: 800;
    font-size: 2rem;
    color: #1b3a4b;
}
.landing-section .section-subtitle {
    color: #6c757d;
    font-size: 1.1rem;
    max-width: 600px;
}

/* ── Feature cards ── */
.feature-card {
    border: 1px solid #e9ecef;
    border-radius: 12px;
    padding: 28px 24px;
    background: #fff;
    transition: transform 0.25s, box-shadow 0.25s;
    height: 100%;
}
.feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.08);
}
.feature-card .feature-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    color: #fff;
    background: linear-gradient(135deg, #2A769B, #1b3a4b);
    margin-bottom: 16px;
}
.feature-card h5 {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    color: #1b3a4b;
}
.feature-card p {
    color: #6c757d;
    font-size: 0.92rem;
    margin: 0;
}

/* ── About section photo grid ── */
.about-photo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}
.about-photo-grid img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 10px;
}
.about-photo-grid img:first-child {
    grid-column: 1 / -1;
    height: 220px;
}

/* ── Stats strip ── */
.landing-stats {
    background: linear-gradient(135deg, #1b3a4b 0%, #2A769B 100%);
    padding: 60px 0;
}
.stat-item {
    text-align: center;
    color: #fff;
}
.stat-item .stat-number {
    font-family: 'Montserrat', sans-serif;
    font-weight: 800;
    font-size: 2.5rem;
    line-height: 1;
}
.stat-item .stat-label {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.7);
    margin-top: 6px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* ── CTA section ── */
.landing-cta {
    padding: 80px 0;
    background: linear-gradient(135deg, #2A769B 0%, #1b3a4b 100%);
    text-align: center;
}
.landing-cta h2 {
    font-family: 'Montserrat', sans-serif;
    font-weight: 800;
    font-size: 2.2rem;
    color: #fff;
}
.landing-cta p {
    color: rgba(255,255,255,0.8);
    font-size: 1.1rem;
    max-width: 500px;
    margin: 0 auto;
}
.landing-cta .btn-cta {
    background: #fff;
    color: #1b3a4b;
    font-weight: 700;
    padding: 14px 40px;
    border-radius: 50px;
    font-size: 1.05rem;
    border: none;
    transition: transform 0.2s, box-shadow 0.2s;
}
.landing-cta .btn-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.2);
    color: #1b3a4b;
    text-decoration: none;
}

/* ── Scroll reveal ── */
.reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s ease;
}
.reveal.revealed {
    opacity: 1;
    transform: translateY(0);
}

/* ── Responsive ── */
@media (max-width: 991.98px) {
    .landing-hero { min-height: auto; padding: 80px 0 60px; }
    .landing-hero h1 { font-size: 2.2rem; }
    .landing-hero .hero-artwork { max-width: 260px; }
    .landing-section { padding: 60px 0; }
    .stat-item .stat-number { font-size: 2rem; }
}
@media (max-width: 575.98px) {
    .landing-hero h1 { font-size: 1.75rem; }
    .landing-hero .hero-artwork { max-width: 200px; }
    .landing-hero .hero-subtitle { font-size: 1rem; }
    .landing-section .section-title { font-size: 1.6rem; }
    .about-photo-grid img { height: 140px; }
    .about-photo-grid img:first-child { height: 180px; }
    .landing-cta h2 { font-size: 1.7rem; }
}
</style>
{% endblock %}

