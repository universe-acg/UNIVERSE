{% extends 'Global/layout.html.twig' %}
{% block title %}Discover the Deree campus community{% endblock %}
{% block content %}
<section class="landing-hero"><div class="container landing-hero-grid">
    <div>
        <p class="landing-eyebrow">Your campus. Your community.</p>
        <h1>With Universe,<br>you’ll never miss a beat.</h1>
        <p class="landing-intro">Discover events, find your people, and make the most of life at Deree. Your campus community comes together here.</p>
        <div class="landing-actions"><a class="btn btn-light" href="{{ path('events') }}">Explore events</a><a class="btn btn-outline-light" href="{{ path('fos_user_registration_register_attendee') }}">Join the community</a></div>
    </div>
    <img src="{{ public_image('uploads/landing/UniVerse.png') }}" alt="Universe" class="hero-artwork" width="440" height="440" fetchpriority="high">
</div></section>
<section class="landing-section"><div class="container">
    <p class="landing-eyebrow">Make campus yours</p><h2>What’s in it for you?</h2>
    <div class="landing-benefits">
        <div><h3>Something to look forward to</h3><p>From club gatherings to talks and performances, find activities that match your interests.</p><a href="{{ path('events') }}">Discover campus events →</a></div>
        <div><h3>A community to belong to</h3><p>Meet clubs, societies, and student organizations. Follow the creators you want to hear from.</p><a href="{{ path('creators') }}">Meet the creators →</a></div>
        <div><h3>More ways to take part</h3><p>Explore opportunities, find a place to play, and connect with the wider campus community.</p><a href="{{ path('listings') }}">Browse opportunities →</a></div>
    </div>
</div></section>
{% if events|length %}
<section class="landing-section landing-tint"><div class="container">
    <div class="landing-section-heading"><div><p class="landing-eyebrow">On the calendar</p><h2>Coming up on campus</h2></div><a href="{{ path('events') }}" class="btn btn-outline-primary">View all events</a></div>
    <div class="catalog-grid">{% for event in events %}<div>{% include 'Global/event-card.html.twig' with {event: event} %}</div>{% endfor %}</div>
</div></section>
{% endif %}
<section class="landing-section"><div class="container landing-campus-grid">
    <img src="{{ public_image('uploads/landing/Deree-44.jpg') }}" alt="Students learning together at Deree" width="1200" height="800" loading="lazy">
    <div><p class="landing-eyebrow">Built around student life</p><h2>One place for your campus community.</h2><p>Discover a new interest, share what your club is working on, or find your next campus activity. Universe helps students and creators stay connected.</p><p>This installation is a demonstration with researched organization information and fictional student activity.</p><a href="{{ path('page', {slug: 'about-us'}) }}">About Universe →</a></div>
</div></section>
<section class="landing-section landing-tint"><div class="container">
    <div class="landing-section-heading"><div><p class="landing-eyebrow">For clubs and organizations</p><h2>Bring your community together.</h2><p>Create a profile, publish activities, and share opportunities with students.</p></div><a class="btn btn-primary" href="{{ path('fos_user_registration_register_organizer') }}">Register as creator</a></div>
    <div class="landing-stats" aria-label="Demo portal activity">{% for label, value in stats %}<div><strong>{{ value|number_format }}</strong><span>{{ label }}</span></div>{% endfor %}</div>
    <p class="small text-muted mt-3 mb-0">Current demo portal totals. Seeded student profiles and participation are fictional.</p>
</div></section>
<section class="landing-section"><div class="container landing-section-heading"><div><h2>Ready to find your people?</h2><p class="mb-0">Explore campus today, or create an account to take part.</p></div><div class="landing-actions"><a class="btn btn-primary" href="{{ path('fos_user_registration_register_attendee') }}">Create your account</a><a href="{{ path('help_center') }}" class="btn btn-outline-primary">Get help</a></div></div></section>
{% endblock %}
