{% extends "Global/layout.html.twig" %}

{% set pagetitle = 'Positions available in the ACG community' %}

{% block title %}{{ pagetitle }}{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('events') }}
{% endblock %}

{% block content %}
{% include "Global/navigation.html.twig" with {navigation: [{current: "Listings"}]} %}

    {% set navigation = [{"current" : (pagetitle)}] %}

    <section class="section-content bg-white padding-y"><div class="container">

        <div class="catalog-layout">
            <aside class="catalog-filters" id="catalog-filters">{% include 'Global/catalogue-filters.html.twig' with {route: 'listings', noun: 'listings', total: listings.getTotalItemCount} %}</aside>

            <div class="catalog-results">
                {% if listings.getTotalItemCount > 0 %}
                    <div class="catalog-grid">
                        {% for listing in listings %}
                            <div class="col-12 col-sm-4 col-lg-3 mb-3">
                                {% include "Global/listing-card.html.twig" with {listing: listing} %}
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    {% include "Global/message.html.twig" with { type: "info", message: ('No listings found'), icon: "fas fa-exclamation-circle" } %}
                {% endif %}
                {{ knp_pagination_render(listings, 'Global/pagination.html.twig', {}, {'align': 'center'}) }}
            </div>
        </div>

    </div></section>
{% endblock %}

{% block javascripts %}
{% endblock %}
