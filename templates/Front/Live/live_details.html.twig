{% extends 'Global/layout.html.twig' %}
{% set pagetitle = live.title %}
{% block title %}{{ pagetitle }}{% endblock %}
{% block content %}
    {% set navigation = [{'lives':'Live sessions','current':pagetitle}] %}
    {% include 'Global/navigation.html.twig' with navigation %}
    <section class="section-content padding-y bg-white">
        <div class="{{ services.getSetting('app_layout') }}">
            <article class="card box">
                <div class="card-body">
                    <h1>{{ live.title }}</h1>
                    <p>{{ live.description|raw }}</p>
                    <p class="badge badge-primary">{{ live.statusStringified }}</p>
                    {% if player and player.kind == 'video' %}
                        <video class="w-100" controls playsinline preload="metadata" src="{{ player.url }}" aria-label="{{ live.title }}"></video>
                    {% elseif player and player.kind == 'iframe' %}
                        <div class="embed-responsive embed-responsive-16by9"><iframe class="embed-responsive-item" title="{{ live.title }}" src="{{ player.url }}" allow="fullscreen; encrypted-media; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
                    {% elseif player %}
                        <a class="btn btn-primary" href="{{ player.url }}" target="_blank" rel="noopener noreferrer">Open live stream <i class="fas fa-external-link-alt" aria-hidden="true"></i></a>
                    {% else %}
                        {% include 'Global/message.html.twig' with {type:'info',message:'A streaming link has not been added to this session yet.',icon:'fas fa-info-circle'} %}
                    {% endif %}
                    <p class="mt-3"><a href="{{ path('lives') }}">All live sessions</a></p>
                </div>
            </article>
        </div>
    </section>
{% endblock %}
