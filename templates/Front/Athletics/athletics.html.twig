{% extends "Global/layout.html.twig" %}

{% set pagetitle = 'Athletics' %}

{% block title %}{{ pagetitle }}{% endblock %}

{% block content %}

    <style>

        .homepage-slider .item-slide:before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: 100%;
            background: linear-gradient(to bottom, rgba(153, 153, 153, 0) 0%, rgba(153, 153, 153, 0) 100%);
            filter: progid:DXImageTransform.Microsoft.gradient(startColorstr='#00999999', endColorstr='#000000', GradientType=0);
        }

        .fixed-sidebar {
            position: fixed;
            top: 140px;
            left: 0;
            width: 100%;
            z-index: 1000;
        }

        .col-lg-9 {
            margin-left: 25%; /* Ensure proper spacing between the fixed sidebar and main content */
        }

        /* Responsive styles for mobile */
        @media (max-width: 1000px) {
            .fixed-sidebar {
                position: relative;
                top: initial;
                left: initial;
                width: 100%;
                margin-bottom: 20px;
            }

            .col-lg-9 {
                margin-left: 0; /* Reset margin-left */
            }
        }
    </style>

    {#    {% set navigation = [{"current" : (pagetitle)}] %} #}
    {#    {% include "Global/navigation.html.twig" with navigation %} #}

    <section class="section-content padding-y bg-white" style="min-height: 600px">
        <div class="{{ services.getSetting("app_layout") }}">

            <div class="row" style="">
                <aside class="col-lg-3 order-1 order-lg-1 fixed-sidebar">

                    <div class="card card-filter filters-section">
                        <form method="get" action="{{ path('athletics') }}" id="search-form">
                            <div class="card card-filter filters-section">
                                <article class="card-group-item filter-item">
                                    <header class="card-header">
                                        <a href="#" data-toggle="collapse" data-target="#filter-sortby">
                                            <i class="icon-action fa fa-chevron-down"></i>
                                            <h6 class="title">Sort By</h6>
                                        </a>
                                    </header>
                                    <div class="filter-content collapse show" id="filter-sortby">
                                        <div class="card-body">
                                            <select class="form-control bg-white col-12" name="sortedby">
                                                <option selected value="all">Sort By</option>
                                                <option value="created_desc"
                                                        {% if app.request.get('sortedby') == 'created_desc' %}selected{% endif %}>
                                                    Created Recently
                                                </option>
                                                <option value="created_asc"
                                                        {% if app.request.get('sortedby') == 'created_asc' %}selected{% endif %}>
                                                    Created Lately
                                                </option>
                                                <option value="updated_desc"
                                                        {% if app.request.get('sortedby') == 'updated_desc' %}selected{% endif %}>
                                                    Updated Recently
                                                </option>
                                                <option value="updated_asc"
                                                        {% if app.request.get('sortedby') == 'updated_asc' %}selected{% endif %}>
                                                    Updated Lately
                                                </option>
                                                <option value="title_asc"
                                                        {% if app.request.get('sortedby') == 'title_asc' %}selected{% endif %}>
                                                    Title - Ascending
                                                </option>
                                                <option value="title_desc"
                                                        {% if app.request.get('sortedby') == 'title_desc' %}selected{% endif %}>
                                                    Title - Descending
                                                </option>
                                            </select>
                                        </div>
                                    </div>
                                </article>
                                <article class="card-group-item filter-item">
                                    <header class="card-header">
                                        <a href="#" data-toggle="collapse" data-target="#filter-tag">
                                            <i class="icon-action fa fa-chevron-down"></i>
                                            <h6 class="title">Tags</h6>
                                        </a>
                                    </header>
                                    <div class="filter-content collapse show" id="filter-tag">
                                        <div class="card-body">
                                            <select class="form-control bg-white col-12" name="tag">
                                                <option value="">Tags</option>
                                                {#                                                {% for tag in tags %} #}
                                                {#                                                    <option value="{{ tag }}" #}
                                                {#                                                            {% if tag == app.request.get('tag') %}selected{% endif %}>{{ tag }}</option> #}
                                                {#                                                {% endfor %} #}
                                            </select>
                                        </div>
                                    </div>
                                </article>
                                <article class="card-group-item filter-item">
                                    <header class="card-header">
                                        <a href="#" data-toggle="collapse" data-target="#filter-category">
                                            <i class="icon-action fa fa-chevron-down"></i>
                                            <h6 class="title">Category</h6>
                                        </a>
                                    </header>
                                    <div class="filter-content collapse show" id="filter-category">
                                        <div class="card-body">
                                        </div>
                                    </div>
                                </article>
                                <article class="card-group-item filter-item">
                                    <header class="card-header">
                                        <a href="#" data-toggle="collapse" data-target="#filter-keyword">
                                            <i class="icon-action fa fa-chevron-down"></i>
                                            <h6 class="title">Keyword</h6>
                                        </a>
                                    </header>
                                    <div class="filter-content collapse show" id="filter-keyword">
                                        <div class="card-body">
                                            <input type="text" class="form-control bg-white col-12" name="keyword"
                                                   placeholder="Search announcements and news"
                                                   value="{{ app.request.get('keyword') }}">
                                        </div>
                                    </div>
                                    <div class="text-left mt-2 mt-sm-0 pl-3 pb-5">
                                        <button type="submit" class="btn btn-primary d-inline-block"><i
                                                    class="fas fa-search"></i> Search
                                        </button>
                                        <button type="reset" class="btn btn-primary d-inline-block"
                                                onclick="clearForm()"><i
                                                    class="fas fa-eraser"></i> Clear
                                        </button>
                                    </div>
                                </article>
                            </div>
                        </form>

                    </div>
                </aside>
                <div class="col-lg-9 order-1 order-lg-2 mt-4 mt-md-0 ">
                    {% if athletics.getTotalItemCount > 0 %}
                        <div class="row">
                            {% for athletic in athletics %}
                                <div class="col-12 col-sm-4 col-lg-3 mb-3">
                                    {% include "Global/athletic-card.html.twig" with {'athletic': athletic} %}
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        {% include "Global/message.html.twig" with { type: "info", message: ('No athletics found'), icon: "fas fa-exclamation-circle" } %}
                    {% endif %}
                    {{ knp_pagination_render(athletics, null, {}, {'align': 'center'}) }}
                </div>


            </div>
        </div>
    </section>

{% endblock %}

{% block javascripts %}
{% endblock %}