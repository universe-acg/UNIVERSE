{% extends 'Global/layout.html.twig' %}
{% form_theme formbook 'bootstrap_4_layout.html.twig' %}
{% block title %}{{ facility.name }}{% endblock %}
{% block content %}
{% include 'Global/navigation.html.twig' with {navigation: [{athletics: 'Athletics', current: facility.name}]} %}
<section class="section-content padding-y"><div class="container">
    <div class="booking-layout">
        <div>
            <div class="owl-init slider-main owl-carousel" data-items="1" data-dots="true" data-nav="true" data-autoplay="false">
                {% for image in allImagePaths %}<div class="item-slide"><img class="slider-img" src="{{ public_image(image) }}" alt="{{ facility.name }}" width="1200" height="675"></div>{% else %}<div class="item-slide"><img class="slider-img" src="{{ public_image(null) }}" alt="{{ facility.name }}"></div>{% endfor %}
            </div>
            {% if facility.description %}<div class="mt-4 prose"><h2>About this facility</h2>{{ facility.description|raw }}</div>{% endif %}
        </div>
        <div class="booking-form">
            <h2 class="mb-3">Reserve a time</h2>
            <p class="small text-muted">Choose a day to see available times. Times are shown in Athens local time.</p>
            {{ form_start(formbook) }}
            {{ form_errors(formbook) }}
            {{ form_row(formbook.duration, {label: 'Reservation duration'}) }}
            {{ form_row(formbook.bookingDate, {label: 'Reservation date', type: 'date'}) }}
            {{ form_row(formbook.bookingTime, {label: 'Start time'}) }}
            {{ form_row(formbook.amount, {label: 'Number of players'}) }}
            {% if not is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                {% do formbook.save.setRendered %}
                <p><a class="btn btn-primary" href="{{ path('fos_user_security_login', {_target_path: app.request.pathInfo}) }}">Sign in to reserve</a></p>
            {% endif %}
            {{ form_rest(formbook) }}
            <p id="booking-status" class="small mt-3 mb-0" role="status"></p>
            {{ form_end(formbook) }}
        </div>
    </div>
    <section class="reservation-list" aria-label="Facility reservations">
        {% include 'Global/athletic-bookings-table.html.twig' with {reservations: reservations} %}
    </section>
</div></section>
<script id="booking-availability" type="application/json">{{ data|raw }}</script>
{% endblock %}
{% block javascripts %}<script src="{{ asset('js/facility-booking.js') }}" defer></script>{% endblock %}
