<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd" bootstrap="config/bootstrap.php" colors="true" cacheDirectory="var/phpunit">
  <php><server name="APP_ENV" value="test" force="true"/><ini name="date.timezone" value="Europe/Athens"/></php>
  <testsuites><testsuite name="UNIVERSE"><directory>tests</directory></testsuite></testsuites>
  <source><include><directory>src</directory></include></source>
</phpunit>
