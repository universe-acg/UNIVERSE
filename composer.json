{
  "type": "project",
  "license": "proprietary",
  "require": {
    "beberlei/doctrineextensions": "^1.5",
    "defuse/php-encryption": "^2.2",
    "doctrine/doctrine-bundle": "^2.18",
    "doctrine/doctrine-migrations-bundle": "^3.4",
    "doctrine/orm": "^3.5",
    "dompdf/dompdf": "^3.1",
    "endroid/qr-code": "^5.1",
    "endroid/qr-code-bundle": "^5.0",
    "ext-bcmath": "*",
    "ext-ctype": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-iconv": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-xml": "*",
    "ext-zip": "*",
    "ezyang/htmlpurifier": "^4.19",
    "friendsofsymfony/jsrouting-bundle": "^3.5",
    "geoip2/geoip2": "^3.2",
    "http-interop/http-factory-guzzle": "*",
    "knplabs/knp-paginator-bundle": "^6.9",
    "knplabs/knp-time-bundle": "^2.0",
    "liip/imagine-bundle": "^2.15",
    "nelmio/cors-bundle": "^2.5",
    "ninsuo/symfony-collection": "^2.1",
    "php": "^8.2",
    "phpoffice/phpspreadsheet": "^5.0",
    "presta/sitemap-bundle": "^4.2",
    "stof/doctrine-extensions-bundle": "^1.14",
    "symfony/asset": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/css-selector": "7.4.*",
    "symfony/doctrine-messenger": "7.4.*",
    "symfony/dom-crawler": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/expression-language": "7.4.*",
    "symfony/flex": "^2.6",
    "symfony/form": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/http-client": "7.4.*",
    "symfony/intl": "7.4.*",
    "symfony/mailer": "7.4.*",
    "symfony/messenger": "7.4.*",
    "symfony/monolog-bundle": "^3.10",
    "symfony/password-hasher": "7.4.*",
    "symfony/process": "7.4.*",
    "symfony/property-access": "7.4.*",
    "symfony/property-info": "7.4.*",
    "symfony/rate-limiter": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/security-core": "7.4.*",
    "symfony/security-csrf": "7.4.*",
    "symfony/security-http": "7.4.*",
    "symfony/serializer": "7.4.*",
    "symfony/translation": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/web-link": "7.4.*",
    "symfony/webpack-encore-bundle": "^2.3",
    "symfony/yaml": "7.4.*",
    "twig/extra-bundle": "^3.20",
    "twig/intl-extra": "^3.20",
    "twilio/sdk": "^8.0",
    "vich/uploader-bundle": "^2.8",
    "workerman/workerman": "^5.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "7.4.*",
    "symfony/phpunit-bridge": "7.4.*",
    "symfony/debug-bundle": "7.4.*",
    "symfony/web-profiler-bundle": "7.4.*"
  },
  "config": {
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true,
      "composer/package-versions-deprecated": true,
      "endroid/installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {},
  "scripts": {
    "post-install-cmd": [
      "@php bin/console cache:clear"
    ],
    "post-update-cmd": [
      "@php bin/console cache:clear"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.4.*"
    }
  }
}
